Program
  Enum Pair {Values(left: number, right: number), Empty}
  Enum Result {Ok(value: number), Err(message: string), Empty}
  Enum Box {Wrap(item: Result)}
  Fun pairScore(pair: Pair): number
    Match pair
      Arm Pair.Values(right: rightValue, left: leftValue)
        Block
          Return (+ (* rightValue 10) leftValue)
      Arm Pair.Empty
        Block
          Return 0
  Fun describe(result: Result): string
    Match result
      Arm Result.Ok(value: numberValue)
        Block
          Return (+ "ok:" (call str numberValue))
      Arm Result.Err(message: text)
        Block
          Return (+ "err:" text)
      Arm Result.Empty
        Block
          Return "empty"
  Fun unwrap(box: Box): string
    Match box
      Arm Box.Wrap(item: Result.Ok(value: numberValue))
        Block
          Return (call str numberValue)
      Arm Box.Wrap(item: Result.Err(message: text))
        Block
          Return text
      Arm Box.Wrap(item: Result.Empty)
        Block
          Return "empty"
  Print (call pairScore (member-call Pair Values 2 4))
  Print (call describe (member-call Result Ok 7))
  Print (call describe (member-call Result Err "bad"))
  Print (call describe (member-call Result Empty))
  Print (call unwrap (member-call Box Wrap (member-call Result Ok 9)))
