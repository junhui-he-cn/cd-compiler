Program
  Enum Pair {Values(number, number), Empty}
  Enum Result {Ok(number), Err(string), Empty}
  Enum Box {Wrap(Result)}
  Fun pairScore(pair: Pair): number
    Match pair
      Arm Pair.Values(leftValue, rightValue)
        Block
          Return (+ (* rightValue 10) leftValue)
      Arm Pair.Empty
        Block
          Return 0
  Fun describe(result: Result): string
    Match result
      Arm Result.Ok(numberValue)
        Block
          Return (+ "ok:" (call str numberValue))
      Arm Result.Err(text)
        Block
          Return (+ "err:" text)
      Arm Result.Empty
        Block
          Return "empty"
  Fun unwrap(box: Box): string
    Match box
      Arm Box.Wrap(Result.Ok(numberValue))
        Block
          Return (call str numberValue)
      Arm Box.Wrap(Result.Err(text))
        Block
          Return text
      Arm Box.Wrap(Result.Empty)
        Block
          Return "empty"
  Expr (call print (call pairScore (member-call Pair Values 2 4)))
  Expr (call print (call describe (member-call Result Ok 7)))
  Expr (call print (call describe (member-call Result Err "bad")))
  Expr (call print (call describe (member-call Result Empty)))
  Expr (call print (call unwrap (member-call Box Wrap (member-call Result Ok 9))))
