enum Pair {
  Values(number, number),
  Empty,
}

enum Result {
  Ok(number),
  Err(string),
  Empty,
}

enum Box {
  Wrap(Result),
}

fun pairScore(pair: Pair): number {
  match pair {
    Pair.Values(leftValue, rightValue) => { return rightValue * 10 + leftValue; }
    Pair.Empty => { return 0; }
  }
}

fun describe(result: Result): string {
  match result {
    Result.Ok(numberValue) => { return "ok:" + str(numberValue); }
    Result.Err(text) => { return "err:" + text; }
    Result.Empty => { return "empty"; }
  }
}

fun unwrap(box: Box): string {
  match box {
    Box.Wrap(Result.Ok(numberValue)) => { return str(numberValue); }
    Box.Wrap(Result.Err(text)) => { return text; }
    Box.Wrap(Result.Empty) => { return "empty"; }
  }
}

print pairScore(Pair.Values(2, 4));
print describe(Result.Ok(7));
print describe(Result.Err("bad"));
print describe(Result.Empty());
print unwrap(Box.Wrap(Result.Ok(9)));
