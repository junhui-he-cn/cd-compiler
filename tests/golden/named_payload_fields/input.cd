enum Pair {
  Values(left: number, right: number),
  Empty,
}

enum Result {
  Ok(value: number),
  Err(message: string),
  Empty,
}

enum Box {
  Wrap(item: Result),
}

fun pairScore(pair: Pair): number {
  match pair {
    Pair.Values(right: rightValue, left: leftValue) => { return rightValue * 10 + leftValue; }
    Pair.Empty => { return 0; }
  }
}

fun describe(result: Result): string {
  match result {
    Result.Ok(value: numberValue) => { return "ok:" + str(numberValue); }
    Result.Err(message: text) => { return "err:" + text; }
    Result.Empty => { return "empty"; }
  }
}

fun unwrap(box: Box): string {
  match box {
    Box.Wrap(item: Result.Ok(value: numberValue)) => { return str(numberValue); }
    Box.Wrap(item: Result.Err(message: text)) => { return text; }
    Box.Wrap(item: Result.Empty) => { return "empty"; }
  }
}

print pairScore(Pair.Values(2, 4));
print describe(Result.Ok(7));
print describe(Result.Err("bad"));
print describe(Result.Empty());
print unwrap(Box.Wrap(Result.Ok(9)));
