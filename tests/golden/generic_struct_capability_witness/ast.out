Program
  Struct Point {value: number}
  Impl Point
    Operator <(other: Point): bool
      Return (< (field this value) (field other value))
    Operator <=(other: Point): bool
      Return (<= (field this value) (field other value))
    Operator >(other: Point): bool
      Return (> (field this value) (field other value))
    Operator >=(other: Point): bool
      Return (>= (field this value) (field other value))
  Fun compareAll<T: Ord>(left: T, right: T): [bool]
    Return (array (< left right) (<= left right) (> left right) (>= left right))
  Fun compareAndEqual<T: Eq + Ord>(left: T, right: T): bool
    Return (|| (== left right) (< left right))
  Let low = (construct Point value: 1)
  Let high = (construct Point value: 2)
  Print (call compareAll<Point> low high)
  Print (call compareAll<Point> high low)
  Print (call compareAndEqual<Point> low low)
