struct Point {
  value: number
}

impl Point {
  operator <(other: Point): bool {
    return this.value < other.value;
  }
  operator <=(other: Point): bool {
    return this.value <= other.value;
  }
  operator >(other: Point): bool {
    return this.value > other.value;
  }
  operator >=(other: Point): bool {
    return this.value >= other.value;
  }
}

fun compareAll<T: Ord>(left: T, right: T): [bool] {
  return [left < right, left <= right, left > right, left >= right];
}

fun compareAndEqual<T: Eq + Ord>(left: T, right: T): bool {
  return left == right || left < right;
}

let low = Point { value: 1 };
let high = Point { value: 2 };
print compareAll<Point>(low, high);
print compareAll<Point>(high, low);
print compareAndEqual<Point>(low, low);
