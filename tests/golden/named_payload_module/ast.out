Program
  Module 0
    Enum Outcome {Good(string), Bad(number)}
    Fun make(): Outcome
      Return (member-call Outcome Good "ok")
    Export Outcome make
  Module 1 entry
    Import "./lib.cd" as lib
    Fun render(value: lib.Outcome): string
      Match value
        Arm lib.Outcome.Good(text)
          Block
            Return text
        Arm lib.Outcome.Bad(numberValue)
          Block
            Return (call str numberValue)
    Expr (call print (call render (member-call lib make)))
