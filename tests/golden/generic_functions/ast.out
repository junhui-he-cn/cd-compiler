Program
  Fun identity<T>(value: T): T
    Return value
  Fun head<T>(values: [T]): T
    Return (index values 0)
  Fun same<T>(left: T, right: T): T
    Return left
  Expr (call print (call identity 42))
  Expr (call print (call identity "hello"))
  Expr (call print (call head (array 1 2 3)))
  Expr (call print (call same true true))
  Let alias = identity
  Expr (call print (call alias "alias"))
