Program
  Expr (call print (call typeOf nil))
  Expr (call print (call typeOf 1))
  Expr (call print (call typeOf true))
  Expr (call print (call typeOf "x"))
  Expr (call print (call typeOf (fun () (return nil))))
  Expr (call print (call typeOf (array 1)))
  Struct Box {value: number}
  Expr (call print (call typeOf (construct Box value: 1)))
  Let typeOf = (fun (value) (return "shadowed"))
  Expr (call print (call typeOf 123))
