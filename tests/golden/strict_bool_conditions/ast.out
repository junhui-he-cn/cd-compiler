Program
  Let ready = true
  If ready
    Then
      Block
        Expr (call print "yes")
    Else
      Block
        Expr (call print "no")
  Let mut i = 0
  While (< i 3)
    Body
      Block
        Expr (+= i 1)
  Expr (call print i)
  Let maybe: optional<number> = 4
  IfLet value
    Value
maybe
    Then
      Block
        Expr (call print value)
  Expr (call print (?? maybe 0))
  Expr (call print (|| false true))
  Expr (call print (&& true false))
