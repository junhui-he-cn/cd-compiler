Program
  Let values = (map (entry "a" 1) (entry "b" 2))
  Let alias = values
  Expr (call print (call clear values))
  Expr (call print alias)
  Expr (= (index values "c") 3)
  Expr (call print alias)
  Expr (call print (member-call alias clear))
  Expr (call print (member-call values len))
  Expr (= (index values "d") 4)
  Expr (call print values)
