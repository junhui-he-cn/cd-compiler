struct Point {
  x: number,
  y: number
}

let target = Point { x: 1, y: 2 };
let ready = true;

if ready {
  print("ready");
}

if (Point { x: 1, y: 2 } != target) {
  print("point");
}

while (false && (Point { x: 1, y: 2 } == target)) {
  print("never");
}

let items = [Point { x: 3, y: 4 }];
for item in items {
  print(item.x);
}
