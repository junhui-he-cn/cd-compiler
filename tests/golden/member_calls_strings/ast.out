Program
  Let text = "hello"
  Expr (call print (member-call text len))
  Expr (call print (member-call text substr 1 3))
  Expr (call print (member-call text charAt 4))
  Expr (call print (member-call (group (+ "abc" "def")) substr 2 3))
  Expr (call print (member-call (group (+ "xy" "z")) charAt 1))
