Program
  Let m = (map (entry "a" 1) (entry "b" 2) (entry "a" 3))
  Expr (call print (call len m))
  Expr (call print (index m "a"))
  Expr (call print (index m "b"))
  ForIn k in m
    Block
      Expr (call print k)
      Expr (call print (index m k))
  Expr (call print (call keys m))
  Expr (call print (call values m))
  Expr (= (index m "a") 30)
  Expr (call print m)
  Expr (call print (call keys m))
  Expr (call print (call merge m (map (entry "b" 20) (entry "c" 4))))
