Program
  Enum Result {Ok(number), Empty}
  Fun describe(result: Result): string
    Match result
      Arm Result.Ok(value) if (> value 0)
        Block
          Return "positive"
      Arm Result.Ok(_)
        Block
          Return "zero"
      Arm _
        Block
          Return "empty"
  Let positive = (member-call Result Ok 3)
  Let zero = (member-call Result Ok 0)
  Let empty = (member-call Result Empty)
  Print (call describe positive)
  Print (call describe zero)
  Print (call describe empty)
  Match positive
    Arm Result.Ok(value) if (> value 10)
      Block
        Print "large"
    Arm Result.Ok(value) if (> value 0)
      Block
        Print "positive"
    Arm Result.Ok(_)
      Block
        Print "zero"
    Arm Result.Empty
      Block
        Print "empty"
  Match empty
    Arm Result.Empty if 1
      Block
        Print "truthy"
    Arm _
      Block
        Print "fallback"
