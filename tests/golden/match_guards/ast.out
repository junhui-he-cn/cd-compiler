Program
  Enum Result {Ok(number), Empty}
  Fun describe(result: Result): string
    Match result
      Arm Result.Ok(value) if (> value 0)
        Block
          Return "positive"
      Arm Result.Ok(_)
        Block
          Return "zero"
      Arm _
        Block
          Return "empty"
  Let positive = (member-call Result Ok 3)
  Let zero = (member-call Result Ok 0)
  Let empty = (member-call Result Empty)
  Expr (call print (call describe positive))
  Expr (call print (call describe zero))
  Expr (call print (call describe empty))
  Match positive
    Arm Result.Ok(value) if (> value 10)
      Block
        Expr (call print "large")
    Arm Result.Ok(value) if (> value 0)
      Block
        Expr (call print "positive")
    Arm Result.Ok(_)
      Block
        Expr (call print "zero")
    Arm Result.Empty
      Block
        Expr (call print "empty")
  Match empty
    Arm Result.Empty if 1
      Block
        Expr (call print "truthy")
    Arm _
      Block
        Expr (call print "fallback")
