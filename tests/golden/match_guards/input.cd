enum Result { Ok(number), Empty }

fun describe(result: Result): string {
  match result {
    Result.Ok(value) if value > 0 => { return "positive"; }
    Result.Ok(_) => { return "zero"; }
    _ => { return "empty"; }
  }
}

let positive = Result.Ok(3);
let zero = Result.Ok(0);
let empty = Result.Empty();
print describe(positive);
print describe(zero);
print describe(empty);
match positive {
  Result.Ok(value) if value > 10 => { print "large"; }
  Result.Ok(value) if value > 0 => { print "positive"; }
  Result.Ok(_) => { print "zero"; }
  Result.Empty => { print "empty"; }
}
match empty {
  Result.Empty if 1 => { print "truthy"; }
  _ => { print "fallback"; }
}
