fun increment(value: optional<number>): number {
  if (value) {
    return value + 1;
  }
  return 0;
}

fun add(first: optional<number>, second: optional<number>): number {
  if (first && second) {
    return first + second;
  }
  return 0;
}

print increment(nil);
print increment(4);
print add(nil, 2);
print add(3, 4);
