Program
  Fun increment(value: optional<number>): number
    If (group value)
      Then
        Block
          Return (+ value 1)
    Return 0
  Fun add(first: optional<number>, second: optional<number>): number
    If (group (&& first second))
      Then
        Block
          Return (+ first second)
    Return 0
  Print (call increment nil)
  Print (call increment 4)
  Print (call add nil 2)
  Print (call add 3 4)
