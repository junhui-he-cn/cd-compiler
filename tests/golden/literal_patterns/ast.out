Program
  Enum Result {Number(number), Text(string), Empty}
  Fun describeNumber(value: number): string
    Match value
      Arm 0
        Block
          Return "zero"
      Arm 1
        Block
          Return "one"
      Arm _
        Block
          Return "many"
  Fun describeBool(value: bool): string
    Match value
      Arm true
        Block
          Return "true"
      Arm false
        Block
          Return "false"
  Fun describeResult(value: optional<Result>): string
    Match value
      Arm nil
        Block
          Return "nil"
      Arm Result.Number(0)
        Block
          Return "zero"
      Arm Result.Number(value)
        Block
          Return (+ "number:" (call str value))
      Arm Result.Text("")
        Block
          Return "empty-text"
      Arm Result.Text(value)
        Block
          Return (+ "text:" value)
      Arm Result.Empty
        Block
          Return "empty"
  Let maybe: optional<bool> = nil
  Expr (call print (call describeNumber 0))
  Expr (call print (call describeNumber 8))
  Expr (call print (call describeBool false))
  Expr (call print (call describeResult (member-call Result Number 7)))
  Expr (call print (call describeResult (member-call Result Text "")))
  Expr (call print (call describeResult nil))
  Match 1
    Arm 0
      Block
        Expr (call print "zero")
    Arm 1
      Block
        Expr (call print "one")
    Arm _
      Block
        Expr (call print "many")
  Match true
    Arm false
      Block
        Expr (call print "no")
    Arm true
      Block
        Expr (call print "yes")
  Match "ok"
    Arm ""
      Block
        Expr (call print "empty")
    Arm "ok"
      Block
        Expr (call print "ok")
    Arm _
      Block
        Expr (call print "other")
  Match maybe
    Arm nil
      Block
        Expr (call print "nil")
    Arm true
      Block
        Expr (call print "true")
    Arm false
      Block
        Expr (call print "false")
