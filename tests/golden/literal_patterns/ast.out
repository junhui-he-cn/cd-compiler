Program
  Enum Result {Number(value: number), Text(value: string), Empty}
  Fun describeNumber(value: number): string
    Match value
      Arm 0
        Block
          Return "zero"
      Arm 1
        Block
          Return "one"
      Arm _
        Block
          Return "many"
  Fun describeBool(value: bool): string
    Match value
      Arm true
        Block
          Return "true"
      Arm false
        Block
          Return "false"
  Fun describeResult(value: optional<Result>): string
    Match value
      Arm nil
        Block
          Return "nil"
      Arm Result.Number(0)
        Block
          Return "zero"
      Arm Result.Number(value)
        Block
          Return (+ "number:" (call str value))
      Arm Result.Text("")
        Block
          Return "empty-text"
      Arm Result.Text(value)
        Block
          Return (+ "text:" value)
      Arm Result.Empty
        Block
          Return "empty"
  Let maybe: optional<bool> = nil
  Print (call describeNumber 0)
  Print (call describeNumber 8)
  Print (call describeBool false)
  Print (call describeResult (member-call Result Number 7))
  Print (call describeResult (member-call Result Text ""))
  Print (call describeResult nil)
  Match 1
    Arm 0
      Block
        Print "zero"
    Arm 1
      Block
        Print "one"
    Arm _
      Block
        Print "many"
  Match true
    Arm false
      Block
        Print "no"
    Arm true
      Block
        Print "yes"
  Match "ok"
    Arm ""
      Block
        Print "empty"
    Arm "ok"
      Block
        Print "ok"
    Arm _
      Block
        Print "other"
  Match maybe
    Arm nil
      Block
        Print "nil"
    Arm true
      Block
        Print "true"
    Arm false
      Block
        Print "false"
