IR
0000  v0 = constant #0 "Ada"
0001  v1 = constant #1 36
0002  v2 = struct Person {name: v0, age: v1}
0003  store_var @3 p#0, v2
0004  v3 = load_var @4 p#0
0005  v4 = field v3.name
0006  v5 = native_call @7 print(v4)
0007  v6 = load_var @8 p#0
0008  v7 = constant #2 37
0009  v8 = assign_field v6.age, v7
0010  v9 = load_var @11 p#0
0011  v10 = field v9.age
0012  v11 = native_call @14 print(v10)
