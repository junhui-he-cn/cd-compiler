Program
  Struct Person {name: string, age: number}
  Let p: Person = (construct Person age: 36 name: "Ada")
  Expr (call print (field p name))
  Expr (= (field p age) 37)
  Expr (call print (field p age))
  Fun birthday(person: Person): Person
    Expr (= (field person age) (+ (field person age) 1))
    Return person
  Let older: Person = (call birthday p)
  Expr (call print (field older age))
