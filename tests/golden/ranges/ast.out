Program
  Let ascending = (call range 1 6)
  Expr (call print ascending)
  Expr (call print (call len ascending))
  Expr (call print (index ascending 2))
  Expr (call print (member-call ascending contains 5))
  Expr (call print (call contains ascending 4))
  Expr (call print (member-call ascending len))
  Expr (call print (call typeOf ascending))
  ForIn item in (call range 5)
    Block
      Expr (call print item)
  ForIn item in (call range 5 0 (- 2))
    Block
      Expr (call print item)
