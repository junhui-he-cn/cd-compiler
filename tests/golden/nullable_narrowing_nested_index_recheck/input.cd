struct Box { values: [optional<number>] }

fun read(values: [[optional<number>]], box: Box): number {
  if (values[0][1] == nil) {
    return 0;
  }
  if (box.values[0] == nil) {
    return 0;
  }
  return values[0][1] + box.values[0];
}

print read([[nil, 4]], Box { values: [6] });
print read([[nil, nil]], Box { values: [6] });
