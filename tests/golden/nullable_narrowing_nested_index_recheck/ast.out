Program
  Struct Box {values: [number?]}
  Fun read(values: [[number?]], box: Box): number
    If (group (== (index (index values 0) 1) nil))
      Then
        Block
          Return 0
    If (group (== (index (field box values) 0) nil))
      Then
        Block
          Return 0
    Return (+ (index (index values 0) 1) (index (field box values) 0))
  Print (call read (array (array nil 4)) (construct Box values: (array 6)))
  Print (call read (array (array nil nil)) (construct Box values: (array 6)))
