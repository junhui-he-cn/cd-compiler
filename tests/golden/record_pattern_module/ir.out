IR
0000  v0 = constant #0 1
0001  v1 = constant #1 2
0002  v2 = struct geo.Point {x: v0, y: v1}
0003  store_var @3 point#0, v2
0004  v3 = load_var @4 point#0
0005  v4 = field v3.x
0006  v5 = constant #2 1
0007  v6 = equal v4, v5
0008  jump_if_false v6, 0012
0009  v7 = constant #3 "one"
0010  print v7
0011  jump 0015
0012  v8 = constant #4 "other"
0013  print v8
0014  jump 0015
