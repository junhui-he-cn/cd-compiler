IR
0000  v0 = constant #0 1
0001  v1 = constant #1 2
0002  v2 = struct geo.Point {x: v0, y: v1}
0003  store_var @3 point#0, v2
0004  v3 = load_var @4 point#0
0005  v4 = constant #2 nil
0006  v5 = field v3.x
0007  v6 = constant #3 1
0008  v7 = equal v5, v6
0009  jump_if_false v7, 0013
0010  v8 = constant #4 "one"
0011  v9 = native_call @7 print(v8)
0012  jump 0016
0013  v10 = constant #5 "other"
0014  v11 = native_call @8 print(v10)
0015  jump 0016
