Program
  Module 0
    Struct Point {x: number, y: number}
    Export Point
  Module 1 entry
    Import "lib.cd" as geo
    Let point = (construct geo.Point x: 1 y: 2)
    Match point
      Arm geo.Point {x: 1}
        Block
          Expr (call print "one")
      Arm geo.Point {}
        Block
          Expr (call print "other")
