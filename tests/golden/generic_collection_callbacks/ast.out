Program
  Fun identity<T>(value: T): T
    Return value
  Fun keep<T>(value: T): bool
    Return true
  Fun singleton<T>(value: T): [T]
    Return (array value)
  Fun keepAccumulator<T>(acc: T, value: number): T
    Return acc
  Let values: [number] = (array 1 2)
  Let copied: [number] = (call map values identity)
  Expr (call print copied)
  Expr (call print (member-call values map identity))
  Expr (call print (call filter values keep))
  Expr (call print (member-call values any keep))
  Expr (call print (member-call values all keep))
  Expr (call print (member-call values count keep))
  Expr (call print (member-call values find keep))
  Expr (call print (member-call values findIndex keep))
  Expr (call print (call flatMap values singleton))
  Expr (call print (member-call values reduce 0 keepAccumulator))
  Expr (call print (call map values (fun <T>(value: T): T (return value))))
  Fun acceptsNullable<T>(value: optional<T>): bool
    Return true
  Let nullableValues: [optional<number>] = (array 1 nil)
  Expr (call print (member-call nullableValues all acceptsNullable))
  Fun identityArray<T>(value: [T]): [T]
    Return value
  Let nestedValues: [[number]] = (array (array 1) (array 2))
  Expr (call print (call map nestedValues identityArray))
