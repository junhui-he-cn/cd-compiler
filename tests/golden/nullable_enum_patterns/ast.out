Program
  Enum Option {Some(value: number), None}
  Fun describe(value: optional<Option>): string
    Match value
      Arm nil
        Block
          Return "nil"
      Arm Option.Some(value) if (> value 10)
        Block
          Return "large"
      Arm Option.Some(value)
        Block
          Return (+ "some:" (call str value))
      Arm Option.None
        Block
          Return "none"
  Let some: optional<Option> = (member-call Option Some 7)
  Let none: optional<Option> = nil
  Print (call describe some)
  Print (call describe none)
  Match some
    Arm nil
      Block
        Print "nil"
    Arm Option.Some(value) if (> value 10)
      Block
        Print "large"
    Arm Option.Some(_)
      Block
        Print "some"
    Arm Option.None
      Block
        Print "none"
  Match none
    Arm nil if true
      Block
        Print "guarded nil"
    Arm _
      Block
        Print "fallback"
