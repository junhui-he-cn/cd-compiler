Program
  Enum Option {Some(number), None}
  Fun describe(value: optional<Option>): string
    Match value
      Arm nil
        Block
          Return "nil"
      Arm Option.Some(value) if (> value 10)
        Block
          Return "large"
      Arm Option.Some(value)
        Block
          Return (+ "some:" (call str value))
      Arm Option.None
        Block
          Return "none"
  Let some: optional<Option> = (member-call Option Some 7)
  Let none: optional<Option> = nil
  Expr (call print (call describe some))
  Expr (call print (call describe none))
  Match some
    Arm nil
      Block
        Expr (call print "nil")
    Arm Option.Some(value) if (> value 10)
      Block
        Expr (call print "large")
    Arm Option.Some(_)
      Block
        Expr (call print "some")
    Arm Option.None
      Block
        Expr (call print "none")
  Match none
    Arm nil if true
      Block
        Expr (call print "guarded nil")
    Arm _
      Block
        Expr (call print "fallback")
