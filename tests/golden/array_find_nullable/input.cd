let nullableValues: [optional<number>] = [1, nil];
let first: optional<number> = nullableValues.find(fun (value: optional<number>): bool {
  return value != nil;
});
print first;

let nonNullableValues: [number] = [2];
print nonNullableValues.find(fun (value: optional<number>): bool {
  return value != nil;
});
