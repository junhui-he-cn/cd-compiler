Program
  Struct Box {value: number}
  Impl Box
    Method echo<T>(value: T): T
      Let copy: T = value
      Return copy
    Method head<T>(values: [T]): T
      Return (index values 0)
    Method make<T>(): optional<T>
      Return nil
  Let box: Box = (construct Box value: 0)
  Expr (call print (member-call box echo<number> 42))
  Expr (call print (member-call box echo "hello"))
  Expr (call print (member-call box head<number> (array 3 4)))
  Expr (call print (member-call box make<string>))
