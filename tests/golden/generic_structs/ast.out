Program
  Struct Box<T> {value: T}
  Struct NumberBox<T: number> {value: T}
  Let inferred = (construct Box value: 1)
  Let explicit = (construct Box<number> value: 2)
  Let annotated: Box<number> = (construct Box value: 3)
  Let textBox = (construct Box value: "text")
  Let bounded = (construct NumberBox value: 4)
  Expr (= (field inferred value) 5)
  Expr (call print (field inferred value))
  Expr (call print (field explicit value))
  Expr (call print (field annotated value))
  Expr (call print (field textBox value))
  Expr (call print (field bounded value))
  Expr (call print (call typeOf explicit))
  Match explicit
    Arm Box {value: 2}
      Block
        Expr (call print "two")
    Arm Box {value: _}
      Block
        Expr (call print "other")
