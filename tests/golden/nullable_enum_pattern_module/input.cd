import "./lib.cd" as lib;

fun render(value: optional<lib.Outcome>): string {
  match value {
    nil => { return "nil"; }
    lib.Outcome.Good(number) => { return "good:" + str(number); }
    lib.Outcome.Bad(message) => { return "bad:" + message; }
  }
}

print render(nil);
print render(lib.make());
