Program
  Enum Shape {Point(number), Line(number, number), Empty}
  Fun numberLabel(value: number): string
    Match value
      Arm (or 0 1)
        Block
          Return "small"
      Arm _
        Block
          Return "other"
  Fun shapeLabel(value: Shape): string
    Match value
      Arm (or Shape.Point(x) Shape.Line(x, _)) if (> x 3)
        Block
          Return (+ "large:" (call str x))
      Arm (or Shape.Point(_) Shape.Line(_, _))
        Block
          Return "small"
      Arm Shape.Empty
        Block
          Return "empty"
  Let maybe: optional<bool> = false
  Expr (call print (call numberLabel 1))
  Expr (call print (call numberLabel 8))
  Expr (call print (call shapeLabel (member-call Shape Point 3)))
  Expr (call print (call shapeLabel (member-call Shape Line 4 10)))
  Expr (call print (call shapeLabel (member-call Shape Empty)))
  Match maybe
    Arm (or nil false)
      Block
        Expr (call print "off")
    Arm true
      Block
        Expr (call print "on")
  Match true
    Arm (or true false)
      Block
        Expr (call print "bool")
