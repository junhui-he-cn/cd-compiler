Program
  Enum Shape {Point(x: number), Line(x: number, y: number), Empty}
  Fun numberLabel(value: number): string
    Match value
      Arm (or 0 1)
        Block
          Return "small"
      Arm _
        Block
          Return "other"
  Fun shapeLabel(value: Shape): string
    Match value
      Arm (or Shape.Point(x) Shape.Line(x, _)) if (> x 3)
        Block
          Return (+ "large:" (call str x))
      Arm (or Shape.Point(_) Shape.Line(_, _))
        Block
          Return "small"
      Arm Shape.Empty
        Block
          Return "empty"
  Let maybe: optional<bool> = false
  Print (call numberLabel 1)
  Print (call numberLabel 8)
  Print (call shapeLabel (member-call Shape Point 3))
  Print (call shapeLabel (member-call Shape Line 4 10))
  Print (call shapeLabel (member-call Shape Empty))
  Match maybe
    Arm (or nil false)
      Block
        Print "off"
    Arm true
      Block
        Print "on"
  Match true
    Arm (or true false)
      Block
        Print "bool"
