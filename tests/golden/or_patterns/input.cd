enum Shape {
  Point(x: number),
  Line(x: number, y: number),
  Empty,
}

fun numberLabel(value: number): string {
  match value {
    0 | 1 => { return "small"; }
    _ => { return "other"; }
  }
}

fun shapeLabel(value: Shape): string {
  match value {
    Shape.Point(x) | Shape.Line(x, _) if x > 3 => { return "large:" + str(x); }
    Shape.Point(_) | Shape.Line(_, _) => { return "small"; }
    Shape.Empty => { return "empty"; }
  }
}

let maybe: optional<bool> = false;
print numberLabel(1);
print numberLabel(8);
print shapeLabel(Shape.Point(3));
print shapeLabel(Shape.Line(4, 10));
print shapeLabel(Shape.Empty());
match maybe {
  nil | false => { print "off"; }
  true => { print "on"; }
}
match true {
  true | false => { print "bool"; }
}
