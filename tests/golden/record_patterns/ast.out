Program
  Struct Address {city: string, zip: number}
  Struct Person {name: string, age: number, address: Address}
  Fun describe(value: optional<Person>): string
    Match value
      Arm nil
        Block
          Return "nil"
      Arm Person {name: "Ada"}
        Block
          Return "ada"
      Arm Person {address: Address {city: "Hong Kong"}, name: name}
        Block
          Return (+ "city:" name)
      Arm Person {age: age, name: name}
        Block
          Return (+ (+ name ":") (call str age))
  Let ada = (construct Person name: "Ada" age: 36 address: (construct Address city: "Cambridge" zip: 1))
  Let hongKong = (construct Person name: "Grace" age: 40 address: (construct Address city: "Hong Kong" zip: 2))
  Let nilPerson: optional<Person> = nil
  Print (call describe ada)
  Print (call describe hongKong)
  Print (call describe nilPerson)
  Match ada
    Arm (or Person {name: "Ada"} Person {age: 0})
      Block
        Print "or"
    Arm Person {}
      Block
        Print "fallback"
