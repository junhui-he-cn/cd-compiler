struct Address { city: string, zip: number }
struct Person { name: string, age: number, address: Address }

fun describe(value: optional<Person>): string {
  match value {
    nil => { return "nil"; }
    Person { name: "Ada" } => { return "ada"; }
    Person { address: Address { city: "Hong Kong" }, name: name } => { return "city:" + name; }
    Person { age: age, name: name } => { return name + ":" + str(age); }
  }
}

let ada = Person {
  name: "Ada",
  age: 36,
  address: Address { city: "Cambridge", zip: 1 }
};
let hongKong = Person {
  name: "Grace",
  age: 40,
  address: Address { city: "Hong Kong", zip: 2 }
};
let nilPerson: optional<Person> = nil;
print describe(ada);
print describe(hongKong);
print describe(nilPerson);
match ada {
  Person { name: "Ada" } | Person { age: 0 } => { print "or"; }
  Person {} => { print "fallback"; }
}
