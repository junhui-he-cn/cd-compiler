Program
  Let any = (fun (array, predicate) (return "shadowed any"))
  Let all = (fun (array, predicate) (return "shadowed all"))
  Expr (call print (call any (array 1) (fun (value) (return true))))
  Expr (call print (call all (array 1) (fun (value) (return true))))
  Expr (call print (member-call (array 1) any (fun (value) (return true))))
  Expr (call print (member-call (array 1) all (fun (value) (return true))))
