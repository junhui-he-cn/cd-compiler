Program
  Let xs = (array 1 2)
  Expr (call print (call push xs 3))
  Expr (call print xs)
  Expr (call print (call pop xs))
  Expr (call print xs)
  Let alias = xs
  Expr (call push alias 4)
  Expr (call print xs)
  Let mixed = (array)
  Expr (call push mixed "hi")
  Expr (call push mixed true)
  Expr (call print (call pop mixed))
  Expr (call print (call pop mixed))
