fun increment(value: optional<number>): number {
  if (value == nil) {
    return 0;
  }
  return value + 1;
}

print increment(41);

fun preserveOuter(value: optional<number>, other: optional<number>): number {
  if (other != nil) {
    if (value == nil) {
      other = nil;
      return 0;
    }
    return other + 1;
  }
  return 0;
}

print preserveOuter(nil, 5);
print preserveOuter(1, 5);
