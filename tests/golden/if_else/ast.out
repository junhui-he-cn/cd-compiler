Program
  Let ok = true
  If ok
    Then
      Block
        Expr (call print "then")
    Else
      Block
        Expr (call print "else")
  If false
    Then
      Block
        Expr (call print "bad")
    Else
      Block
        Expr (call print "fallback")
  If true
    Then
      Block
        Expr (call print "no else")
  If false
    Then
      Block
        Expr (call print "bad no else")
  Expr (call print "after no else")
