Program
  Struct Box<T> {value: T}
  Struct NumberBox<T: number> {value: T}
  Impl Box<T>
    Method get(): T
      Return (field this value)
    Method set(value: T): T
      Expr (= (field this value) value)
      Return (field this value)
    Method wrap<U>(value: U): Box<U>
      Return (construct Box<U> value: value)
  Impl NumberBox<T>
    Method get(): T
      Return (field this value)
  Let box: Box<number> = (construct Box value: 1)
  Let numberBox: NumberBox<number> = (construct NumberBox value: 3)
  Expr (call print (member-call box get))
  Expr (call print (member-call box set 2))
  Expr (call print (field box value))
  Let textBox = (member-call box wrap<string> "text")
  Expr (call print (field textBox value))
  Expr (call print (field (member-call box wrap "inferred") value))
  Expr (call print (member-call numberBox get))
  Expr (call print (call typeOf textBox))
