Program
  Let values = (map (entry "a" 1) (entry "b" 2) (entry "c" 3))
  ForIn key in values
    Block
      Expr (call print key)
      Expr (call remove values key)
  Expr (call print values)
  Let numbers: map<number, string> = (map (entry 1 "one") (entry 2 "two"))
  ForIn key in numbers
    Block
      Expr (call print key)
