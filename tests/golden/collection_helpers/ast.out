Program
  Struct Box {value: number}
  Let xs: [number] = (array 1 2 3)
  Expr (call print (call contains xs 2))
  Expr (call print (member-call xs contains 4))
  Let shared = (array 9)
  Let nested = (array shared)
  Expr (call print (member-call nested contains shared))
  Expr (call print (member-call nested contains (array 9)))
  Let box = (construct Box value: 1)
  Expr (call print (member-call (array box) contains box))
  Expr (call print (member-call (array box) contains (construct Box value: 1)))
  Let part = (call slice xs 1 2)
  Expr (call print part)
  Expr (= (index part 0) 20)
  Expr (call print xs)
  Expr (call print (member-call xs slice 3 0))
  Let cloned = (call copy xs)
  Expr (= (index cloned 0) 10)
  Expr (call print xs)
  Expr (call print cloned)
  Let inner = (array 1)
  Let outer = (array inner)
  Let outerCopy = (member-call outer copy)
  Expr (member-call (index outerCopy 0) push 2)
  Expr (call print outer)
  Expr (call print (call concat xs (array 4 5)))
  Expr (call print (member-call xs concat (array)))
  Let copy = (fun (value) (return value))
  Expr (call print (call copy 7))
  Expr (call print (member-call xs copy))
