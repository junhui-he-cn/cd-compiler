Program
  Let prices: map<string, number> = (map (entry "tea" 3) (entry "coffee" 5))
  Expr (call print (index prices "tea"))
  Let alias = prices
  Expr (= (index alias "water") 2)
  Expr (call print (index prices "water"))
  Expr (call print (call len prices))
  Expr (call print (member-call prices len))
  Expr (call print (call contains prices "coffee"))
  Expr (call print (member-call prices contains "tea"))
  Let empty = (map)
  Expr (= (index empty "new") 1)
  Expr (call print (member-call empty len))
  Expr (call print (index empty "new"))
  Let primitives = (map (entry nil "nil") (entry true "bool") (entry 1 "number") (entry "text" "string"))
  Expr (call print (index primitives nil))
  Expr (call print (index primitives true))
  Expr (call print (index primitives 1))
  Expr (call print (index primitives "text"))
  Let duplicates = (map (entry "a" 1) (entry "a" 2))
  Expr (call print (index duplicates "a"))
  Expr (call print (group (= (index duplicates "b") 3)))
  Expr (call print duplicates)
  Let nested: map<string, map<string, number>> = (map (entry "inner" (map (entry "value" 7))))
  Expr (call print (index (index nested "inner") "value"))
  Let nullable: map<string, optional<number>> = (map (entry "present" 1) (entry "missing" nil))
  Expr (call print (index nullable "missing"))
  Let same = duplicates
  Let other = (map (entry "a" 2) (entry "b" 3))
  Expr (call print (== duplicates same))
  Expr (call print (== duplicates other))
  Expr (call print (call typeOf duplicates))
