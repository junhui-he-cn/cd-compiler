struct Person {
  age: number
}

impl Person {
  operator <(other: Person): bool {
    return this.age < other.age;
  }
  operator <=(other: Person): bool {
    return this.age <= other.age;
  }
  operator >(other: Person): bool {
    return this.age > other.age;
  }
  operator >=(other: Person): bool {
    return this.age >= other.age;
  }
}

let one = Person {
  age: 1
};
let two = Person {
  age: 2
};
print one < two;
print one <= two;
print two > one;
print two >= one;
print two < one;
