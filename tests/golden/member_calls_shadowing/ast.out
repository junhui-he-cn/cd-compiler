Program
  Let push = (fun (array, value) (expr (call print "custom push")))
  Let pop = (fun (array) (expr (call print "custom pop")) (return 99))
  Let len = (fun (value) (return 123))
  Let substr = (fun (value, start, length) (return "custom substr"))
  Let charAt = (fun (value, index) (return "custom charAt"))
  Let xs = (array)
  Expr (member-call xs push 10)
  Expr (call print (member-call xs len))
  Expr (call print (member-call xs pop))
  Let text = "hello"
  Expr (call print (member-call text len))
  Expr (call print (member-call text substr 1 2))
  Expr (call print (member-call text charAt 1))
  Expr (call print (call len text))
  Expr (call print (call substr text 1 2))
  Expr (call print (call charAt text 1))
