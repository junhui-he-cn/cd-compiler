main registers=16
0000  block
0001  b0 = constant #0 "Ada"
0002  b1 = constant #1 36
0003  b2 = struct @0 Person { @1 name: b0,  @2 age: b1}
0004  init_global g0, b2
0005  b3 = load_global g0
0006  b4 = field b3,  @5 name
0007  print b4
0008  b5 = load_global g0
0009  b6 = field b5,  @7 age
0010  print b6
0011  b7 = constant #2 1
0012  b8 = constant #3 2
0013  b9 = struct @10 Point { @11 x: b7,  @12 y: b8}
0014  b10 = constant #4 "p"
0015  b11 = struct @8 Nested { @9 point: b9,  @13 label: b10}
0016  init_global g1, b11
0017  b12 = load_global g1
0018  b13 = field b12,  @16 point
0019  b14 = field b13,  @17 x
0020  print b14
0021  b15 = struct @18 Empty {}
0022  print b15
0023  return_nil
