Program
  Fun keys(value)
    Return (array "shadowed-keys")
  Fun values(value)
    Return (array "shadowed-values")
  Let prices = (map (entry "tea" 3))
  Expr (call print (call keys prices))
  Expr (call print (member-call prices keys))
  Expr (call print (call values prices))
  Expr (call print (member-call prices values))
