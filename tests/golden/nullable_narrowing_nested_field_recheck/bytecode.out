main registers=12
0000  b0 = constant #0 nil
0001  store_var @0 read#0, b0
0002  b1 = make_function $0 read/1
0003  assign_var @7 read#0, b1
0004  b2 = load_var @8 read#0
0005  b3 = constant #5 4
0006  b4 = struct @11 Profile { @12 score: b3}
0007  b5 = struct @9 User { @10 profile: b4}
