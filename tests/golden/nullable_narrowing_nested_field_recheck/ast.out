Program
  Struct Profile {score: number?}
  Struct User {profile: Profile}
  Fun read(user: User): number
    If (group (== (field (field user profile) score) nil))
      Then
        Block
          Return 0
    Return (+ (field (field user profile) score) 1)
  Print (call read (construct User profile: (construct Profile score: 4)))
  Print (call read (construct User profile: (construct Profile score: nil)))
