struct Box { value: number? }

fun unwrap(value: number?): number? {
  if (value != nil) {
    return value;
  }
  return 0;
}

let age: number? = nil;
let values: [number?] = [1, nil];
let maybeValues: [number]? = nil;
let box: Box = Box { value: 2 };

print(unwrap(age));
print(values[0]);
print(maybeValues);
print(box.value);

let optional = 7;
let maybe: number? = nil;
let nested: [number?]? = nil;
let callback: optional<fun(number): string> = nil;

print(optional);
print(maybe);
print(nested);
print(callback);
