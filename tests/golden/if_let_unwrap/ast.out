Program
  Fun find(value: number): optional<number>
    If (group (> value 0))
      Then
        Block
          Return (+ value 1)
    Return nil
  Fun process(value: number): optional<string>
    Let next = (? (call find value))
    Return (+ "got:" (call str next))
  Let maybe: optional<number> = (call find 5)
  IfLet v
    Value
maybe
    Then
      Block
        Expr (call print (+ "if-let:" (call str v)))
    Else
      Block
        Expr (call print "if-let:none")
  Expr (call print (?? maybe 0))
  Expr (call print (?? (call find (- 1)) 99))
  Expr (call print (?? (call process 3) "missing"))
  Expr (call print (?? (call process (- 1)) "missing"))
  Let mut next: optional<number> = (call find 1)
  Let mut count = 0
  WhileLet current
    Value
next
    Body
      Block
        Expr (+= count 1)
        Expr (= next nil)
  Expr (call print count)
