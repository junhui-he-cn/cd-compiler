Program
  Enum Option<T> {Some(T), None}
  Enum List<T> {Nil, Cons(T, List<T>)}
  Fun describe(value: Option<number>): string
    Match value
      Arm Option.Some(numberValue)
        Block
          Return (+ "some:" (call str numberValue))
      Arm Option.None
        Block
          Return "none"
  Fun sum(list: List<number>): number
    Match list
      Arm List.Nil
        Block
          Return 0
      Arm List.Cons(first, rest)
        Block
          Return (+ first (call sum rest))
  Let some: Option<number> = (member-call Option Some 7)
  Let none: Option<number> = (member-call Option None<number>)
  Let maybe: optional<Option<number>> = nil
  Let inferred = (member-call Option Some "hello")
  Expr (call print (call describe some))
  Expr (call print (call describe none))
  Expr (call print (call sum (member-call List Cons 1 (member-call List Cons 2 (member-call List Nil<number>)))))
  Match maybe
    Arm nil
      Block
        Expr (call print "nil")
    Arm Option.Some(value)
      Block
        Expr (call print "some")
    Arm Option.None
      Block
        Expr (call print "none")
  Match inferred
    Arm Option.Some(value)
      Block
        Expr (call print value)
    Arm Option.None
      Block
        Expr (call print "none")
