enum Option<T> {
  Some(T),
  None,
}

enum List<T> {
  Nil,
  Cons(T, List<T>),
}

fun describe(value: Option<number>): string {
  match value {
    Option.Some(numberValue) => { return "some:" + str(numberValue); }
    Option.None => { return "none"; }
  }
}

fun sum(list: List<number>): number {
  match list {
    List.Nil => { return 0; }
    List.Cons(first, rest) => { return first + sum(rest); }
  }
}

let some: Option<number> = Option.Some(7);
let none: Option<number> = Option.None::<number>();
let maybe: optional<Option<number>> = nil;
let inferred = Option.Some("hello");
print(describe(some));
print(describe(none));
print(sum(List.Cons(1, List.Cons(2, List.Nil::<number>()))));
match maybe {
  nil => { print("nil"); }
  Option.Some(value) => { print("some"); }
  Option.None => { print("none"); }
}
match inferred {
  Option.Some(value) => { print(value); }
  Option.None => { print("none"); }
}
