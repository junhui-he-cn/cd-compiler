Program
  Module 0
    Struct Box<T: number> {value: T}
    Export Box
  Module 1 entry
    Import "lib.cd"
    Import "lib.cd" as lib
    Let direct: Box<number> = (construct Box<number> value: 1)
    Let namespaced: lib.Box<number> = (construct lib.Box<number> value: 2)
    Expr (call print (field direct value))
    Expr (call print (field namespaced value))
    Expr (call print (call typeOf namespaced))
