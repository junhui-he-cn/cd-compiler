import "./forward.cd" as forwarded;

fun compareAll<T: Ord>(left: T, right: T): [bool] {
  return [left < right, left <= right, left > right, left >= right];
}

let low = forwarded.Point { value: 1 };
let high = forwarded.Point { value: 2 };
print compareAll<forwarded.Point>(low, high);
print compareAll<forwarded.Point>(high, low);
