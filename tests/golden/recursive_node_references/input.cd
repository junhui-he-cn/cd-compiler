struct Node {
  value: number,
  next: optional<Node>
}

let tail = Node { value: 2, next: nil };
let head = Node { value: 1, next: tail };
let alias = tail;
head.next = nil;
alias.value = 20;
print(head.next);
print(tail.value);

let first = Node { value: 3, next: nil };
let second = Node { value: 4, next: first };
first.next = second;
print(first);
print(first == first);
print(first == second);
