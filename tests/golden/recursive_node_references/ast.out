Program
  Struct Node {value: number, next: optional<Node>}
  Let tail = (construct Node value: 2 next: nil)
  Let head = (construct Node value: 1 next: tail)
  Let alias = tail
  Expr (= (field head next) nil)
  Expr (= (field alias value) 20)
  Expr (call print (field head next))
  Expr (call print (field tail value))
  Let first = (construct Node value: 3 next: nil)
  Let second = (construct Node value: 4 next: first)
  Expr (= (field first next) second)
  Expr (call print first)
  Expr (call print (== first first))
  Expr (call print (== first second))
