Program
  Expr (call print (call str 123))
  Expr (call print (call str true))
  Expr (call print (call str nil))
  Expr (call print (call str (array 1 "x")))
  Expr (call print (call substr "hello" 1 3))
  Expr (call print (call substr "hello" 0 5))
  Expr (call print (call substr "hello" 5 0))
  Expr (call print (call charAt "hello" 0))
  Expr (call print (call charAt "hello" 4))
