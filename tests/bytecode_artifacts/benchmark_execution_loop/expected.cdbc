cdbc 0.2

constants:
  c0 = number 0
  c1 = number 0
  c2 = number 200000
  c3 = number 1

names:
  n0 = "i#0"
  n1 = "total#1"
  n2 = "i#0"
  n3 = "total#1"
  n4 = "i#0"
  n5 = "total#1"
  n6 = "i#0"
  n7 = "i#0"
  n8 = "total#1"

globals:
  g0 = n0
  g1 = n1

main registers=12:
  r0 = constant c0
  init_global g0, r0
  r1 = constant c1
  init_global g1, r1
  r2 = load_global g0
  r3 = constant c2
  r4 = less r2, r3
  jump_if_false r4, 17
  r5 = load_global g1
  r6 = load_global g0
  r7 = add r5, r6
  set_global g1, r7
  r8 = load_global g0
  r9 = constant c3
  r10 = add r8, r9
  set_global g0, r10
  jump 4
  r11 = load_global g1
  print r11

