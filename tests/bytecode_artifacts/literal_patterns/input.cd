enum Result {
  Number(number),
  Text(string),
  Empty,
}

fun describeNumber(value: number): string {
  match value {
    0 => { return "zero"; }
    1 => { return "one"; }
    _ => { return "many"; }
  }
}

fun describeBool(value: bool): string {
  match value {
    true => { return "true"; }
    false => { return "false"; }
  }
}

fun describeResult(value: optional<Result>): string {
  match value {
    nil => { return "nil"; }
    Result.Number(0) => { return "zero"; }
    Result.Number(value) => { return "number:" + str(value); }
    Result.Text("") => { return "empty-text"; }
    Result.Text(value) => { return "text:" + value; }
    Result.Empty => { return "empty"; }
  }
}

let maybe: optional<bool> = nil;
print(describeNumber(0));
print(describeNumber(8));
print(describeBool(false));
print(describeResult(Result.Number(7)));
print(describeResult(Result.Text("")));
print(describeResult(nil));
match 1 {
  0 => { print("zero"); }
  1 => { print("one"); }
  _ => { print("many"); }
}
match true {
  false => { print("no"); }
  true => { print("yes"); }
}
match "ok" {
  "" => { print("empty"); }
  "ok" => { print("ok"); }
  _ => { print("other"); }
}
match maybe {
  nil => { print("nil"); }
  true => { print("true"); }
  false => { print("false"); }
}
