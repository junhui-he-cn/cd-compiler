debug_sources:
  s0 path="tests/bytecode_artifacts/literal_patterns/input.cd" text="enum Result {\n  Number(number),\n  Text(string),\n  Empty,\n}\n\nfun describeNumber(value: number): string {\n  match value {\n    0 => { return \"zero\"; }\n    1 => { return \"one\"; }\n    _ => { return \"many\"; }\n  }\n}\n\nfun describeBool(value: bool): string {\n  match value {\n    true => { return \"true\"; }\n    false => { return \"false\"; }\n  }\n}\n\nfun describeResult(value: optional<Result>): string {\n  match value {\n    nil => { return \"nil\"; }\n    Result.Number(0) => { return \"zero\"; }\n    Result.Number(value) => { return \"number:\" + str(value); }\n    Result.Text(\"\") => { return \"empty-text\"; }\n    Result.Text(value) => { return \"text:\" + value; }\n    Result.Empty => { return \"empty\"; }\n  }\n}\n\nlet maybe: optional<bool> = nil;\nprint describeNumber(0);\nprint describeNumber(8);\nprint describeBool(false);\nprint describeResult(Result.Number(7));\nprint describeResult(Result.Text(\"\"));\nprint describeResult(nil);\nmatch 1 {\n  0 => { print \"zero\"; }\n  1 => { print \"one\"; }\n  _ => { print \"many\"; }\n}\nmatch true {\n  false => { print \"no\"; }\n  true => { print \"yes\"; }\n}\nmatch \"ok\" {\n  \"\" => { print \"empty\"; }\n  \"ok\" => { print \"ok\"; }\n  _ => { print \"other\"; }\n}\nmatch maybe {\n  nil => { print \"nil\"; }\n  true => { print \"true\"; }\n  false => { print \"false\"; }\n}\n"

