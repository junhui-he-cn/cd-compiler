  i1 = "contains" abi=1

main registers=25:
block b0:
  r0 = constant c0
  r1 = constant c1
  r2 = constant c2
  r3 = constant c3
  r4 = map [r0: r1, r2: r3]
  init_global g0, r4
  r5 = load_global g0
  init_global g1, r5
  r6 = load_global g1
  r7 = constant c4
  r8 = constant c5
  r9 = map_set r6, r7, r8
  r10 = load_global g0
  r11 = constant c6
  r12 = map_get r10, r11
  r13 = call_native i0 [r12]
  r14 = load_global g0
  r15 = constant c7
  r16 = map_get r14, r15
  r17 = call_native i0 [r16]
  r18 = load_global g0
  r19 = len_map r18
  r20 = call_native i0 [r19]
  r21 = load_global g0
  r22 = constant c8
  r23 = call_native i1 [r21, r22]
  r24 = call_native i0 [r23]
  return_nil

