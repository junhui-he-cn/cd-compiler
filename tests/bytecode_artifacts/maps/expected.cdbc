cdbc 0.2

constants:
  c0 = string "tea"
  c1 = number 3
  c2 = string "coffee"
  c3 = number 5
  c4 = string "water"
  c5 = number 2
  c6 = string "tea"
  c7 = string "water"
  c8 = string "coffee"

