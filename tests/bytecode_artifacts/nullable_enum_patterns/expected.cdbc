debug_sources:
  s0 path="tests/bytecode_artifacts/nullable_enum_patterns/input.cd" text="enum Option {\n  Some(number),\n  None,\n}\n\nfun describe(value: optional<Option>): string {\n  match value {\n    nil => { return \"nil\"; }\n    Option.Some(value) if value > 10 => { return \"large\"; }\n    Option.Some(value) => { return \"some:\" + str(value); }\n    Option.None => { return \"none\"; }\n  }\n}\n\nlet some: optional<Option> = Option.Some(7);\nlet none: optional<Option> = nil;\nprint describe(some);\nprint describe(none);\nmatch some {\n  nil => { print \"nil\"; }\n  Option.Some(value) if value > 10 => { print \"large\"; }\n  Option.Some(_) => { print \"some\"; }\n  Option.None => { print \"none\"; }\n}\nmatch none {\n  nil if true => { print \"guarded nil\"; }\n  _ => { print \"fallback\"; }\n}\n"

