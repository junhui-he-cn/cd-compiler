enum Option {
  Some(number),
  None,
}

fun describe(value: optional<Option>): string {
  match value {
    nil => { return "nil"; }
    Option.Some(value) if value > 10 => { return "large"; }
    Option.Some(value) => { return "some:" + str(value); }
    Option.None => { return "none"; }
  }
}

let some: optional<Option> = Option.Some(7);
let none: optional<Option> = nil;
print(describe(some));
print(describe(none));
match some {
  nil => { print("nil"); }
  Option.Some(value) if value > 10 => { print("large"); }
  Option.Some(_) => { print("some"); }
  Option.None => { print("none"); }
}
match none {
  nil if true => { print("guarded nil"); }
  _ => { print("fallback"); }
}
