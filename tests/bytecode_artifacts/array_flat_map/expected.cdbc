cdbc 0.2

constants:
  c0 = number 1
  c1 = number 2
  c2 = number 10
  c3 = nil
  c4 = number 1
  c5 = nil

names:
  n0 = "values#0"
  n1 = "values#0"
  n2 = "value#1"
  n3 = "value#1"
  n4 = "flatMap"
  n5 = "values#0"
  n6 = "value#2"
  n7 = "flatMap"

globals:
  g0 = n0

main registers=9:
block b0:
  r0 = constant c0
  r1 = constant c1
  r2 = array [r0, r1]
  init_global g0, r2
  r3 = load_global g0
  r4 = make_function f0
  r5 = native_call n4 [r3, r4]
  print r5
  r6 = load_global g0
  r7 = make_function f1
  r8 = native_call n7 [r6, r7]
  print r8
  return_nil

function f0 name="<lambda>" arity=1 registers=6:
  param 0 = "value#1"
block b0:
  r0 = load_local l0
  r1 = load_local l0
  r2 = constant c2
  r3 = multiply r1, r2
  r4 = array [r0, r3]
  return r4
block b1:
  r5 = constant c3
  return r5
block b2:
  return_nil

function f1 name="<lambda>" arity=1 registers=5:
  param 0 = "value#2"
block b0:
  r0 = load_local l0
  r1 = constant c4
  r2 = add r0, r1
  r3 = array [r2]
  return r3
block b1:
  r4 = constant c5
  return r4
block b2:
  return_nil

