types:
  t0 = struct "Person" field0="name" field1="age"

main registers=8:
block b0:
  r0 = constant c0
  r1 = constant c1
  r2 = make_struct t0 [r0, r1]
  init_global g0, r2
  r3 = load_global g0
  r4 = constant c2
  r5 = struct_set r3, t0, 1, r4
  r6 = load_global g0
  r7 = struct_get r6, t0, 1
  print r7
  return_nil

