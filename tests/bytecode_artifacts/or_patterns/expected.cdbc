debug_sources:
  s0 path="tests/bytecode_artifacts/or_patterns/input.cd" text="enum Shape {\n  Point(x: number),\n  Line(x: number, y: number),\n  Empty,\n}\n\nfun numberLabel(value: number): string {\n  match value {\n    0 | 1 => { return \"small\"; }\n    _ => { return \"other\"; }\n  }\n}\n\nfun shapeLabel(value: Shape): string {\n  match value {\n    Shape.Point(x) | Shape.Line(x, _) if x > 3 => { return \"large:\" + str(x); }\n    Shape.Point(_) | Shape.Line(_, _) => { return \"small\"; }\n    Shape.Empty => { return \"empty\"; }\n  }\n}\n\nlet maybe: optional<bool> = false;\nprint numberLabel(1);\nprint numberLabel(8);\nprint shapeLabel(Shape.Point(3));\nprint shapeLabel(Shape.Line(4, 10));\nprint shapeLabel(Shape.Empty());\nmatch maybe {\n  nil | false => { print \"off\"; }\n  true => { print \"on\"; }\n}\nmatch true {\n  true | false => { print \"bool\"; }\n}\n"

