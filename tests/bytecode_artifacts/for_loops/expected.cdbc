  n5 = "total#0"
  n6 = "i#1"
  n7 = "total#0"
  n8 = "total#0"

globals:
  g0 = n0
  g1 = n1

main registers=12:
  r0 = constant c0
  init_global g0, r0
  r1 = constant c1
  init_global g1, r1
  r2 = load_global g1
  r3 = constant c2
  r4 = less r2, r3
  jump_if_false r4, 19
  jump 14
  r5 = load_global g1
  r6 = constant c3
  r7 = add r5, r6
  set_global g1, r7
  jump 4
  r8 = load_global g0
  r9 = load_global g1
  r10 = add r8, r9
  set_global g0, r10
  jump 9
  r11 = load_global g0
  print r11

