cdbc 0.2

constants:
  c0 = string "tea"
  c1 = number 3
  c2 = string "coffee"
  c3 = number 5

names:
  n0 = "prices#0"
  n1 = "prices#0"
  n2 = "keys"
  n3 = "prices#0"
  n4 = "values"

globals:
  g0 = n0

main registers=9:
  r0 = constant c0
  r1 = constant c1
  r2 = constant c2
  r3 = constant c3
  r4 = map [r0: r1, r2: r3]
  init_global g0, r4
  r5 = load_global g0
  r6 = native_call n2 [r5]
  print r6
  r7 = load_global g0
  r8 = native_call n4 [r7]
  print r8

debug_sources:
  s0 path="tests/bytecode_artifacts/map_keys_values/input.cd" text="let prices = {\"tea\": 3, \"coffee\": 5};\nprint keys(prices);\nprint prices.values();\n"

debug_locations:
