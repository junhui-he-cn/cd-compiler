  main 1 = s0:1:22
  main 2 = s0:1:25
  main 3 = s0:1:35
  main 4 = s0:1:14
  main 5 = s0:1:1
  main 6 = s0:2:12
  main 7 = s0:2:7
  main 8 = s0:2:1
  main 9 = s0:3:7
  main 10 = s0:3:7
  main 11 = s0:3:1

