cdbc 0.2

constants:
  c0 = string "tea"
  c1 = number 3
  c2 = string "coffee"
  c3 = number 5

names:
  n0 = "prices#0"
  n1 = "prices#0"
  n2 = "keys"
  n3 = "print"
  n4 = "prices#0"
  n5 = "values"
  n6 = "print"

globals:
  g0 = n0

native_imports:
  i0 = "keys" abi=1
  i1 = "print" abi=1
  i2 = "values" abi=1

main registers=11:
block b0:
  r0 = constant c0
  r1 = constant c1
  r2 = constant c2
  r3 = constant c3
  r4 = map [r0: r1, r2: r3]
  init_global g0, r4
  r5 = load_global g0
  r6 = call_native i0 [r5]
  r7 = call_native i1 [r6]
  r8 = load_global g0
  r9 = call_native i2 [r8]
  r10 = call_native i1 [r9]
  return_nil

debug_sources:
