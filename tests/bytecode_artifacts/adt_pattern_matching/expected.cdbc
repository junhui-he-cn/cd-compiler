cdbc 0.2

constants:
  c0 = number 4
  c1 = number 0

names:
  n0 = "Option"
  n1 = "Some"
  n2 = "value#0"
  n3 = "value#0"
  n4 = "Option"
  n5 = "Some"
  n6 = "number#1"
  n7 = "number#1"
  n8 = "Option"
  n9 = "None"

globals:
  g0 = n2
  g1 = n6

main registers=8:
block b0:
  r0 = constant c0
  r1 = variant n0.n1 [r0]
  init_global g0, r1
  r2 = load_global g0
  r3 = variant_tag r2 n4.n5
  br_if r3, b1, b2
block b1:
  r4 = variant_field r2 0
  init_global g1, r4
  r5 = load_global g1
  print r5
  return_nil
block b2:
  r6 = variant_tag r2 n8.n9
  br_if r6, b3, b4
block b3:
  r7 = constant c1
  print r7
  return_nil
block b4:
  return_nil

debug_sources:
