cdbc 0.2

constants:
  c0 = number 1
  c1 = number 2

names:
  n0 = "x#0"
  n1 = "x#0"
  n2 = "`+=` expects number variable"
  n3 = "`+=` expects number value"
  n4 = "x#0"
  n5 = "x#0"

globals:
  g0 = n0

native_imports:
  i0 = "print" abi=1

main registers=8:
block b0:
  r0 = constant c0
  init_global g0, r0
  r1 = load_global g0
  r2 = assert_number r1, n2
  r3 = constant c1
  r4 = assert_number r3, n3
  r5 = add_num r2, r4
  set_global g0, r5
  r6 = load_global g0
  r7 = call_native i0 [r6]
  return_nil

debug_sources:
