cdbc 0.2

constants:
  c0 = string "a"
  c1 = number 1
  c2 = string "b"
  c3 = number 2
  c4 = string "a"
  c5 = string "b"

names:
  n0 = "values#0"
  n1 = "values#0"
  n2 = "alias#1"
  n3 = "values#0"
  n4 = "remove"
  n5 = "alias#1"
  n6 = "alias#1"
  n7 = "remove"
  n8 = "values#0"

globals:
  g0 = n0
  g1 = n2

native_imports:
  i0 = "remove" abi=1
  i1 = "print" abi=1

main registers=16:
block b0:
  r0 = constant c0
  r1 = constant c1
  r2 = constant c2
  r3 = constant c3
  r4 = map [r0: r1, r2: r3]
  init_global g0, r4
  r5 = load_global g0
  init_global g1, r5
  r6 = load_global g0
  r7 = constant c4
  r8 = call_native i0 [r6, r7]
  r15 = call_native i1 [r8]
  r9 = load_global g1
  r15 = call_native i1 [r9]
  r10 = load_global g1
  r11 = constant c5
  r12 = call_native i0 [r10, r11]
  r15 = call_native i1 [r12]
  r13 = load_global g0
  r14 = len r13
  r15 = call_native i1 [r14]
  return_nil

debug_sources:
