cdbc 0.2

constants:
  c0 = string "Ada"
  c1 = number 36
  c2 = number 1
  c3 = string "p"

names:
  n0 = "Person"
  n1 = "name"
  n2 = "age"
  n3 = "person#0"
  n4 = "person#0"
  n5 = "name"
  n6 = "Person"
  n7 = "Nested"
