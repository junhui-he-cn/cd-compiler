debug_sources:
  s0 path="tests/bytecode_artifacts/array_reduce/input.cd" text="let values: [number] = [1, 2, 3];\nlet offset: number = 10;\nlet total: number = reduce(values, 0, fun (acc, value) {\n  return acc + value + offset;\n});\nlet product: number = values.reduce(1, fun (acc: number, value: number): number {\n  return acc * value;\n});\nlet snapshot: [number] = [1, 2];\nlet snapshotTotal: number = reduce(snapshot, 0, fun (acc, value) {\n  push(snapshot, 9);\n  return acc + value;\n});\nlet empty: string = [].reduce(\"seed\", fun (acc: string, value): string {\n  return acc;\n});\nlet initial: [number] = [];\nlet collected: [number] = reduce(values, initial, fun (acc, value) {\n  push(acc, value);\n  return acc;\n});\n\nprint total;\nprint product;\nprint snapshotTotal;\nprint snapshot;\nprint empty;\nprint collected;\n"

