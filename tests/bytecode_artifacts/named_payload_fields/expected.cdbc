cdbc 0.2

constants:
  c0 = number 2
  c1 = number 4
  c2 = number 10
  c3 = number 0

names:
  n0 = "Pair"
  n1 = "Values"
  n2 = "pair#0"
  n3 = "pair#0"
  n4 = "Pair"
  n5 = "Values"
  n6 = "leftValue#1"
  n7 = "rightValue#2"
  n8 = "rightValue#2"
  n9 = "leftValue#1"
  n10 = "Pair"
  n11 = "Empty"

globals:
  g0 = n2
  g1 = n6
  g2 = n7

main registers=14:
block b0:
  r0 = constant c0
  r1 = constant c1
  r2 = variant n0.n1 [r0, r1]
  init_global g0, r2
  r3 = load_global g0
  r4 = variant_tag r3 n4.n5
  br_if r4, b1, b2
block b1:
  r5 = variant_field r3 0
  r6 = variant_field r3 1
  init_global g1, r5
  init_global g2, r6
  r7 = load_global g2
  r8 = constant c2
  r9 = multiply r7, r8
  r10 = load_global g1
  r11 = add r9, r10
  print r11
  return_nil
block b2:
  r12 = variant_tag r3 n10.n11
  br_if r12, b3, b4
block b3:
  r13 = constant c3
  print r13
  return_nil
block b4:
  return_nil

debug_sources:
  s0 path="tests/bytecode_artifacts/named_payload_fields/input.cd" text="enum Pair { Values(number, number), Empty }\nlet pair = Pair.Values(2, 4);\nmatch pair {\n  Pair.Values(leftValue, rightValue) => { print rightValue * 10 + leftValue; }\n  Pair.Empty => { print 0; }\n}\n"

