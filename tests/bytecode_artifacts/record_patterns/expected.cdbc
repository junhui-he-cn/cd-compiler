debug_sources:
  s0 path="tests/bytecode_artifacts/record_patterns/input.cd" text="struct Address { city: string, zip: number }\nstruct Person { name: string, age: number, address: Address }\n\nfun describe(value: optional<Person>): string {\n  match value {\n    nil => { return \"nil\"; }\n    Person { name: \"Ada\" } => { return \"ada\"; }\n    Person { address: Address { city: \"Hong Kong\" }, name: name } => { return \"city:\" + name; }\n    Person { age: age, name: name } => { return name + \":\" + str(age); }\n  }\n}\n\nlet ada = Person {\n  name: \"Ada\",\n  age: 36,\n  address: Address { city: \"Cambridge\", zip: 1 }\n};\nlet hongKong = Person {\n  name: \"Grace\",\n  age: 40,\n  address: Address { city: \"Hong Kong\", zip: 2 }\n};\nlet nilPerson: optional<Person> = nil;\nprint(describe(ada));\nprint(describe(hongKong));\nprint(describe(nilPerson));\nmatch ada {\n  Person { name: \"Ada\" } | Person { age: 0 } => { print(\"or\"); }\n  Person {} => { print(\"fallback\"); }\n}\n"

