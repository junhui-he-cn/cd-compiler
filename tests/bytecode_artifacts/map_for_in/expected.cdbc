cdbc 0.2

constants:
  c0 = string "a"
  c1 = number 1
  c2 = string "b"
  c3 = number 2
  c4 = string "c"
  c5 = number 3
  c6 = nil

names:
  n0 = "values#0"
  n1 = "values#0"
  n2 = "key#1"
  n3 = "key#1"
  n4 = "key#1"
  n5 = "values#0"
  n6 = "key#1"
  n7 = "remove"
  n8 = "values#0"

globals:
  g0 = n0
  g1 = n2

native_imports:
  i0 = "print" abi=1
  i1 = "remove" abi=1

main registers=18:
block b0:
  r0 = constant c0
  r1 = constant c1
  r2 = constant c2
  r3 = constant c3
  r4 = constant c4
  r5 = constant c5
  r6 = map [r0: r1, r2: r3, r4: r5]
  init_global g0, r6
  r7 = load_global g0
  r8 = iter_init r7
  r9 = constant c6
  init_global g1, r9
  br b1
block b1:
  r10 = iter_has r8
  br_if r10, b2, b3
block b2:
  r11 = iter_next r8
  set_global g1, r11
  r12 = load_global g1
  r17 = call_native i0 [r12]
  r13 = load_global g0
  r14 = load_global g1
  r15 = call_native i1 [r13, r14]
  br b1
block b3:
  r16 = load_global g0
  r17 = call_native i0 [r16]
  return_nil

