cdbc 0.2

constants:
  c0 = string "a"
  c1 = number 1
  c2 = string "b"
  c3 = number 2
  c4 = string "c"
  c5 = number 3

names:
  n0 = "values#0"
  n1 = "values#0"
  n2 = "alias#1"
  n3 = "values#0"
  n4 = "clear"
  n5 = "alias#1"
  n6 = "print"
  n7 = "values#0"
  n8 = "values#0"
  n9 = "clear"
  n10 = "print"
  n11 = "values#0"
  n12 = "print"

globals:
  g0 = n0
  g1 = n2

native_imports:
  i0 = "clear" abi=1
  i1 = "print" abi=1

main registers=20:
block b0:
  r0 = constant c0
  r1 = constant c1
  r2 = constant c2
  r3 = constant c3
  r4 = map [r0: r1, r2: r3]
  init_global g0, r4
  r5 = load_global g0
  init_global g1, r5
  r6 = load_global g0
  r7 = call_native i0 [r6]
  r8 = load_global g1
  r9 = call_native i1 [r8]
  r10 = load_global g0
  r11 = constant c4
  r12 = constant c5
  r13 = map_set r10, r11, r12
  r14 = load_global g0
  r15 = call_native i0 [r14]
  r16 = call_native i1 [r15]
  r17 = load_global g0
  r18 = len_map r17
  r19 = call_native i1 [r18]
  return_nil

debug_sources:
