cdbc 0.2

constants:
  c0 = string "a"
  c1 = number 1
  c2 = string "b"
  c3 = number 2
  c4 = string "c"
  c5 = number 3

names:
  n0 = "values#0"
  n1 = "values#0"
  n2 = "alias#1"
  n3 = "values#0"
  n4 = "clear"
  n5 = "alias#1"
  n6 = "values#0"
  n7 = "values#0"
  n8 = "clear"
  n9 = "values#0"

globals:
  g0 = n0
  g1 = n2

native_imports:
  i0 = "clear" abi=1
  i1 = "print" abi=1

main registers=18:
block b0:
  r0 = constant c0
  r1 = constant c1
  r2 = constant c2
  r3 = constant c3
  r4 = map [r0: r1, r2: r3]
  init_global g0, r4
  r5 = load_global g0
  init_global g1, r5
  r6 = load_global g0
  r7 = call_native i0 [r6]
  r8 = load_global g1
  r17 = call_native i1 [r8]
  r9 = load_global g0
  r10 = constant c4
  r11 = constant c5
  r12 = map_set r9, r10, r11
  r13 = load_global g0
  r14 = call_native i0 [r13]
  r17 = call_native i1 [r14]
  r15 = load_global g0
  r16 = len_map r15
  r17 = call_native i1 [r16]
  return_nil

debug_sources:
  s0 path="tests/bytecode_artifacts/map_clear/input.cd" text="let values = {\"a\": 1, \"b\": 2};\nlet alias = values;\nclear(values);\nprint alias;\nvalues[\"c\"] = 3;\nprint values.clear();\nprint values.len();\n"

