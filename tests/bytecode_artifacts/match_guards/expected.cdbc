cdbc 0.2

constants:
  c0 = number 4
  c1 = number 4
  c2 = number 0
  c3 = number 0

names:
  n0 = "Option"
  n1 = "Some"
  n2 = "value#0"
  n3 = "value#0"
  n4 = "Option"
  n5 = "Some"
  n6 = "number#1"
  n7 = "number#1"
  n8 = "number#1"
  n9 = "Option"
  n10 = "Some"
  n11 = "Option"
  n12 = "None"

globals:
  g0 = n2
  g1 = n6

main registers=14:
  r0 = constant c0
  r1 = variant n0.n1 [r0]
  init_global g0, r1
  r2 = load_global g0
  r3 = variant_tag r2 n4.n5
  jump_if_false r3, 15
  r4 = variant_field r2 0
  init_global g1, r4
  r5 = load_global g1
  r6 = constant c1
  r7 = greater r5, r6
  jump_if_false r7, 15
  r8 = load_global g1
  print r8
  jump 26
  r9 = variant_tag r2 n9.n10
  jump_if_false r9, 21
  r10 = variant_field r2 0
  r11 = constant c2
  print r11
  jump 26
  r12 = variant_tag r2 n11.n12
  jump_if_false r12, 26
  r13 = constant c3
  print r13
  jump 26

