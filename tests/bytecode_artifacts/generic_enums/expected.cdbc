debug_sources:
  s0 path="tests/bytecode_artifacts/generic_enums/input.cd" text="enum Option<T> {\n  Some(T),\n  None,\n}\n\nenum List<T> {\n  Nil,\n  Cons(T, List<T>),\n}\n\nfun describe(value: Option<number>): string {\n  match value {\n    Option.Some(numberValue) => { return \"some:\" + str(numberValue); }\n    Option.None => { return \"none\"; }\n  }\n}\n\nfun sum(list: List<number>): number {\n  match list {\n    List.Nil => { return 0; }\n    List.Cons(first, rest) => { return first + sum(rest); }\n  }\n}\n\nlet some: Option<number> = Option.Some(7);\nlet none: Option<number> = Option.None<number>();\nlet maybe: optional<Option<number>> = nil;\nlet inferred = Option.Some(\"hello\");\nprint describe(some);\nprint describe(none);\nprint sum(List.Cons(1, List.Cons(2, List.Nil<number>())));\nmatch maybe {\n  nil => { print \"nil\"; }\n  Option.Some(value) => { print \"some\"; }\n  Option.None => { print \"none\"; }\n}\nmatch inferred {\n  Option.Some(value) => { print value; }\n  Option.None => { print \"none\"; }\n}\n"

