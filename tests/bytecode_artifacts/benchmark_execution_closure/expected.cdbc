function f0 name="add" arity=1 registers=4:
  param 0 = "value#3"
  upvalue u0 = local l0
  r0 = load_local l0
  r1 = load_upvalue u0
  r2 = add r0, r1
  return r2
  r3 = constant c2
  return r3

function f1 name="makeAdder" arity=1 registers=4:
  param 0 = "offset#1"
  r0 = constant c1
  bind_local l1, r0
  r1 = make_function f0
  set_local l1, r1
  r2 = load_local l1
  return r2
  r3 = constant c3
  return r3

