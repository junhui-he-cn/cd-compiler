  "domain": "language-server-workspace-symbols",
  "status": "resolved",
  "question": "What multi-document symbol query can cross the prototype LSP boundary without choosing a project model?",
  "decision": "Add workspace/symbol over currently open documents, using shared declaration indexes, optional substring filtering, and deterministic URI/source-range locations.",
  "query": {
    "result": "SymbolInformation[]",
    "documents": "currently open URI documents only",
    "filter": "optional case-sensitive declaration-name substring",
    "ordering": "URI, source start, source end, name",
    "closed_document": "removed immediately"
  },
  "shared_services": [
    "DeclarationIndex declarations",
    "TypeChecker document analysis",
    "Program source ranges"
  ],
  "compatibility_boundary": {
    "imports": "existing stdin import rejection remains",
    "filesystem": "no file loading or workspace root",
    "protocol_ids": "snapshot-local IDs are not serialized"
  },
  "quantitative_gate": "tests/lsp_tests.py covers a second open URI, filtered symbol location, and close cleanup.",
  "out_of_scope": [
    "imported module loading",
    "cross-module definition and references",
    "scope-aware workspace completion",
    "workspace folders and filesystem watchers",
    "persistent semantic caches",
    "range-based synchronization"
  ],
  "verification": {
    "focused_commands": [
      "cmake --build build --target compiler_design",
      "ctest --test-dir build --output-on-failure -R '^language_server$'",
      "python3 tests/lsp_tests.py ./build/compiler_design",
      "git diff --check"
    ]
  }
}
