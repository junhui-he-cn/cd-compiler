// Cache structures.

import "./linked_structures.cd";

struct LruCacheEntry<K, V> {
  key: K,
  value: V
}

struct LruCache<K: Eq, V> {
  private head: optional<LinkedNode<LruCacheEntry<K, V>>>,
  private tail: optional<LinkedNode<LruCacheEntry<K, V>>>,
  private count: number,
  private limit: number
}

impl LruCache<K: Eq, V> {
  // Entries are kept from least recently used to most recently used. Nodes
  // are private handles; unlinking clears their outgoing link so eviction
  // does not retain the rest of the cache through an old node.
  fun findNode(key: K): optional<LinkedNode<LruCacheEntry<K, V>>> {
    let current = this.head;
    while (current != nil) {
      let node: LinkedNode<LruCacheEntry<K, V>> = current;
      let entry = node.readValue();
      if (entry.key == key) {
        return node;
      }
      current = node.nextNode();
    }
    return nil;
  }

  fun appendNode(node: LinkedNode<LruCacheEntry<K, V>>) {
    let tail = this.tail;
    if (tail == nil) {
      this.head = node;
      this.tail = node;
      return;
    }

    let tailNode: LinkedNode<LruCacheEntry<K, V>> = tail;
    tailNode.setNext(node);
    this.tail = node;
  }

  fun unlinkNode(target: LinkedNode<LruCacheEntry<K, V>>) {
    let previous: optional<LinkedNode<LruCacheEntry<K, V>>> = nil;
    let current = this.head;
    while (current != nil) {
      let node: LinkedNode<LruCacheEntry<K, V>> = current;
      if (node == target) {
        let next = node.nextNode();
        if (previous == nil) {
          this.head = next;
        } else {
          let previousNode: LinkedNode<LruCacheEntry<K, V>> = previous;
          previousNode.setNext(next);
        }
        if (next == nil) {
          this.tail = previous;
        }
        node.setNext(nil);
        return;
      }
      previous = current;
      current = node.nextNode();
    }
  }

  fun moveToBack(node: LinkedNode<LruCacheEntry<K, V>>) {
    if (node.nextNode() == nil) {
      return;
    }
    this.unlinkNode(node);
    this.appendNode(node);
  }

  fun removeNode(node: LinkedNode<LruCacheEntry<K, V>>) {
    this.unlinkNode(node);
    this.count -= 1;
  }

  fun capacity(): number {
    return this.limit;
  }

  fun size(): number {
    return this.count;
  }

  fun isEmpty(): bool {
    return this.count == 0;
  }

  fun has(key: K): bool {
    return this.findNode(key) != nil;
  }

  fun get(key: K): optional<V> {
    let found = this.findNode(key);
    if (found == nil) {
      return nil;
    }
    let node: LinkedNode<LruCacheEntry<K, V>> = found;
    let entry = node.readValue();
    this.moveToBack(node);
    return entry.value;
  }

  fun put(key: K, value: V): bool {
    if (this.limit <= 0) {
      return false;
    }

    let found = this.findNode(key);
    if (found != nil) {
      let node: LinkedNode<LruCacheEntry<K, V>> = found;
      let entry = node.readValue();
      entry.value = value;
      node.setValue(entry);
      this.moveToBack(node);
      return true;
    }

    if (this.count >= this.limit) {
      let head = this.head;
      if (head != nil) {
        let headNode: LinkedNode<LruCacheEntry<K, V>> = head;
        this.removeNode(headNode);
      }
    }

    let node = newLinkedNode<LruCacheEntry<K, V>>(LruCacheEntry<K, V> {
      key: key,
      value: value
    });
    this.appendNode(node);
    this.count += 1;
    return true;
  }

  fun discard(key: K): bool {
    let found = this.findNode(key);
    if (found == nil) {
      return false;
    }
    let node: LinkedNode<LruCacheEntry<K, V>> = found;
    this.removeNode(node);
    return true;
  }

  fun snapshot(): [LruCacheEntry<K, V>] {
    let result: [LruCacheEntry<K, V>] = [];
    let current = this.head;
    while (current != nil) {
      let node: LinkedNode<LruCacheEntry<K, V>> = current;
      let entry = node.readValue();
      result.push(LruCacheEntry<K, V> {
        key: entry.key,
        value: entry.value
      });
      current = node.nextNode();
    }
    return result;
  }
}

fun newLruCache<K: Eq, V>(capacity: number): LruCache<K, V> {
  let limit = floor(capacity);
  if (limit < 0) {
    limit = 0;
  }
  return LruCache<K, V> {
    head: nil,
    tail: nil,
    count: 0,
    limit: limit
  };
}

struct LfuCacheEntry<K, V> {
  key: K,
  value: V,
  frequency: number
}

struct LfuCache<K: Eq, V> {
  private keys: [K],
  private values: [V],
  private frequencies: [number],
  private lastUsed: [number],
  private limit: number,
  private clock: number
}

impl LfuCache<K: Eq, V> {
  fun indexOf(key: K): number {
    let index = 0;
    while (index < this.keys.len()) {
      if (this.keys[index] == key) {
        return index;
      }
      index += 1;
    }
    return -1;
  }

  fun touch(index: number) {
    this.frequencies[index] += 1;
    this.clock += 1;
    this.lastUsed[index] = this.clock;
  }

  fun evictionIndex(): number {
    let candidate = 0;
    let index = 1;
    while (index < this.keys.len()) {
      if (this.frequencies[index] < this.frequencies[candidate]
          || (this.frequencies[index] == this.frequencies[candidate]
              && this.lastUsed[index] < this.lastUsed[candidate])) {
        candidate = index;
      }
      index += 1;
    }
    return candidate;
  }

  fun removeAt(index: number) {
    while (index + 1 < this.keys.len()) {
      this.keys[index] = this.keys[index + 1];
      this.values[index] = this.values[index + 1];
      this.frequencies[index] = this.frequencies[index + 1];
      this.lastUsed[index] = this.lastUsed[index + 1];
      index += 1;
    }
    this.keys.pop();
    this.values.pop();
    this.frequencies.pop();
    this.lastUsed.pop();
  }

  fun capacity(): number {
    return this.limit;
  }

  fun size(): number {
    return this.keys.len();
  }

  fun isEmpty(): bool {
    return this.keys.len() == 0;
  }

  fun has(key: K): bool {
    return this.indexOf(key) >= 0;
  }

  fun get(key: K): optional<V> {
    let index = this.indexOf(key);
    if (index < 0) {
      return nil;
    }
    let value = this.values[index];
    this.touch(index);
    return value;
  }

  fun frequencyOf(key: K): optional<number> {
    let index = this.indexOf(key);
    if (index < 0) {
      return nil;
    }
    return this.frequencies[index];
  }

  fun put(key: K, value: V): bool {
    if (this.limit <= 0) {
      return false;
    }
    let index = this.indexOf(key);
    if (index >= 0) {
      this.values[index] = value;
      this.touch(index);
      return true;
    }
    if (this.keys.len() >= this.limit) {
      this.removeAt(this.evictionIndex());
    }
    this.keys.push(key);
    this.values.push(value);
    this.frequencies.push(1);
    this.clock += 1;
    this.lastUsed.push(this.clock);
    return true;
  }

  fun discard(key: K): bool {
    let index = this.indexOf(key);
    if (index < 0) {
      return false;
    }
    this.removeAt(index);
    return true;
  }

  fun snapshot(): [LfuCacheEntry<K, V>] {
    let result: [LfuCacheEntry<K, V>] = [];
    let index = 0;
    while (index < this.keys.len()) {
      result.push(LfuCacheEntry<K, V> {
        key: this.keys[index],
        value: this.values[index],
        frequency: this.frequencies[index]
      });
      index += 1;
    }
    return result;
  }
}

fun newLfuCache<K: Eq, V>(capacity: number): LfuCache<K, V> {
  let limit = floor(capacity);
  if (limit < 0) {
    limit = 0;
  }
  return LfuCache<K, V> {
    keys: [],
    values: [],
    frequencies: [],
    lastUsed: [],
    limit: limit,
    clock: 0
  };
}

export LruCacheEntry, LruCache, newLruCache, LfuCacheEntry, LfuCache, newLfuCache;
