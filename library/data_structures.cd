       serializeNumericTree, deserializeNumericTree, treeLowestCommonAncestor,
       bstInsert, bstDelete, bstMinimum, bstMaximum, bstPredecessor,
       bstSuccessor, AvlTree, newAvlTree, RedBlackTree, newRedBlackTree
       from "./trees.cd";

