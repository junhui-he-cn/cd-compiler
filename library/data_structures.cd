// Public compatibility entry point for the data-structure library.
//
// Implementations are grouped by dependency and topic. Existing clients can
// keep importing this file as ds; the facade preserves the original exports.

export Stack, Queue, Deque, RingBuffer, BinaryHeap, Option, Result, List,
       newStack, newQueue, newDeque, newRingBuffer, newBinaryHeap,
       some, none, ok, err, emptyList, prepend, head, tail, reverse, toArray,
       listLength, listGet, listAppend, listConcat, listTake, listDrop,
       mergeSortedLists, listMiddle, listIsPalindrome, listRemoveFromEnd
       from "./collections.cd";

