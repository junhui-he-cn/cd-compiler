// Generic stack and queue implementations built from the public language API.
//
// Stack uses add/take instead of push/pop because those names are reserved by
// the current builtin member-call sugar. Queue exposes enqueue/dequeue, which
// do not collide with a builtin member call.

struct Stack<T> {
  items: [T]
}

impl Stack<T> {
  fun add(value: T) {
    this.items.push(value);
  }

  fun take(): T? {
    if (this.items.len() == 0) {
      return nil;
    }
    return this.items.pop();
  }

  fun top(): T? {
    if (this.items.len() == 0) {
      return nil;
    }
    return this.items[this.items.len() - 1];
  }

  fun size(): number {
    return this.items.len();
  }

  fun isEmpty(): bool {
    return this.items.len() == 0;
  }

  fun snapshot(): [T] {
    return copy(this.items);
  }
}

fun newStack<T>(): Stack<T> {
  return Stack<T> { items: [] };
}

struct Queue<T> {
  items: [T],
  head: number
}

impl Queue<T> {
  fun enqueue(value: T) {
    this.items.push(value);
  }

  // Keep consumed entries only until the unread suffix is at least half of
  // the backing array. This keeps dequeue amortized while retaining a simple
  // array-backed implementation.
  fun compact() {
    if (this.head > 0 && this.head * 2 >= this.items.len()) {
      this.items = this.items.slice(this.head, this.items.len() - this.head);
      this.head = 0;
    }
  }

  fun dequeue(): T? {
    if (this.head >= this.items.len()) {
      return nil;
    }

    let value = this.items[this.head];
    this.head += 1;
    this.compact();
    return value;
  }

  fun front(): T? {
    if (this.head >= this.items.len()) {
      return nil;
    }
    return this.items[this.head];
  }

  fun size(): number {
    return this.items.len() - this.head;
  }

  fun isEmpty(): bool {
    return this.head >= this.items.len();
  }

  fun snapshot(): [T] {
    return this.items.slice(this.head, this.items.len() - this.head);
  }
}

fun newQueue<T>(): Queue<T> {
  return Queue<T> { items: [], head: 0 };
}

// A deque stores the front half in reverse order and the back half in forward
// order. Moving one side to the other happens only when that side is empty,
// so each element moves at most once between transfers.
struct Deque<T> {
  frontItems: [T],
  backItems: [T]
}

impl Deque<T> {
  fun addFront(value: T) {
    this.frontItems.push(value);
  }

  fun addBack(value: T) {
    this.backItems.push(value);
  }

  fun shiftBackToFront() {
    while (this.backItems.len() > 0) {
      this.frontItems.push(this.backItems.pop());
    }
  }

  fun shiftFrontToBack() {
    while (this.frontItems.len() > 0) {
      this.backItems.push(this.frontItems.pop());
    }
  }

  fun takeFront(): T? {
    if (this.frontItems.len() == 0) {
      if (this.backItems.len() == 0) {
        return nil;
      }
      this.shiftBackToFront();
    }
    return this.frontItems.pop();
  }

  fun takeBack(): T? {
    if (this.backItems.len() == 0) {
      if (this.frontItems.len() == 0) {
        return nil;
      }
      this.shiftFrontToBack();
    }
    return this.backItems.pop();
  }

  fun peekFront(): T? {
    if (this.frontItems.len() == 0) {
      if (this.backItems.len() == 0) {
        return nil;
      }
      this.shiftBackToFront();
    }
    return this.frontItems[this.frontItems.len() - 1];
  }

  fun peekBack(): T? {
    if (this.backItems.len() == 0) {
      if (this.frontItems.len() == 0) {
        return nil;
      }
      this.shiftFrontToBack();
    }
    return this.backItems[this.backItems.len() - 1];
  }

  fun size(): number {
    return this.frontItems.len() + this.backItems.len();
  }

  fun isEmpty(): bool {
    return this.frontItems.len() == 0 && this.backItems.len() == 0;
  }

  fun snapshot(): [T] {
    let values: [T] = [];
    let frontIndex = this.frontItems.len();
    while (frontIndex > 0) {
      frontIndex -= 1;
      values.push(this.frontItems[frontIndex]);
    }

    let backIndex = 0;
    while (backIndex < this.backItems.len()) {
      values.push(this.backItems[backIndex]);
      backIndex += 1;
    }
    return values;
  }
}

fun newDeque<T>(): Deque<T> {
  return Deque<T> { frontItems: [], backItems: [] };
}

struct BinaryHeap<T> {
  items: [T],
  less: fun(T, T): bool
}

impl BinaryHeap<T> {
  fun comesBefore(left: T, right: T): bool {
    let compare = this.less;
    return compare(left, right);
  }

  fun swapItems(left: number, right: number) {
    let value = this.items[left];
    this.items[left] = this.items[right];
    this.items[right] = value;
  }

  fun siftUp() {
    let child = this.items.len() - 1;
    while (child > 0) {
      let parent = floor((child - 1) / 2);
      if (!this.comesBefore(this.items[child], this.items[parent])) {
        break;
      }
      this.swapItems(child, parent);
      child = parent;
    }
  }

  fun siftDown() {
    let index = 0;
    let length = this.items.len();
    while (true) {
      let left = index * 2 + 1;
      if (left >= length) {
        break;
      }

      let right = left + 1;
      let candidate = left;
      if (right < length && this.comesBefore(this.items[right], this.items[left])) {
        candidate = right;
      }
      if (!this.comesBefore(this.items[candidate], this.items[index])) {
        break;
      }
      this.swapItems(index, candidate);
      index = candidate;
    }
  }

  fun add(value: T) {
    this.items.push(value);
    this.siftUp();
  }

  fun peek(): T? {
    if (this.items.len() == 0) {
      return nil;
    }
    return this.items[0];
  }

  fun take(): T? {
    if (this.items.len() == 0) {
      return nil;
    }

    let value = this.items[0];
    let last = this.items.pop();
    if (this.items.len() > 0) {
      this.items[0] = last;
      this.siftDown();
    }
    return value;
  }

  fun size(): number {
    return this.items.len();
  }

  fun isEmpty(): bool {
    return this.items.len() == 0;
  }

  fun snapshot(): [T] {
    return copy(this.items);
  }
}

fun newBinaryHeap<T>(less: fun(T, T): bool): BinaryHeap<T> {
  return BinaryHeap<T> { items: [], less: less };
}

enum Option<T> {
  Some(value: T),
  None,
}

fun some<T>(value: T): Option<T> {
  return Option.Some(value);
}

fun none<T>(): Option<T> {
  return Option.None<T>();
}

enum Result<T, E> {
  Ok(value: T),
  Err(error: E),
}

fun ok<T, E>(value: T): Result<T, E> {
  return Result.Ok(value);
}

fun err<T, E>(error: E): Result<T, E> {
  return Result.Err(error);
}

enum List<T> {
  Nil,
  Cons(head: T, tail: List<T>),
}

fun emptyList<T>(): List<T> {
  return List.Nil<T>();
}

fun prepend<T>(value: T, list: List<T>): List<T> {
  return List.Cons(value, list);
}

fun head<T>(list: List<T>): T? {
  match list {
    List.Nil => { return nil; }
    List.Cons(value, rest) => { return value; }
  }
}

fun tail<T>(list: List<T>): List<T>? {
  match list {
    List.Nil => { return nil; }
    List.Cons(value, rest) => { return rest; }
  }
}

fun reverseInto<T>(remaining: List<T>, result: List<T>): List<T> {
  return match remaining {
    List.Nil => result,
    List.Cons(value, rest) => reverseInto(rest, List.Cons(value, result)),
  };
}

fun reverse<T>(list: List<T>): List<T> {
  return reverseInto(list, List.Nil<T>());
}

fun appendListToArray<T>(list: List<T>, values: [T]) {
  match list {
    List.Nil => { }
    List.Cons(value, rest) => {
      values.push(value);
      appendListToArray(rest, values);
    }
  }
}

fun toArray<T>(list: List<T>): [T] {
  let values: [T] = [];
  appendListToArray(list, values);
  return values;
}

struct Set<T> {
  items: [T]
}

impl Set<T> {
  fun indexOf(value: T): number {
    let index = 0;
    while (index < this.items.len()) {
      if (this.items[index] == value) {
        return index;
      }
      index += 1;
    }
    return -1;
  }

  fun add(value: T) {
    if (this.indexOf(value) >= 0) {
      return;
    }
    this.items.push(value);
  }

  fun has(value: T): bool {
    return this.indexOf(value) >= 0;
  }

  fun discard(value: T): bool {
    let index = this.indexOf(value);
    if (index < 0) {
      return false;
    }

    while (index + 1 < this.items.len()) {
      this.items[index] = this.items[index + 1];
      index += 1;
    }
    this.items.pop();
    return true;
  }

  fun size(): number {
    return this.items.len();
  }

  fun isEmpty(): bool {
    return this.items.len() == 0;
  }

  fun snapshot(): [T] {
    return copy(this.items);
  }
}

fun newSet<T>(): Set<T> {
  return Set<T> { items: [] };
}

struct MultiSetEntry<T> {
  value: T,
  count: number
}

struct MultiSet<T> {
  values: [T],
  counts: [number]
}

impl MultiSet<T> {
  fun indexOf(value: T): number {
    let index = 0;
    while (index < this.values.len()) {
      if (this.values[index] == value) {
        return index;
      }
      index += 1;
    }
    return -1;
  }

  fun add(value: T) {
    let index = this.indexOf(value);
    if (index >= 0) {
      this.counts[index] += 1;
      return;
    }
    this.values.push(value);
    this.counts.push(1);
  }

  fun countOf(value: T): number {
    let index = this.indexOf(value);
    if (index < 0) {
      return 0;
    }
    return this.counts[index];
  }

  fun has(value: T): bool {
    return this.indexOf(value) >= 0;
  }

  fun removeAt(index: number) {
    while (index + 1 < this.values.len()) {
      this.values[index] = this.values[index + 1];
      this.counts[index] = this.counts[index + 1];
      index += 1;
    }
    this.values.pop();
    this.counts.pop();
  }

  fun takeOne(value: T): bool {
    let index = this.indexOf(value);
    if (index < 0) {
      return false;
    }
    if (this.counts[index] > 1) {
      this.counts[index] -= 1;
      return true;
    }
    this.removeAt(index);
    return true;
  }

  fun entries(): [MultiSetEntry<T>] {
    let result: [MultiSetEntry<T>] = [];
    let index = 0;
    while (index < this.values.len()) {
      result.push(MultiSetEntry<T> { value: this.values[index], count: this.counts[index] });
      index += 1;
    }
    return result;
  }
}

fun newMultiSet<T>(): MultiSet<T> {
  return MultiSet<T> { values: [], counts: [] };
}

struct MultiMap<K, V> {
  keys: [K],
  values: [[V]]
}

impl MultiMap<K, V> {
  fun indexOfKey(key: K): number {
    let index = 0;
    while (index < this.keys.len()) {
      if (this.keys[index] == key) {
        return index;
      }
      index += 1;
    }
    return -1;
  }

  fun indexOfValue(values: [V], value: V): number {
    let index = 0;
    while (index < values.len()) {
      if (values[index] == value) {
        return index;
      }
      index += 1;
    }
    return -1;
  }

  fun add(key: K, value: V) {
    let keyIndex = this.indexOfKey(key);
    if (keyIndex < 0) {
      let values: [V] = [];
      values.push(value);
      this.keys.push(key);
      this.values.push(values);
      return;
    }
    this.values[keyIndex].push(value);
  }

  fun getAll(key: K): [V] {
    let keyIndex = this.indexOfKey(key);
    if (keyIndex < 0) {
      return [];
    }
    return copy(this.values[keyIndex]);
  }

  fun removeKeyAt(index: number) {
    while (index + 1 < this.keys.len()) {
      this.keys[index] = this.keys[index + 1];
      this.values[index] = this.values[index + 1];
      index += 1;
    }
    this.keys.pop();
    this.values.pop();
  }

  fun discard(key: K, value: V): bool {
    let keyIndex = this.indexOfKey(key);
    if (keyIndex < 0) {
      return false;
    }
    let valueIndex = this.indexOfValue(this.values[keyIndex], value);
    if (valueIndex < 0) {
      return false;
    }

    while (valueIndex + 1 < this.values[keyIndex].len()) {
      this.values[keyIndex][valueIndex] = this.values[keyIndex][valueIndex + 1];
      valueIndex += 1;
    }
    this.values[keyIndex].pop();
    if (this.values[keyIndex].len() == 0) {
      this.removeKeyAt(keyIndex);
    }
    return true;
  }
}

fun newMultiMap<K, V>(): MultiMap<K, V> {
  return MultiMap<K, V> { keys: [], values: [] };
}

fun reverseArray<T>(values: [T]): [T] {
  let result: [T] = [];
  let index = values.len();
  while (index > 0) {
    index -= 1;
    result.push(values[index]);
  }
  return result;
}

fun linearSearch<T>(values: [T], target: T): number {
  let index = 0;
  while (index < values.len()) {
    if (values[index] == target) {
      return index;
    }
    index += 1;
  }
  return -1;
}

fun countValue<T>(values: [T], target: T): number {
  let count = 0;
  let index = 0;
  while (index < values.len()) {
    if (values[index] == target) {
      count += 1;
    }
    index += 1;
  }
  return count;
}

fun sortArrayInPlace<T>(values: [T], less: fun(T, T): bool) {
  let index = 1;
  while (index < values.len()) {
    let value = values[index];
    let position = index;
    while (position > 0 && less(value, values[position - 1])) {
      values[position] = values[position - 1];
      position -= 1;
    }
    values[position] = value;
    index += 1;
  }
}

fun sortArray<T>(values: [T], less: fun(T, T): bool): [T] {
  let result = copy(values);
  sortArrayInPlace(result, less);
  return result;
}

fun chunkArray<T>(values: [T], size: number): [[T]] {
  let result: [[T]] = [];
  if (size <= 0) {
    return result;
  }

  let start = 0;
  while (start < values.len()) {
    let end = start + size;
    if (end > values.len()) {
      end = values.len();
    }
    let chunk: [T] = [];
    let index = start;
    while (index < end) {
      chunk.push(values[index]);
      index += 1;
    }
    result.push(chunk);
    start = end;
  }
  return result;
}

fun slidingWindows<T>(values: [T], width: number): [[T]] {
  let result: [[T]] = [];
  if (width <= 0 || width > values.len()) {
    return result;
  }

  let start = 0;
  while (start + width <= values.len()) {
    let window: [T] = [];
    let index = start;
    while (index < start + width) {
      window.push(values[index]);
      index += 1;
    }
    result.push(window);
    start += 1;
  }
  return result;
}

fun prefixSums(values: [number]): [number] {
  let result: [number] = [];
  let sum = 0;
  let index = 0;
  while (index < values.len()) {
    sum += values[index];
    result.push(sum);
    index += 1;
  }
  return result;
}

struct Interval {
  start: number,
  end: number
}

fun intervalLess(left: Interval, right: Interval): bool {
  if (left.start == right.start) {
    return left.end < right.end;
  }
  return left.start < right.start;
}

fun mergeIntervals(intervals: [Interval]): [Interval] {
  let ordered = sortArray(intervals, intervalLess);
  let merged: [Interval] = [];
  let index = 0;
  while (index < ordered.len()) {
    let current = ordered[index];
    if (merged.len() == 0 || current.start > merged[merged.len() - 1].end) {
      merged.push(Interval { start: current.start, end: current.end });
    } else {
      if (current.end > merged[merged.len() - 1].end) {
        merged[merged.len() - 1].end = current.end;
      }
    }
    index += 1;
  }
  return merged;
}

fun mergeSortedNumbers(left: [number], right: [number]): [number] {
  let result: [number] = [];
  let leftIndex = 0;
  let rightIndex = 0;
  while (leftIndex < left.len() && rightIndex < right.len()) {
    if (left[leftIndex] <= right[rightIndex]) {
      result.push(left[leftIndex]);
      leftIndex += 1;
    } else {
      result.push(right[rightIndex]);
      rightIndex += 1;
    }
  }
  while (leftIndex < left.len()) {
    result.push(left[leftIndex]);
    leftIndex += 1;
  }
  while (rightIndex < right.len()) {
    result.push(right[rightIndex]);
    rightIndex += 1;
  }
  return result;
}

fun twoSumSorted(values: [number], target: number): [number] {
  let result: [number] = [];
  let left = 0;
  let right = values.len() - 1;
  while (left < right) {
    let sum = values[left] + values[right];
    if (sum == target) {
      result.push(left);
      result.push(right);
      return result;
    }
    if (sum < target) {
      left += 1;
    } else {
      right -= 1;
    }
  }
  return result;
}

fun uniqueValues<T>(values: [T]): [T] {
  let result: [T] = [];
  let index = 0;
  while (index < values.len()) {
    if (linearSearch(result, values[index]) < 0) {
      result.push(values[index]);
    }
    index += 1;
  }
  return result;
}

fun intersectionValues<T>(left: [T], right: [T]): [T] {
  let result: [T] = [];
  let index = 0;
  while (index < left.len()) {
    let value = left[index];
    if (linearSearch(right, value) >= 0 && linearSearch(result, value) < 0) {
      result.push(value);
    }
    index += 1;
  }
  return result;
}

fun unionValues<T>(left: [T], right: [T]): [T] {
  let result = uniqueValues(left);
  let index = 0;
  while (index < right.len()) {
    if (linearSearch(result, right[index]) < 0) {
      result.push(right[index]);
    }
    index += 1;
  }
  return result;
}

fun differenceValues<T>(left: [T], right: [T]): [T] {
  let result: [T] = [];
  let index = 0;
  while (index < left.len()) {
    let value = left[index];
    if (linearSearch(right, value) < 0 && linearSearch(result, value) < 0) {
      result.push(value);
    }
    index += 1;
  }
  return result;
}

fun windowSums(values: [number], width: number): [number] {
  let result: [number] = [];
  if (width <= 0 || width > values.len()) {
    return result;
  }

  let sum = 0;
  let index = 0;
  while (index < width) {
    sum += values[index];
    index += 1;
  }
  result.push(sum);

  let start = width;
  while (start < values.len()) {
    sum += values[start];
    sum -= values[start - width];
    result.push(sum);
    start += 1;
  }
  return result;
}

fun maxWindowSum(values: [number], width: number): number? {
  let sums = windowSums(values, width);
  if (sums.len() == 0) {
    return nil;
  }

  let best = sums[0];
  let index = 1;
  while (index < sums.len()) {
    if (sums[index] > best) {
      best = sums[index];
    }
    index += 1;
  }
  return best;
}

struct PriorityQueue<T> {
  heap: BinaryHeap<T>
}

impl PriorityQueue<T> {
  fun enqueue(value: T) {
    this.heap.add(value);
  }

  fun dequeue(): T? {
    return this.heap.take();
  }

  fun front(): T? {
    return this.heap.peek();
  }

  fun size(): number {
    return this.heap.size();
  }

  fun isEmpty(): bool {
    return this.heap.isEmpty();
  }

  fun snapshot(): [T] {
    return this.heap.snapshot();
  }
}

fun newPriorityQueue<T>(less: fun(T, T): bool): PriorityQueue<T> {
  return PriorityQueue<T> { heap: newBinaryHeap<T>(less) };
}

export Stack, Queue, Deque, BinaryHeap, PriorityQueue, Option, Result, List, Set, MultiSetEntry, MultiSet, MultiMap, Interval, newStack, newQueue, newDeque, newBinaryHeap, newPriorityQueue, some, none, ok, err, emptyList, prepend, head, tail, reverse, toArray, newSet, newMultiSet, newMultiMap, reverseArray, linearSearch, countValue, sortArray, sortArrayInPlace, chunkArray, slidingWindows, prefixSums, mergeIntervals, mergeSortedNumbers, twoSumSorted, uniqueValues, intersectionValues, unionValues, differenceValues, windowSums, maxWindowSum;
