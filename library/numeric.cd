// Number-theory, arithmetic, priority-queue, and running-median helpers.
import "./collections.cd";
import "./strings.cd";

fun gcd(left: number, right: number): number {
  let mut a = left;
  if (a < 0) {
    a = -a;
  }
  let mut b = right;
  if (b < 0) {
    b = -b;
  }
  while (b != 0) {
    let quotient = floor(a / b);
    let mut remainder = a - quotient * b;
    a = b;
    b = remainder;
  }
  return a;
}

fun lcm(left: number, right: number): number {
  if (left == 0 || right == 0) {
    return 0;
  }
  let mut leftMagnitude = left;
  if (leftMagnitude < 0) {
    leftMagnitude = -leftMagnitude;
  }
  let mut rightMagnitude = right;
  if (rightMagnitude < 0) {
    rightMagnitude = -rightMagnitude;
  }
  return (leftMagnitude / gcd(leftMagnitude, rightMagnitude)) * rightMagnitude;
}

struct ExtendedGcdResult {
  gcd: number,
  leftCoefficient: number,
  rightCoefficient: number
}

fun extendedGcd(left: number, right: number): ExtendedGcdResult {
  if (left == 0 && right == 0) {
    return ExtendedGcdResult { gcd: 0, leftCoefficient: 0, rightCoefficient: 0 };
  }
  let mut oldR = left;
  if (oldR < 0) {
    oldR = -oldR;
  }
  let mut remainder = right;
  if (remainder < 0) {
    remainder = -remainder;
  }
  let mut oldS = 1;
  let mut coefficientS = 0;
  let mut oldT = 0;
  let mut coefficientT = 1;
  while (remainder != 0) {
    let quotient = floor(oldR / remainder);
    let mut next = oldR - quotient * remainder;
    oldR = remainder;
    remainder = next;

    next = oldS - quotient * coefficientS;
    oldS = coefficientS;
    coefficientS = next;

    next = oldT - quotient * coefficientT;
    oldT = coefficientT;
    coefficientT = next;
  }
  if (left < 0) {
    oldS = -oldS;
  }
  if (right < 0) {
    oldT = -oldT;
  }
  return ExtendedGcdResult {
    gcd: oldR,
    leftCoefficient: oldS,
    rightCoefficient: oldT
  };
}

fun isPrime(value: number): bool {
  if (value < 2 || floor(value) != value) {
    return false;
  }
  if (value == 2) {
    return true;
  }
  if (floor(value / 2) * 2 == value) {
    return false;
  }
  let mut divisor = 3;
  while (divisor <= value / divisor) {
    if (floor(value / divisor) * divisor == value) {
      return false;
    }
    divisor += 2;
  }
  return true;
}

fun sievePrimes(limit: number): [number] {
  let primes: [number] = [];
  let bound = floor(limit);
  if (bound < 2) {
    return primes;
  }
  let composite: [bool] = [];
  let mut index = 0;
  while (index <= bound) {
    composite.push(false);
    index += 1;
  }

  let mut candidate = 2;
  while (candidate <= bound / candidate) {
    if (!composite[candidate]) {
      let mut multiple = candidate * candidate;
      while (multiple <= bound) {
        composite[multiple] = true;
        multiple += candidate;
      }
    }
    candidate += 1;
  }

  index = 2;
  while (index <= bound) {
    if (!composite[index]) {
      primes.push(index);
    }
    index += 1;
  }
  return primes;
}

fun fastPower(base: number, exponent: number): optional<number> {
  if (exponent < 0 || floor(exponent) != exponent) {
    return nil;
  }
  let mut result = 1;
  let mut factor = base;
  let mut remaining = exponent;
  while (remaining > 0) {
    if (floor(remaining / 2) * 2 != remaining) {
      result *= factor;
    }
    factor *= factor;
    remaining = floor(remaining / 2);
  }
  return result;
}

fun factorial(value: number): optional<number> {
  if (value < 0 || floor(value) != value) {
    return nil;
  }
  let mut result = 1;
  let mut current = 2;
  while (current <= value) {
    result *= current;
    current += 1;
  }
  return result;
}

struct FibonacciPair {
  current: number,
  next: number
}

fun fibonacciPair(index: number): FibonacciPair {
  if (index == 0) {
    return FibonacciPair { current: 0, next: 1 };
  }

  let half = fibonacciPair(floor(index / 2));
  let doubled = half.current * (2 * half.next - half.current);
  let doubledNext = half.current * half.current + half.next * half.next;
  if (floor(index / 2) * 2 == index) {
    return FibonacciPair { current: doubled, next: doubledNext };
  }
  return FibonacciPair { current: doubledNext, next: doubled + doubledNext };
}

fun fibonacci(index: number): optional<number> {
  if (index < 0 || floor(index) != index) {
    return nil;
  }
  return fibonacciPair(index).current;
}

struct PriorityQueue<T> {
  heap: BinaryHeap<T>
}

impl PriorityQueue<T> {
  fun enqueue(value: T) {
    this.heap.add(value);
  }

  fun dequeue(): optional<T> {
    return this.heap.take();
  }

  fun front(): optional<T> {
    return this.heap.peek();
  }

  fun size(): number {
    return this.heap.size();
  }

  fun isEmpty(): bool {
    return this.heap.isEmpty();
  }

  fun snapshot(): [T] {
    return this.heap.snapshot();
  }
}

fun newPriorityQueue<T>(less: fun(T, T): bool): PriorityQueue<T> {
  return PriorityQueue<T> { heap: newBinaryHeap<T>(less) };
}

fun medianLowerLess(left: number, right: number): bool {
  return left > right;
}

fun medianUpperLess(left: number, right: number): bool {
  return left < right;
}

struct MedianHeap {
  private lower: BinaryHeap<number>,
  private upper: BinaryHeap<number>
}

impl MedianHeap {
  fun rebalance() {
    if (this.lower.size() > this.upper.size() + 1) {
      match this.lower.take() {
        nil => { }
        value => {
          this.upper.add(value);
        }
      }
    }
    if (this.upper.size() > this.lower.size()) {
      match this.upper.take() {
        nil => { }
        value => {
          this.lower.add(value);
        }
      }
    }
  }

  fun add(value: number) {
    if (this.lower.isEmpty()) {
      this.lower.add(value);
    } else {
      match this.lower.peek() {
        nil => { this.lower.add(value); }
        boundary => {
        if (value <= boundary) {
          this.lower.add(value);
        } else {
          this.upper.add(value);
        }
        }
      }
    }
    this.rebalance();
  }

  fun median(): optional<number> {
    if (this.isEmpty()) {
      return nil;
    }
    if (this.lower.size() > this.upper.size()) {
      return this.lower.peek();
    }

    let lowerNumber = this.lower.peek()?;
    let upperValue = this.upper.peek()?;
    return (lowerNumber + upperValue) / 2;
  }

  fun size(): number {
    return this.lower.size() + this.upper.size();
  }

  fun isEmpty(): bool {
    return this.size() == 0;
  }
}

fun newMedianHeap(): MedianHeap {
  return MedianHeap {
    lower: newBinaryHeap<number>(medianLowerLess),
    upper: newBinaryHeap<number>(medianUpperLess)
  };
}

fun gcdArray(values: [number]): optional<number> {
  if (values.len() == 0) {
    return nil;
  }
  let mut result = 0;
  let mut index = 0;
  while (index < values.len()) {
    if (floor(values[index]) != values[index]) {
      return nil;
    }
    result = gcd(result, values[index]);
    index += 1;
  }
  return result;
}

fun prefixProducts(values: [number]): [number] {
  let mut result: [number] = [];
  let mut product = 1;
  let mut index = 0;
  while (index < values.len()) {
    product *= values[index];
    result.push(product);
    index += 1;
  }
  return result;
}

fun minimumLargestPartitionSum(values: [number], parts: number): optional<number> {
  if (floor(parts) != parts || parts <= 0) {
    return nil;
  }
  if (values.len() == 0) {
    return 0;
  }

  let mut low = 0;
  let mut high = 0;
  let mut index = 0;
  while (index < values.len()) {
    let value = values[index];
    if (floor(value) != value || value < 0) {
      return nil;
    }
    if (value > low) {
      low = value;
    }
    high += value;
    index += 1;
  }

  while (low < high) {
    let capacity = floor((low + high) / 2);
    let mut required = 1;
    let mut current = 0;
    index = 0;
    while (index < values.len()) {
      if (current + values[index] <= capacity) {
        current += values[index];
      } else {
        required += 1;
        current = values[index];
      }
      index += 1;
    }
    if (required <= parts) {
      high = capacity;
    } else {
      low = capacity + 1;
    }
  }
  return low;
}

fun binomialCoefficient(n: number, k: number): optional<number> {
  if (floor(n) != n || floor(k) != k || n < 0 || k < 0 || k > n) {
    return nil;
  }
  let mut effective = k;
  if (effective > n - effective) {
    effective = n - effective;
  }
  let coefficients: [number] = [1];
  let mut index = 1;
  while (index <= effective) {
    coefficients.push(0);
    index += 1;
  }
  let mut row = 1;
  while (row <= n) {
    index = row;
    if (index > effective) {
      index = effective;
    }
    while (index > 0) {
      coefficients[index] += coefficients[index - 1];
      index -= 1;
    }
    row += 1;
  }
  return coefficients[effective];
}

fun permutationCount(n: number, k: number): optional<number> {
  if (floor(n) != n || floor(k) != k || n < 0 || k < 0 || k > n) {
    return nil;
  }
  let mut result = 1;
  let mut step = 0;
  while (step < k) {
    result *= n - step;
    step += 1;
  }
  return result;
}

fun pascalTriangle(rows: number): [[number]] {
  let result: [[number]] = [];
  if (floor(rows) != rows || rows < 0) {
    return result;
  }
  let mut previous: [number] = [];
  let mut rowIndex = 0;
  while (rowIndex < rows) {
    let current: [number] = [];
    let mut column = 0;
    while (column <= rowIndex) {
      if (column == 0 || column == rowIndex) {
        current.push(1);
      } else {
        current.push(previous[column - 1] + previous[column]);
      }
      column += 1;
    }
    result.push(current);
    previous = current;
    rowIndex += 1;
  }
  return result;
}

fun primeFactors(value: number): [number] {
  let result: [number] = [];
  if (value < 2 || floor(value) != value) {
    return result;
  }
  let mut remaining = value;
  let mut factor = 2;
  while (factor <= remaining / factor) {
    while (floor(remaining / factor) * factor == remaining) {
      result.push(factor);
      remaining = floor(remaining / factor);
    }
    if (factor == 2) {
      factor = 3;
    } else {
      factor += 2;
    }
  }
  if (remaining > 1) {
    result.push(remaining);
  }
  return result;
}

fun divisors(value: number): [number] {
  let result: [number] = [];
  if (value < 1 || floor(value) != value) {
    return result;
  }
  let large: [number] = [];
  let mut divisor = 1;
  while (divisor <= value / divisor) {
    if (floor(value / divisor) * divisor == value) {
      result.push(divisor);
      let paired = floor(value / divisor);
      if (paired != divisor) {
        large.push(paired);
      }
    }
    divisor += 1;
  }
  let reversed = reverseArray(large);
  let mut index = 0;
  while (index < reversed.len()) {
    result.push(reversed[index]);
    index += 1;
  }
  return result;
}

export PriorityQueue, newPriorityQueue, MedianHeap, newMedianHeap, ExtendedGcdResult, gcd, lcm, extendedGcd, isPrime, sievePrimes, fastPower, factorial, fibonacci, primeFactors, divisors, binomialCoefficient, permutationCount, pascalTriangle, gcdArray, prefixProducts, minimumLargestPartitionSum;
