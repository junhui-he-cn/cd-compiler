// Array and string sequence algorithms, including the trie.
import "./sets.cd";

fun reverseArray<T>(values: [T]): [T] {
  let result: [T] = [];
  let index = values.len();
  while (index > 0) {
    index -= 1;
    result.push(values[index]);
  }
  return result;
}

fun rotateArray<T>(values: [T], shift: number): [T] {
  let result: [T] = [];
  let length = values.len();
  if (length == 0) {
    return result;
  }

  let offset = floor(shift);
  let turns = floor(offset / length);
  offset -= turns * length;
  if (offset < 0) {
    offset += length;
  }

  let index = 0;
  while (index < length) {
    let source = index - offset;
    if (source < 0) {
      source += length;
    }
    result.push(values[source]);
    index += 1;
  }
  return result;
}

fun linearSearch<T: Eq>(values: [T], target: T): number {
  let index = 0;
  while (index < values.len()) {
    if (values[index] == target) {
      return index;
    }
    index += 1;
  }
  return -1;
}

fun asciiCharacterRank(character: string): number {
  let alphabet = " !#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
  let index = 0;
  while (index < alphabet.len()) {
    if (alphabet.charAt(index) == character) {
      return index;
    }
    index += 1;
  }
  return -1;
}

fun compareStrings(left: string, right: string): optional<number> {
  let leftLength = left.len();
  let rightLength = right.len();
  let limit = leftLength;
  if (rightLength < limit) {
    limit = rightLength;
  }

  let index = 0;
  while (index < limit) {
    let leftCharacter = left.charAt(index);
    let rightCharacter = right.charAt(index);
    let leftRank = asciiCharacterRank(leftCharacter);
    let rightRank = asciiCharacterRank(rightCharacter);
    if (leftRank < 0 || rightRank < 0) {
      return nil;
    }
    if (leftRank < rightRank) {
      return -1;
    }
    if (leftRank > rightRank) {
      return 1;
    }
    index += 1;
  }

  if (leftLength < rightLength) {
    return -1;
  }
  if (leftLength > rightLength) {
    return 1;
  }
  return 0;
}

fun stringLess(left: string, right: string): bool {
  let comparison = compareStrings(left, right);
  if (comparison == nil) {
    return false;
  }
  return comparison < 0;
}

fun findSubstring(text: string, pattern: string): number {
  if (pattern.len() == 0) {
    return 0;
  }
  if (pattern.len() > text.len()) {
    return -1;
  }
  let start = 0;
  while (start <= text.len() - pattern.len()) {
    let offset = 0;
    while (offset < pattern.len()
        && text.charAt(start + offset) == pattern.charAt(offset)) {
      offset += 1;
    }
    if (offset == pattern.len()) {
      return start;
    }
    start += 1;
  }
  return -1;
}

fun prefixFunction(pattern: string): [number] {
  let prefix: [number] = [];
  let index = 0;
  while (index < pattern.len()) {
    prefix.push(0);
    index += 1;
  }
  let matched = 0;
  index = 1;
  while (index < pattern.len()) {
    while (matched > 0 && pattern.charAt(index) != pattern.charAt(matched)) {
      matched = prefix[matched - 1];
    }
    if (pattern.charAt(index) == pattern.charAt(matched)) {
      matched += 1;
    }
    prefix[index] = matched;
    index += 1;
  }
  return prefix;
}

fun zFunction(text: string): [number] {
  let z: [number] = [];
  let index = 0;
  while (index < text.len()) {
    z.push(0);
    index += 1;
  }
  if (text.len() == 0) {
    return z;
  }
  z[0] = text.len();
  let left = 0;
  let right = 0;
  index = 1;
  while (index < text.len()) {
    if (index <= right) {
      let mirror = index - left;
      z[index] = z[mirror];
      if (z[index] > right - index + 1) {
        z[index] = right - index + 1;
      }
    }
    while (index + z[index] < text.len()
        && text.charAt(z[index]) == text.charAt(index + z[index])) {
      z[index] += 1;
    }
    if (index + z[index] - 1 > right) {
      left = index;
      right = index + z[index] - 1;
    }
    index += 1;
  }
  return z;
}

fun kmpSearch(text: string, pattern: string): number {
  if (pattern.len() == 0) {
    return 0;
  }
  let prefix = prefixFunction(pattern);
  let textIndex = 0;
  let patternIndex = 0;
  while (textIndex < text.len()) {
    if (text.charAt(textIndex) == pattern.charAt(patternIndex)) {
      textIndex += 1;
      patternIndex += 1;
      if (patternIndex == pattern.len()) {
        return textIndex - patternIndex;
      }
    } else {
      if (patternIndex > 0) {
        patternIndex = prefix[patternIndex - 1];
      } else {
        textIndex += 1;
      }
    }
  }
  return -1;
}

fun isPalindrome(text: string): bool {
  let left = 0;
  let right = text.len() - 1;
  while (left < right) {
    if (text.charAt(left) != text.charAt(right)) {
      return false;
    }
    left += 1;
    right -= 1;
  }
  return true;
}

fun characterFrequency(text: string): [MultiSetEntry<string>] {
  let counts: map<string, number> = {};
  let index = 0;
  while (index < text.len()) {
    let character = text.charAt(index);
    if (counts.contains(character)) {
      counts[character] = counts[character] + 1;
    } else {
      counts[character] = 1;
    }
    index += 1;
  }

  let result: [MultiSetEntry<string>] = [];
  let keys = counts.keys();
  index = 0;
  while (index < keys.len()) {
    let character = keys[index];
    result.push(MultiSetEntry<string> {
      value: character,
      count: counts[character]
    });
    index += 1;
  }
  return result;
}

fun areAnagrams(left: string, right: string): bool {
  if (left.len() != right.len()) {
    return false;
  }

  let leftCounts: map<string, number> = {};
  let rightCounts: map<string, number> = {};
  let index = 0;
  while (index < left.len()) {
    let leftCharacter = left.charAt(index);
    if (leftCounts.contains(leftCharacter)) {
      leftCounts[leftCharacter] = leftCounts[leftCharacter] + 1;
    } else {
      leftCounts[leftCharacter] = 1;
    }

    let rightCharacter = right.charAt(index);
    if (rightCounts.contains(rightCharacter)) {
      rightCounts[rightCharacter] = rightCounts[rightCharacter] + 1;
    } else {
      rightCounts[rightCharacter] = 1;
    }
    index += 1;
  }

  let keys = leftCounts.keys();
  index = 0;
  while (index < keys.len()) {
    let character = keys[index];
    if (!rightCounts.contains(character) || leftCounts[character] != rightCounts[character]) {
      return false;
    }
    index += 1;
  }
  return true;
}

// Return the shortest contiguous text span containing every pattern character
// with at least the pattern's multiplicity. Primitive string keys make the
// sliding window independent from the library's deferred generic hash-map API.
fun minimumWindowSubstring(text: string, pattern: string): string {
  if (pattern.len() == 0 || text.len() == 0 || pattern.len() > text.len()) {
    return "";
  }

  let required: map<string, number> = {};
  let patternIndex = 0;
  while (patternIndex < pattern.len()) {
    let character = pattern.charAt(patternIndex);
    if (required.contains(character)) {
      required[character] = required[character] + 1;
    } else {
      required[character] = 1;
    }
    patternIndex += 1;
  }

  let window: map<string, number> = {};
  let missing = pattern.len();
  let left = 0;
  let right = 0;
  let bestStart = 0;
  let bestLength = text.len() + 1;
  while (right < text.len()) {
    let entering = text.charAt(right);
    if (required.contains(entering)) {
      let before = 0;
      if (window.contains(entering)) {
        before = window[entering];
      }
      window[entering] = before + 1;
      if (before < required[entering]) {
        missing -= 1;
      }
    }
    right += 1;

    while (missing == 0) {
      let length = right - left;
      if (length < bestLength) {
        bestStart = left;
        bestLength = length;
      }

      let leaving = text.charAt(left);
      if (required.contains(leaving)) {
        let before = window[leaving];
        window[leaving] = before - 1;
        if (before <= required[leaving]) {
          missing += 1;
        }
      }
      left += 1;
    }
  }

  if (bestLength > text.len()) {
    return "";
  }
  return text.substr(bestStart, bestLength);
}

fun canSegmentString(text: string, dictionary: [string]): bool {
  let reachable: [bool] = [];
  let index = 0;
  while (index <= text.len()) {
    reachable.push(false);
    index += 1;
  }
  reachable[0] = true;

  let end = 1;
  while (end <= text.len()) {
    let wordIndex = 0;
    while (wordIndex < dictionary.len()) {
      let word = dictionary[wordIndex];
      if (word.len() > 0 && word.len() <= end
          && reachable[end - word.len()]
          && text.substr(end - word.len(), word.len()) == word) {
        reachable[end] = true;
        break;
      }
      wordIndex += 1;
    }
    end += 1;
  }
  return reachable[text.len()];
}

fun isBalancedBrackets(text: string): bool {
  let stack: [string] = [];
  let index = 0;
  while (index < text.len()) {
    let character = text.charAt(index);
    let opening = character == "(" || character == "[" || character == "{";
    if (opening) {
      stack.push(character);
    } else {
      let closing = character == ")" || character == "]" || character == "}";
      if (closing) {
        if (stack.len() == 0) {
          return false;
        }
        let top = stack[stack.len() - 1];
        if ((character == ")" && top != "(")
            || (character == "]" && top != "[")
            || (character == "}" && top != "{")) {
          return false;
        }
        stack.pop();
      }
    }
    index += 1;
  }
  return stack.len() == 0;
}

fun longestUniqueSubstringLength(text: string): number {
  let lastSeen: map<string, number> = {};
  let best = 0;
  let start = 0;
  let index = 0;
  while (index < text.len()) {
    let character = text.charAt(index);
    if (lastSeen.contains(character)) {
      let previous = lastSeen[character];
      if (previous >= start) {
        start = previous + 1;
      }
    }
    lastSeen[character] = index;
    let length = index - start + 1;
    if (length > best) {
      best = length;
    }
    index += 1;
  }
  return best;
}

fun longestPalindromicSubstring(text: string): string {
  if (text.len() == 0) {
    return "";
  }

  // Empty separators distinguish even and odd centers without assuming that
  // any particular Unicode scalar value is unavailable in the input.
  let transformed: [string] = [""];
  let index = 0;
  while (index < text.len()) {
    transformed.push(text.charAt(index));
    transformed.push("");
    index += 1;
  }

  let radii: [number] = [];
  index = 0;
  while (index < transformed.len()) {
    radii.push(0);
    index += 1;
  }

  let center = 0;
  let right = 0;
  let bestCenter = 0;
  let bestRadius = 0;
  index = 0;
  while (index < transformed.len()) {
    let radius = 0;
    if (index < right) {
      let mirror = center * 2 - index;
      radius = radii[mirror];
      if (right - index < radius) {
        radius = right - index;
      }
    }

    while (index - radius - 1 >= 0
        && index + radius + 1 < transformed.len()
        && transformed[index - radius - 1] == transformed[index + radius + 1]) {
      radius += 1;
    }
    radii[index] = radius;

    if (index + radius > right) {
      center = index;
      right = index + radius;
    }
    if (radius > bestRadius) {
      bestCenter = index;
      bestRadius = radius;
    }
    index += 1;
  }

  let bestStart = floor((bestCenter - bestRadius) / 2);
  return text.substr(bestStart, bestRadius);
}

struct Trie {
  edgeCharacters: [[string]],
  edgeChildren: [[number]],
  terminal: [bool]
}

impl Trie {
  fun findChild(node: number, character: string): number {
    let index = 0;
    while (index < this.edgeCharacters[node].len()) {
      if (this.edgeCharacters[node][index] == character) {
        return this.edgeChildren[node][index];
      }
      index += 1;
    }
    return -1;
  }

  fun addNode(): number {
    let node = this.terminal.len();
    this.edgeCharacters.push([]);
    this.edgeChildren.push([]);
    this.terminal.push(false);
    return node;
  }

  fun locate(text: string): number {
    let node = 0;
    let index = 0;
    while (index < text.len()) {
      let child = this.findChild(node, text.charAt(index));
      if (child < 0) {
        return -1;
      }
      node = child;
      index += 1;
    }
    return node;
  }

  fun insert(word: string): bool {
    let node = 0;
    let index = 0;
    while (index < word.len()) {
      let character = word.charAt(index);
      let child = this.findChild(node, character);
      if (child < 0) {
        child = this.addNode();
        this.edgeCharacters[node].push(character);
        this.edgeChildren[node].push(child);
      }
      node = child;
      index += 1;
    }
    if (this.terminal[node]) {
      return false;
    }
    this.terminal[node] = true;
    return true;
  }

  fun discard(word: string): bool {
    let nodes: [number] = [0];
    let edgePositions: [number] = [];
    let node = 0;
    let index = 0;
    while (index < word.len()) {
      let character = word.charAt(index);
      let edge = 0;
      while (edge < this.edgeCharacters[node].len()
             && this.edgeCharacters[node][edge] != character) {
        edge += 1;
      }
      if (edge >= this.edgeCharacters[node].len()) {
        return false;
      }
      node = this.edgeChildren[node][edge];
      nodes.push(node);
      edgePositions.push(edge);
      index += 1;
    }

    if (!this.terminal[node]) {
      return false;
    }
    this.terminal[node] = false;

    while (nodes.len() > 1) {
      let child = nodes[nodes.len() - 1];
      if (this.terminal[child] || this.edgeCharacters[child].len() > 0) {
        break;
      }
      let parent = nodes[nodes.len() - 2];
      let edge = edgePositions[edgePositions.len() - 1];
      while (edge + 1 < this.edgeCharacters[parent].len()) {
        this.edgeCharacters[parent][edge] = this.edgeCharacters[parent][edge + 1];
        this.edgeChildren[parent][edge] = this.edgeChildren[parent][edge + 1];
        edge += 1;
      }
      this.edgeCharacters[parent].pop();
      this.edgeChildren[parent].pop();
      nodes.pop();
      edgePositions.pop();
    }
    return true;
  }

  fun has(word: string): bool {
    let node = this.locate(word);
    return node >= 0 && this.terminal[node];
  }

  fun startsWith(prefix: string): bool {
    return this.locate(prefix) >= 0;
  }

  fun wordsWithPrefix(prefix: string): [string] {
    let result: [string] = [];
    let root = this.locate(prefix);
    if (root < 0) {
      return result;
    }
    let nodes: [number] = [root];
    let positions: [number] = [0];
    let words: [string] = [prefix];
    while (nodes.len() > 0) {
      let top = nodes.len() - 1;
      let node = nodes[top];
      if (positions[top] == 0 && this.terminal[node]) {
        result.push(words[top]);
      }
      if (positions[top] >= this.edgeCharacters[node].len()) {
        nodes.pop();
        positions.pop();
        words.pop();
        continue;
      }
      let edgeIndex = positions[top];
      positions[top] += 1;
      let child = this.edgeChildren[node][edgeIndex];
      let word = words[top] + this.edgeCharacters[node][edgeIndex];
      nodes.push(child);
      positions.push(0);
      words.push(word);
    }
    return result;
  }
}

fun newTrie(): Trie {
  let edgeCharacters: [[string]] = [[]];
  let edgeChildren: [[number]] = [[]];
  let terminal: [bool] = [false];
  return Trie {
    edgeCharacters: edgeCharacters,
    edgeChildren: edgeChildren,
    terminal: terminal
  };
}


export Trie, newTrie, reverseArray, rotateArray, linearSearch, compareStrings, stringLess, findSubstring, prefixFunction, zFunction, kmpSearch, isPalindrome, characterFrequency, areAnagrams, minimumWindowSubstring, canSegmentString, longestUniqueSubstringLength, longestPalindromicSubstring, isBalancedBrackets;
