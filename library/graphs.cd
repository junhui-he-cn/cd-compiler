// Integer-vertex graph containers and graph algorithms.
import "./collections.cd";

struct DisjointSet {
  parents: [number],
  sizes: [number],
  components: number
}

impl DisjointSet {
  fun representative(value: number): number {
    let mut root = value;
    while (this.parents[root] != root) {
      root = this.parents[root];
    }

    let mut current = value;
    while (current != root) {
      let next = this.parents[current];
      this.parents[current] = root;
      current = next;
    }
    return root;
  }

  fun union(left: number, right: number): bool {
    let mut leftRoot = this.representative(left);
    let mut rightRoot = this.representative(right);
    if (leftRoot == rightRoot) {
      return false;
    }
    if (this.sizes[leftRoot] < this.sizes[rightRoot]) {
      let value = leftRoot;
      leftRoot = rightRoot;
      rightRoot = value;
    }
    this.parents[rightRoot] = leftRoot;
    this.sizes[leftRoot] += this.sizes[rightRoot];
    this.components -= 1;
    return true;
  }

  fun connected(left: number, right: number): bool {
    return this.representative(left) == this.representative(right);
  }

  fun componentCount(): number {
    return this.components;
  }

  fun size(): number {
    return this.parents.len();
  }
}

fun newDisjointSet(count: number): DisjointSet {
  let mut length = floor(count);
  if (length < 0) {
    length = 0;
  }
  let parents: [number] = [];
  let sizes: [number] = [];
  let mut index = 0;
  while (index < length) {
    parents.push(index);
    sizes.push(1);
    index += 1;
  }
  return DisjointSet { parents: parents, sizes: sizes, components: length };
}

struct Graph {
  adjacency: [[number]],
  directed: bool,
  edges: number
}

impl Graph {
  fun vertexCount(): number {
    return this.adjacency.len();
  }

  fun edgeCount(): number {
    return this.edges;
  }

  fun validVertex(vertex: number): bool {
    return floor(vertex) == vertex && vertex >= 0 && vertex < this.adjacency.len();
  }

  fun neighborIndex(from: number, to: number): number {
    let mut index = 0;
    while (index < this.adjacency[from].len()) {
      if (this.adjacency[from][index] == to) {
        return index;
      }
      index += 1;
    }
    return -1;
  }

  fun hasEdge(from: number, to: number): bool {
    if (!this.validVertex(from) || !this.validVertex(to)) {
      return false;
    }
    return this.neighborIndex(from, to) >= 0;
  }

  fun addEdge(from: number, to: number): bool {
    if (!this.validVertex(from) || !this.validVertex(to) || this.hasEdge(from, to)) {
      return false;
    }
    this.adjacency[from].push(to);
    if (!this.directed && from != to) {
      this.adjacency[to].push(from);
    }
    this.edges += 1;
    return true;
  }

  fun removeEdge(from: number, to: number): bool {
    if (!this.validVertex(from) || !this.validVertex(to)) {
      return false;
    }
    let mut index = this.neighborIndex(from, to);
    if (index < 0) {
      return false;
    }
    while (index + 1 < this.adjacency[from].len()) {
      this.adjacency[from][index] = this.adjacency[from][index + 1];
      index += 1;
    }
    this.adjacency[from].pop();

    if (!this.directed && from != to) {
      let mut reverseIndex = this.neighborIndex(to, from);
      if (reverseIndex >= 0) {
        while (reverseIndex + 1 < this.adjacency[to].len()) {
          this.adjacency[to][reverseIndex] = this.adjacency[to][reverseIndex + 1];
          reverseIndex += 1;
        }
        this.adjacency[to].pop();
      }
    }
    this.edges -= 1;
    return true;
  }

  fun neighbors(vertex: number): [number] {
    if (!this.validVertex(vertex)) {
      return [];
    }
    return copy(this.adjacency[vertex]);
  }
}

fun newGraph(vertices: number, directed: bool): Graph {
  let mut count = floor(vertices);
  if (count < 0) {
    count = 0;
  }
  let adjacency: [[number]] = [];
  let mut index = 0;
  while (index < count) {
    let neighbors: [number] = [];
    adjacency.push(neighbors);
    index += 1;
  }
  return Graph { adjacency: adjacency, directed: directed, edges: 0 };
}

fun breadthFirstOrder(graph: Graph, start: number): [number] {
  let result: [number] = [];
  let mut count = graph.vertexCount();
  if (start < 0 || start >= count) {
    return result;
  }

  let visited: [bool] = [];
  let mut index = 0;
  while (index < count) {
    visited.push(false);
    index += 1;
  }

  let queue: [number] = [start];
  visited[start] = true;
  let mut head = 0;
  while (head < queue.len()) {
    let mut vertex = queue[head];
    head += 1;
    result.push(vertex);
    let neighbors = graph.neighbors(vertex);
    let mut neighborIndex = 0;
    while (neighborIndex < neighbors.len()) {
      let mut neighbor = neighbors[neighborIndex];
      if (!visited[neighbor]) {
        visited[neighbor] = true;
        queue.push(neighbor);
      }
      neighborIndex += 1;
    }
  }
  return result;
}

fun depthFirstOrder(graph: Graph, start: number): [number] {
  let result: [number] = [];
  let mut count = graph.vertexCount();
  if (start < 0 || start >= count) {
    return result;
  }

  let visited: [bool] = [];
  let mut index = 0;
  while (index < count) {
    visited.push(false);
    index += 1;
  }

  let stack: [number] = [start];
  visited[start] = true;
  while (stack.len() > 0) {
    let vertexIndex = stack.len() - 1;
    let mut vertex = stack[vertexIndex];
    stack.pop();
    result.push(vertex);

    let neighbors = graph.neighbors(vertex);
    let mut neighborIndex = neighbors.len();
    while (neighborIndex > 0) {
      neighborIndex -= 1;
      let mut neighbor = neighbors[neighborIndex];
      if (!visited[neighbor]) {
        visited[neighbor] = true;
        stack.push(neighbor);
      }
    }
  }
  return result;
}

fun connectedComponents(graph: Graph): [[number]] {
  let components: [[number]] = [];
  if (graph.directed) {
    return components;
  }
  let mut count = graph.vertexCount();
  let visited: [bool] = [];
  let mut index = 0;
  while (index < count) {
    visited.push(false);
    index += 1;
  }

  let mut root = 0;
  while (root < count) {
    if (visited[root]) {
      root += 1;
      continue;
    }
    let component: [number] = [];
    let queue: [number] = [root];
    visited[root] = true;
    let mut head = 0;
    while (head < queue.len()) {
      let mut vertex = queue[head];
      head += 1;
      component.push(vertex);
      let neighbors = graph.adjacency[vertex];
      let mut neighborIndex = 0;
      while (neighborIndex < neighbors.len()) {
        let mut neighbor = neighbors[neighborIndex];
        if (!visited[neighbor]) {
          visited[neighbor] = true;
          queue.push(neighbor);
        }
        neighborIndex += 1;
      }
    }
    components.push(component);
    root += 1;
  }
  return components;
}

fun isBipartite(graph: Graph): bool {
  if (graph.directed) {
    return false;
  }
  let mut count = graph.vertexCount();
  let colors: [number] = [];
  let mut index = 0;
  while (index < count) {
    colors.push(-1);
    index += 1;
  }

  let mut root = 0;
  while (root < count) {
    if (colors[root] >= 0) {
      root += 1;
      continue;
    }
    let queue: [number] = [root];
    colors[root] = 0;
    let mut head = 0;
    while (head < queue.len()) {
      let mut vertex = queue[head];
      head += 1;
      let neighbors = graph.adjacency[vertex];
      let mut neighborIndex = 0;
      while (neighborIndex < neighbors.len()) {
        let mut neighbor = neighbors[neighborIndex];
        if (colors[neighbor] < 0) {
          colors[neighbor] = 1 - colors[vertex];
          queue.push(neighbor);
        } else {
          if (colors[neighbor] == colors[vertex]) {
            return false;
          }
        }
        neighborIndex += 1;
      }
    }
    root += 1;
  }
  return true;
}

fun articulationPoints(graph: Graph): [number] {
  let result: [number] = [];
  if (graph.directed) {
    return result;
  }
  let mut count = graph.vertexCount();
  let discovery: [number] = [];
  let low: [number] = [];
  let parents: [number] = [];
  let childCounts: [number] = [];
  let articulation: [bool] = [];
  let mut index = 0;
  while (index < count) {
    discovery.push(-1);
    low.push(-1);
    parents.push(-1);
    childCounts.push(0);
    articulation.push(false);
    index += 1;
  }

  let mut time = 0;
  let mut root = 0;
  while (root < count) {
    if (discovery[root] >= 0) {
      root += 1;
      continue;
    }
    discovery[root] = time;
    low[root] = time;
    time += 1;
    let stack: [number] = [root];
    let nextIndices: [number] = [0];
    while (stack.len() > 0) {
      let top = stack.len() - 1;
      let mut vertex = stack[top];
      let neighbors = graph.adjacency[vertex];
      let mut neighborIndex = nextIndices[top];
      if (neighborIndex < neighbors.len()) {
        let mut neighbor = neighbors[neighborIndex];
        nextIndices[top] += 1;
        if (discovery[neighbor] < 0) {
          parents[neighbor] = vertex;
          childCounts[vertex] += 1;
          discovery[neighbor] = time;
          low[neighbor] = time;
          time += 1;
          stack.push(neighbor);
          nextIndices.push(0);
        } else {
          if (neighbor != parents[vertex] && discovery[neighbor] < low[vertex]) {
            low[vertex] = discovery[neighbor];
          }
        }
      } else {
        stack.pop();
        nextIndices.pop();
        let parent = parents[vertex];
        if (parent >= 0) {
          if (low[vertex] < low[parent]) {
            low[parent] = low[vertex];
          }
          if (parents[parent] >= 0 && low[vertex] >= discovery[parent]) {
            articulation[parent] = true;
          }
        } else {
          if (childCounts[vertex] > 1) {
            articulation[vertex] = true;
          }
        }
      }
    }
    root += 1;
  }

  index = 0;
  while (index < count) {
    if (articulation[index]) {
      result.push(index);
    }
    index += 1;
  }
  return result;
}

fun bridges(graph: Graph): [[number]] {
  let result: [[number]] = [];
  if (graph.directed) {
    return result;
  }
  let mut count = graph.vertexCount();
  let discovery: [number] = [];
  let low: [number] = [];
  let parents: [number] = [];
  let mut index = 0;
  while (index < count) {
    discovery.push(-1);
    low.push(-1);
    parents.push(-1);
    index += 1;
  }

  let mut time = 0;
  let mut root = 0;
  while (root < count) {
    if (discovery[root] >= 0) {
      root += 1;
      continue;
    }
    discovery[root] = time;
    low[root] = time;
    time += 1;
    let stack: [number] = [root];
    let nextIndices: [number] = [0];
    while (stack.len() > 0) {
      let top = stack.len() - 1;
      let mut vertex = stack[top];
      let neighbors = graph.adjacency[vertex];
      let mut neighborIndex = nextIndices[top];
      if (neighborIndex < neighbors.len()) {
        let mut neighbor = neighbors[neighborIndex];
        nextIndices[top] += 1;
        if (discovery[neighbor] < 0) {
          parents[neighbor] = vertex;
          discovery[neighbor] = time;
          low[neighbor] = time;
          time += 1;
          stack.push(neighbor);
          nextIndices.push(0);
        } else {
          if (neighbor != parents[vertex] && discovery[neighbor] < low[vertex]) {
            low[vertex] = discovery[neighbor];
          }
        }
      } else {
        stack.pop();
        nextIndices.pop();
        let parent = parents[vertex];
        if (parent >= 0) {
          if (low[vertex] > discovery[parent]) {
            let bridge: [number] = [parent, vertex];
            result.push(bridge);
          }
          if (low[vertex] < low[parent]) {
            low[parent] = low[vertex];
          }
        }
      }
    }
    root += 1;
  }
  return result;
}

fun eulerTrail(graph: Graph, start: number): [number] {
  let result: [number] = [];
  if (graph.directed) {
    return result;
  }
  let mut count = graph.vertexCount();
  if (start < 0 || start >= count) {
    return result;
  }

  let degrees: [number] = [];
  let mut oddCount = 0;
  let mut index = 0;
  while (index < count) {
    let mut degree = graph.adjacency[index].len();
    let mut neighborIndex = 0;
    while (neighborIndex < graph.adjacency[index].len()) {
      if (graph.adjacency[index][neighborIndex] == index) {
        degree += 1;
      }
      neighborIndex += 1;
    }
    degrees.push(degree);
    if (floor(degree / 2) * 2 != degree) {
      oddCount += 1;
    }
    index += 1;
  }
  if (oddCount != 0 && oddCount != 2) {
    return result;
  }
  if (oddCount == 2 && floor(degrees[start] / 2) * 2 == degrees[start]) {
    return result;
  }

  let remaining: [[number]] = [];
  index = 0;
  while (index < count) {
    let neighbors: [number] = [];
    let mut neighborIndex = 0;
    while (neighborIndex < graph.adjacency[index].len()) {
      neighbors.push(graph.adjacency[index][neighborIndex]);
      neighborIndex += 1;
    }
    remaining.push(neighbors);
    index += 1;
  }

  let stack: [number] = [start];
  while (stack.len() > 0) {
    let currentIndex = stack.len() - 1;
    let mut current = stack[currentIndex];
    if (remaining[current].len() > 0) {
      let mut neighbor = remaining[current].pop();
      if (neighbor != current) {
        let mut reverseIndex = 0;
        while (reverseIndex < remaining[neighbor].len()
               && remaining[neighbor][reverseIndex] != current) {
          reverseIndex += 1;
        }
        if (reverseIndex >= remaining[neighbor].len()) {
          return [];
        }
        while (reverseIndex + 1 < remaining[neighbor].len()) {
          remaining[neighbor][reverseIndex] = remaining[neighbor][reverseIndex + 1];
          reverseIndex += 1;
        }
        remaining[neighbor].pop();
      }
      stack.push(neighbor);
    } else {
      result.push(current);
      stack.pop();
    }
  }

  if (result.len() != graph.edgeCount() + 1) {
    return [];
  }
  let reversed: [number] = [];
  index = result.len();
  while (index > 0) {
    index -= 1;
    reversed.push(result[index]);
  }
  return reversed;
}

fun shortestDistances(graph: Graph, start: number): [number] {
  let distances: [number] = [];
  let mut count = graph.vertexCount();
  let mut index = 0;
  while (index < count) {
    distances.push(-1);
    index += 1;
  }
  if (start < 0 || start >= count) {
    return distances;
  }

  let queue: [number] = [start];
  distances[start] = 0;
  let mut head = 0;
  while (head < queue.len()) {
    let mut vertex = queue[head];
    head += 1;
    let neighbors = graph.neighbors(vertex);
    let mut neighborIndex = 0;
    while (neighborIndex < neighbors.len()) {
      let mut neighbor = neighbors[neighborIndex];
      if (distances[neighbor] < 0) {
        distances[neighbor] = distances[vertex] + 1;
        queue.push(neighbor);
      }
      neighborIndex += 1;
    }
  }
  return distances;
}

fun shortestPath(graph: Graph, start: number, goal: number): [number] {
  let result: [number] = [];
  let mut count = graph.vertexCount();
  if (start < 0 || start >= count || goal < 0 || goal >= count) {
    return result;
  }

  let parents: [number] = [];
  let mut index = 0;
  while (index < count) {
    parents.push(-1);
    index += 1;
  }
  let queue: [number] = [start];
  parents[start] = start;
  let mut head = 0;
  while (head < queue.len()) {
    let mut vertex = queue[head];
    head += 1;
    if (vertex == goal) {
      break;
    }
    let neighbors = graph.neighbors(vertex);
    let mut neighborIndex = 0;
    while (neighborIndex < neighbors.len()) {
      let mut neighbor = neighbors[neighborIndex];
      if (parents[neighbor] < 0) {
        parents[neighbor] = vertex;
        queue.push(neighbor);
      }
      neighborIndex += 1;
    }
  }

  if (parents[goal] < 0) {
    return result;
  }
  let mut current = goal;
  while (current != start) {
    result.push(current);
    current = parents[current];
  }
  result.push(start);

  let reversed: [number] = [];
  let mut resultIndex = result.len();
  while (resultIndex > 0) {
    resultIndex -= 1;
    reversed.push(result[resultIndex]);
  }
  return reversed;
}

fun inDegrees(graph: Graph): [number] {
  let degrees: [number] = [];
  if (!graph.directed) {
    return degrees;
  }
  let mut count = graph.vertexCount();
  let mut index = 0;
  while (index < count) {
    degrees.push(0);
    index += 1;
  }
  let mut vertex = 0;
  while (vertex < count) {
    let neighbors = graph.neighbors(vertex);
    let mut neighborIndex = 0;
    while (neighborIndex < neighbors.len()) {
      degrees[neighbors[neighborIndex]] += 1;
      neighborIndex += 1;
    }
    vertex += 1;
  }
  return degrees;
}

fun topologicalOrder(graph: Graph): [number] {
  let result: [number] = [];
  if (!graph.directed) {
    return result;
  }
  let mut count = graph.vertexCount();
  let degrees = inDegrees(graph);
  let queue: [number] = [];
  let mut index = 0;
  while (index < count) {
    if (degrees[index] == 0) {
      queue.push(index);
    }
    index += 1;
  }

  let mut head = 0;
  while (head < queue.len()) {
    let mut vertex = queue[head];
    head += 1;
    result.push(vertex);
    let neighbors = graph.neighbors(vertex);
    let mut neighborIndex = 0;
    while (neighborIndex < neighbors.len()) {
      let mut neighbor = neighbors[neighborIndex];
      degrees[neighbor] -= 1;
      if (degrees[neighbor] == 0) {
        queue.push(neighbor);
      }
      neighborIndex += 1;
    }
  }

  if (result.len() != count) {
    return [];
  }
  return result;
}

fun hasCycle(graph: Graph): bool {
  let mut count = graph.vertexCount();
  if (graph.directed) {
    return topologicalOrder(graph).len() != count;
  }

  let visited: [bool] = [];
  let parents: [number] = [];
  let mut index = 0;
  while (index < count) {
    visited.push(false);
    parents.push(-1);
    index += 1;
  }

  let mut root = 0;
  while (root < count) {
    if (visited[root]) {
      root += 1;
      continue;
    }
    let stack: [number] = [root];
    visited[root] = true;
    while (stack.len() > 0) {
      let vertexIndex = stack.len() - 1;
      let mut vertex = stack[vertexIndex];
      stack.pop();
      let neighbors = graph.neighbors(vertex);
      let mut neighborIndex = 0;
      while (neighborIndex < neighbors.len()) {
        let mut neighbor = neighbors[neighborIndex];
        if (!visited[neighbor]) {
          visited[neighbor] = true;
          parents[neighbor] = vertex;
          stack.push(neighbor);
        } else {
          if (parents[vertex] != neighbor) {
            return true;
          }
        }
        neighborIndex += 1;
      }
    }
    root += 1;
  }
  return false;
}

fun stronglyConnectedComponents(graph: Graph): [[number]] {
  let components: [[number]] = [];
  if (!graph.directed) {
    return components;
  }
  let mut count = graph.vertexCount();
  let visited: [bool] = [];
  let finish: [number] = [];
  let mut index = 0;
  while (index < count) {
    visited.push(false);
    index += 1;
  }

  let mut root = 0;
  while (root < count) {
    if (visited[root]) {
      root += 1;
      continue;
    }
    let stack: [number] = [root];
    let nextIndices: [number] = [0];
    visited[root] = true;
    while (stack.len() > 0) {
      let top = stack.len() - 1;
      let mut vertex = stack[top];
      let neighbors = graph.adjacency[vertex];
      let mut neighborIndex = nextIndices[top];
      if (neighborIndex < neighbors.len()) {
        let mut neighbor = neighbors[neighborIndex];
        nextIndices[top] += 1;
        if (!visited[neighbor]) {
          visited[neighbor] = true;
          stack.push(neighbor);
          nextIndices.push(0);
        }
      } else {
        stack.pop();
        nextIndices.pop();
        finish.push(vertex);
      }
    }
    root += 1;
  }

  let reversed: [[number]] = [];
  index = 0;
  while (index < count) {
    let neighbors: [number] = [];
    reversed.push(neighbors);
    index += 1;
  }
  let mut vertex = 0;
  while (vertex < count) {
    let neighbors = graph.adjacency[vertex];
    let mut neighborIndex = 0;
    while (neighborIndex < neighbors.len()) {
      let mut neighbor = neighbors[neighborIndex];
      reversed[neighbor].push(vertex);
      neighborIndex += 1;
    }
    vertex += 1;
  }

  index = 0;
  while (index < count) {
    visited[index] = false;
    index += 1;
  }
  let mut finishIndex = finish.len();
  while (finishIndex > 0) {
    finishIndex -= 1;
    root = finish[finishIndex];
    if (!visited[root]) {
      let component: [number] = [];
      let componentStack: [number] = [root];
      visited[root] = true;
      while (componentStack.len() > 0) {
        let top = componentStack.len() - 1;
        vertex = componentStack[top];
        componentStack.pop();
        component.push(vertex);
        let neighbors = reversed[vertex];
        let mut neighborIndex = 0;
        while (neighborIndex < neighbors.len()) {
          let mut neighbor = neighbors[neighborIndex];
          if (!visited[neighbor]) {
            visited[neighbor] = true;
            componentStack.push(neighbor);
          }
          neighborIndex += 1;
        }
      }
      components.push(component);
    }
  }
  return components;
}

struct TarjanSccState {
  indices: [number],
  lowLinks: [number],
  onStack: [bool],
  stack: [number],
  nextIndex: number,
  components: [[number]]
}

impl TarjanSccState {
  fun visit(graph: Graph, vertex: number) {
    this.indices[vertex] = this.nextIndex;
    this.lowLinks[vertex] = this.nextIndex;
    this.nextIndex += 1;
    this.stack.push(vertex);
    this.onStack[vertex] = true;

    let neighbors = graph.adjacency[vertex];
    let mut neighborIndex = 0;
    while (neighborIndex < neighbors.len()) {
      let mut neighbor = neighbors[neighborIndex];
      if (this.indices[neighbor] < 0) {
        this.visit(graph, neighbor);
        if (this.lowLinks[neighbor] < this.lowLinks[vertex]) {
          this.lowLinks[vertex] = this.lowLinks[neighbor];
        }
      } else {
        if (this.onStack[neighbor]
            && this.indices[neighbor] < this.lowLinks[vertex]) {
          this.lowLinks[vertex] = this.indices[neighbor];
        }
      }
      neighborIndex += 1;
    }

    if (this.lowLinks[vertex] == this.indices[vertex]) {
      let component: [number] = [];
      while (true) {
        let member = this.stack[this.stack.len() - 1];
        this.stack.pop();
        this.onStack[member] = false;
        component.push(member);
        if (member == vertex) {
          break;
        }
      }
      this.components.push(component);
    }
  }
}

fun stronglyConnectedComponentsTarjan(graph: Graph): [[number]] {
  let components: [[number]] = [];
  if (!graph.directed) {
    return components;
  }

  let mut count = graph.vertexCount();
  let indices: [number] = [];
  let lowLinks: [number] = [];
  let onStack: [bool] = [];
  let mut index = 0;
  while (index < count) {
    indices.push(-1);
    lowLinks.push(-1);
    onStack.push(false);
    index += 1;
  }

  let state = TarjanSccState {
    indices: indices,
    lowLinks: lowLinks,
    onStack: onStack,
    stack: [],
    nextIndex: 0,
    components: []
  };
  index = 0;
  while (index < count) {
    if (state.indices[index] < 0) {
      state.visit(graph, index);
    }
    index += 1;
  }
  return state.components;
}

struct WeightedEdge {
  to: number,
  weight: number
}

struct WeightedGraph {
  adjacency: [[WeightedEdge]],
  directed: bool,
  edges: number
}

impl WeightedGraph {
  fun vertexCount(): number {
    return this.adjacency.len();
  }

  fun edgeCount(): number {
    return this.edges;
  }

  fun validVertex(vertex: number): bool {
    return floor(vertex) == vertex && vertex >= 0 && vertex < this.adjacency.len();
  }

  fun edgeIndex(from: number, to: number): number {
    let mut index = 0;
    while (index < this.adjacency[from].len()) {
      if (this.adjacency[from][index].to == to) {
        return index;
      }
      index += 1;
    }
    return -1;
  }

  fun hasEdge(from: number, to: number): bool {
    if (!this.validVertex(from) || !this.validVertex(to)) {
      return false;
    }
    return this.edgeIndex(from, to) >= 0;
  }

  fun addEdge(from: number, to: number, weight: number): bool {
    if (!this.validVertex(from) || !this.validVertex(to) || weight < 0 || this.hasEdge(from, to)) {
      return false;
    }
    this.adjacency[from].push(WeightedEdge { to: to, weight: weight });
    if (!this.directed && from != to) {
      this.adjacency[to].push(WeightedEdge { to: from, weight: weight });
    }
    this.edges += 1;
    return true;
  }

  fun removeEdge(from: number, to: number): bool {
    if (!this.validVertex(from) || !this.validVertex(to)) {
      return false;
    }
    let mut index = this.edgeIndex(from, to);
    if (index < 0) {
      return false;
    }
    while (index + 1 < this.adjacency[from].len()) {
      this.adjacency[from][index] = this.adjacency[from][index + 1];
      index += 1;
    }
    this.adjacency[from].pop();

    if (!this.directed && from != to) {
      let mut reverseIndex = this.edgeIndex(to, from);
      if (reverseIndex >= 0) {
        while (reverseIndex + 1 < this.adjacency[to].len()) {
          this.adjacency[to][reverseIndex] = this.adjacency[to][reverseIndex + 1];
          reverseIndex += 1;
        }
        this.adjacency[to].pop();
      }
    }
    this.edges -= 1;
    return true;
  }

  fun neighbors(vertex: number): [WeightedEdge] {
    if (!this.validVertex(vertex)) {
      return [];
    }
    return copy(this.adjacency[vertex]);
  }
}

fun newWeightedGraph(vertices: number, directed: bool): WeightedGraph {
  let mut count = floor(vertices);
  if (count < 0) {
    count = 0;
  }
  let adjacency: [[WeightedEdge]] = [];
  let mut index = 0;
  while (index < count) {
    let neighbors: [WeightedEdge] = [];
    adjacency.push(neighbors);
    index += 1;
  }
  return WeightedGraph { adjacency: adjacency, directed: directed, edges: 0 };
}

enum CriticalPathError {
  InvalidStart,
  UndirectedGraph,
  Cycle
}

struct CriticalPathResult {
  distances: [optional<number>],
  parents: [number],
  order: [number]
}

fun criticalPath(
    graph: WeightedGraph,
    start: number
): Result<CriticalPathResult, CriticalPathError> {
  if (!graph.directed) {
    return Result.Err::<CriticalPathResult, CriticalPathError>(CriticalPathError.UndirectedGraph());
  }
  let mut count = graph.vertexCount();
  if (start < 0 || start >= count || floor(start) != start) {
    return Result.Err::<CriticalPathResult, CriticalPathError>(CriticalPathError.InvalidStart());
  }

  let indegrees: [number] = [];
  let mut index = 0;
  while (index < count) {
    indegrees.push(0);
    index += 1;
  }
  let mut from = 0;
  while (from < count) {
    let neighbors = graph.neighbors(from);
    let mut neighborIndex = 0;
    while (neighborIndex < neighbors.len()) {
      indegrees[neighbors[neighborIndex].to] += 1;
      neighborIndex += 1;
    }
    from += 1;
  }

  let ready: [number] = [];
  index = 0;
  while (index < count) {
    if (indegrees[index] == 0) {
      ready.push(index);
    }
    index += 1;
  }

  let order: [number] = [];
  let mut head = 0;
  while (head < ready.len()) {
    let vertex = ready[head];
    head += 1;
    order.push(vertex);
    let neighbors = graph.neighbors(vertex);
    let mut neighborIndex = 0;
    while (neighborIndex < neighbors.len()) {
      let target = neighbors[neighborIndex].to;
      indegrees[target] -= 1;
      if (indegrees[target] == 0) {
        ready.push(target);
      }
      neighborIndex += 1;
    }
  }
  if (order.len() != count) {
    return Result.Err::<CriticalPathResult, CriticalPathError>(CriticalPathError.Cycle());
  }

  let distanceValues: [number] = [];
  let reachable: [bool] = [];
  let parents: [number] = [];
  index = 0;
  while (index < count) {
    distanceValues.push(0);
    reachable.push(false);
    parents.push(-1);
    index += 1;
  }
  distanceValues[start] = 0;
  reachable[start] = true;

  let mut orderIndex = 0;
  while (orderIndex < order.len()) {
    from = order[orderIndex];
    if (reachable[from]) {
      let neighbors = graph.neighbors(from);
      let mut neighborIndex = 0;
      while (neighborIndex < neighbors.len()) {
        let edge = neighbors[neighborIndex];
        let candidate = distanceValues[from] + edge.weight;
        if (!reachable[edge.to]) {
          distanceValues[edge.to] = candidate;
          reachable[edge.to] = true;
          parents[edge.to] = from;
        } else {
          if (candidate > distanceValues[edge.to]) {
            distanceValues[edge.to] = candidate;
            parents[edge.to] = from;
          }
        }
        neighborIndex += 1;
      }
    }
    orderIndex += 1;
  }

  let distances: [optional<number>] = [];
  index = 0;
  while (index < count) {
    if (reachable[index]) {
      distances.push(distanceValues[index]);
    } else {
      distances.push(nil);
    }
    index += 1;
  }

  return Result.Ok::<CriticalPathResult, CriticalPathError>(
      CriticalPathResult { distances: distances, parents: parents, order: order });
}

struct SignedWeightedEdge {
  to: number,
  weight: number
}

struct SignedWeightedGraph {
  adjacency: [[SignedWeightedEdge]],
  directed: bool,
  edges: number
}

impl SignedWeightedGraph {
  fun vertexCount(): number {
    return this.adjacency.len();
  }

  fun edgeCount(): number {
    return this.edges;
  }

  fun validVertex(vertex: number): bool {
    return floor(vertex) == vertex && vertex >= 0 && vertex < this.adjacency.len();
  }

  fun edgeIndex(from: number, to: number): number {
    let mut index = 0;
    while (index < this.adjacency[from].len()) {
      if (this.adjacency[from][index].to == to) {
        return index;
      }
      index += 1;
    }
    return -1;
  }

  fun hasEdge(from: number, to: number): bool {
    if (!this.validVertex(from) || !this.validVertex(to)) {
      return false;
    }
    return this.edgeIndex(from, to) >= 0;
  }

  fun addEdge(from: number, to: number, weight: number): bool {
    if (!this.validVertex(from) || !this.validVertex(to) || this.hasEdge(from, to)) {
      return false;
    }
    this.adjacency[from].push(SignedWeightedEdge { to: to, weight: weight });
    if (!this.directed && from != to) {
      this.adjacency[to].push(SignedWeightedEdge { to: from, weight: weight });
    }
    this.edges += 1;
    return true;
  }

  fun removeEdge(from: number, to: number): bool {
    if (!this.validVertex(from) || !this.validVertex(to)) {
      return false;
    }
    let mut index = this.edgeIndex(from, to);
    if (index < 0) {
      return false;
    }
    while (index + 1 < this.adjacency[from].len()) {
      this.adjacency[from][index] = this.adjacency[from][index + 1];
      index += 1;
    }
    this.adjacency[from].pop();

    if (!this.directed && from != to) {
      let mut reverseIndex = this.edgeIndex(to, from);
      if (reverseIndex >= 0) {
        while (reverseIndex + 1 < this.adjacency[to].len()) {
          this.adjacency[to][reverseIndex] = this.adjacency[to][reverseIndex + 1];
          reverseIndex += 1;
        }
        this.adjacency[to].pop();
      }
    }
    this.edges -= 1;
    return true;
  }

  fun neighbors(vertex: number): [SignedWeightedEdge] {
    if (!this.validVertex(vertex)) {
      return [];
    }
    return copy(this.adjacency[vertex]);
  }
}

fun newSignedWeightedGraph(vertices: number, directed: bool): SignedWeightedGraph {
  let mut count = floor(vertices);
  if (count < 0) {
    count = 0;
  }
  let adjacency: [[SignedWeightedEdge]] = [];
  let mut index = 0;
  while (index < count) {
    let neighbors: [SignedWeightedEdge] = [];
    adjacency.push(neighbors);
    index += 1;
  }
  return SignedWeightedGraph { adjacency: adjacency, directed: directed, edges: 0 };
}

enum BellmanFordError {
  InvalidStart,
  NegativeCycle
}

struct BellmanFordResult {
  distances: [optional<number>],
  parents: [number]
}

fun bellmanFord(
    graph: SignedWeightedGraph,
    start: number
): Result<BellmanFordResult, BellmanFordError> {
  let count = graph.vertexCount();
  if (start < 0 || start >= count) {
    return Result.Err::<BellmanFordResult, BellmanFordError>(BellmanFordError.InvalidStart());
  }

  let distances: [optional<number>] = [];
  let parents: [number] = [];
  let mut index = 0;
  while (index < count) {
    distances.push(nil);
    parents.push(-1);
    index += 1;
  }
  distances[start] = 0;

  let mut pass = 0;
  while (pass < count - 1) {
    let mut changed = false;
    let mut from = 0;
    while (from < count) {
      match distances[from] {
        nil => { }
        current => {
        let neighbors = graph.adjacency[from];
        let mut neighborIndex = 0;
        while (neighborIndex < neighbors.len()) {
          let edge = neighbors[neighborIndex];
          let candidate = current + edge.weight;
          let existing = distances[edge.to];
          match existing {
            nil => {
              distances[edge.to] = candidate;
              parents[edge.to] = from;
              changed = true;
            }
            existing => {
              if (candidate < existing) {
                distances[edge.to] = candidate;
                parents[edge.to] = from;
                changed = true;
              }
            }
          }
          neighborIndex += 1;
        }
        }
      }
      from += 1;
    }
    if (!changed) {
      break;
    }
    pass += 1;
  }

  let mut from = 0;
  while (from < count) {
    match distances[from] {
      nil => { }
      current => {
      let neighbors = graph.adjacency[from];
      let mut neighborIndex = 0;
      while (neighborIndex < neighbors.len()) {
        let edge = neighbors[neighborIndex];
        let candidate = current + edge.weight;
        let existing = distances[edge.to];
        match existing {
          nil => { }
          existing => {
            if (candidate < existing) {
              return Result.Err::<BellmanFordResult, BellmanFordError>(BellmanFordError.NegativeCycle());
            }
          }
        }
        neighborIndex += 1;
      }
      }
    }
    from += 1;
  }
  return Result.Ok::<BellmanFordResult, BellmanFordError>(
      BellmanFordResult { distances: distances, parents: parents });
}

struct WeightedDistanceEntry {
  vertex: number,
  distance: number
}

fun weightedDistanceLess(left: WeightedDistanceEntry, right: WeightedDistanceEntry): bool {
  if (left.distance == right.distance) {
    return left.vertex < right.vertex;
  }
  return left.distance < right.distance;
}

fun shortestWeightedDistances(graph: WeightedGraph, start: number): [number] {
  let distances: [number] = [];
  let count = graph.vertexCount();
  let mut index = 0;
  while (index < count) {
    distances.push(-1);
    index += 1;
  }
  if (start < 0 || start >= count) {
    return distances;
  }
  distances[start] = 0;
  let pending = newBinaryHeap::<WeightedDistanceEntry>(weightedDistanceLess);
  pending.add(WeightedDistanceEntry { vertex: start, distance: 0 });

  while (!pending.isEmpty()) {
    match pending.take() {
      nil => { break; }
      entry => {
        let mut current = entry.vertex;
        let currentDistance = entry.distance;
        if (currentDistance != distances[current]) {
          continue;
        }
        let neighbors = graph.neighbors(current);
        let mut neighborIndex = 0;
        while (neighborIndex < neighbors.len()) {
          let edge = neighbors[neighborIndex];
          let candidate = currentDistance + edge.weight;
          if (distances[edge.to] < 0 || candidate < distances[edge.to]) {
            distances[edge.to] = candidate;
            pending.add(WeightedDistanceEntry { vertex: edge.to, distance: candidate });
          }
          neighborIndex += 1;
        }
      }
    }
  }
  return distances;
}

fun allPairsWeightedDistances(graph: WeightedGraph): [[number]] {
  let distances: [[number]] = [];
  let count = graph.vertexCount();
  let mut index = 0;
  while (index < count) {
    let row: [number] = [];
    let mut column = 0;
    while (column < count) {
      row.push(-1);
      column += 1;
    }
    row[index] = 0;
    distances.push(row);
    index += 1;
  }

  let mut from = 0;
  while (from < count) {
    let neighbors = graph.adjacency[from];
    let mut neighborIndex = 0;
    while (neighborIndex < neighbors.len()) {
      let edge = neighbors[neighborIndex];
      if (distances[from][edge.to] < 0 || edge.weight < distances[from][edge.to]) {
        distances[from][edge.to] = edge.weight;
      }
      neighborIndex += 1;
    }
    from += 1;
  }

  let mut via = 0;
  while (via < count) {
    from = 0;
    while (from < count) {
      if (distances[from][via] >= 0) {
        let mut to = 0;
        while (to < count) {
          if (distances[via][to] >= 0) {
            let candidate = distances[from][via] + distances[via][to];
            if (distances[from][to] < 0 || candidate < distances[from][to]) {
              distances[from][to] = candidate;
            }
          }
          to += 1;
        }
      }
      from += 1;
    }
    via += 1;
  }
  return distances;
}

struct FlowResult {
  residual: [[number]],
  total: number
}

fun computeFlow(graph: WeightedGraph, source: number, sink: number): FlowResult {
  if (!graph.directed || source < 0 || source >= graph.vertexCount()
      || sink < 0 || sink >= graph.vertexCount() || source == sink) {
    let empty: [[number]] = [];
    return FlowResult { residual: empty, total: 0 };
  }
  let count = graph.vertexCount();
  let capacities: [[number]] = [];
  let mut index = 0;
  while (index < count) {
    let row: [number] = [];
    let mut column = 0;
    while (column < count) {
      row.push(0);
      column += 1;
    }
    capacities.push(row);
    index += 1;
  }

  let mut from = 0;
  while (from < count) {
    let neighbors = graph.adjacency[from];
    let mut neighborIndex = 0;
    while (neighborIndex < neighbors.len()) {
      let edge = neighbors[neighborIndex];
      capacities[from][edge.to] += edge.weight;
      neighborIndex += 1;
    }
    from += 1;
  }

  let mut total = 0;
  while (true) {
    let parents: [number] = [];
    let visited: [bool] = [];
    index = 0;
    while (index < count) {
      parents.push(-1);
      visited.push(false);
      index += 1;
    }
    let queue: [number] = [source];
    visited[source] = true;
    let mut head = 0;
    while (head < queue.len() && !visited[sink]) {
      let mut current = queue[head];
      head += 1;
      let mut neighbor = 0;
      while (neighbor < count) {
        if (!visited[neighbor] && capacities[current][neighbor] > 0) {
          visited[neighbor] = true;
          parents[neighbor] = current;
          queue.push(neighbor);
        }
        neighbor += 1;
      }
    }
    if (!visited[sink]) {
      break;
    }

    let mut bottleneck = -1;
    let mut current = sink;
    while (current != source) {
      let parent = parents[current];
      if (bottleneck < 0 || capacities[parent][current] < bottleneck) {
        bottleneck = capacities[parent][current];
      }
      current = parent;
    }
    current = sink;
    while (current != source) {
      let parent = parents[current];
      capacities[parent][current] -= bottleneck;
      capacities[current][parent] += bottleneck;
      current = parent;
    }
    total += bottleneck;
  }
  return FlowResult { residual: capacities, total: total };
}

fun maxFlow(graph: WeightedGraph, source: number, sink: number): number {
  let result = computeFlow(graph, source, sink);
  return result.total;
}

fun minCut(graph: WeightedGraph, source: number, sink: number): [[number]] {
  let cut: [[number]] = [];
  if (!graph.directed || source < 0 || source >= graph.vertexCount()
      || sink < 0 || sink >= graph.vertexCount() || source == sink) {
    return cut;
  }
  let result = computeFlow(graph, source, sink);
  let residual = result.residual;
  let count = graph.vertexCount();
  let reachable: [bool] = [];
  let mut index = 0;
  while (index < count) {
    reachable.push(false);
    index += 1;
  }
  let queue: [number] = [source];
  reachable[source] = true;
  let mut head = 0;
  while (head < queue.len()) {
    let mut current = queue[head];
    head += 1;
    let mut neighbor = 0;
    while (neighbor < count) {
      if (!reachable[neighbor] && residual[current][neighbor] > 0) {
        reachable[neighbor] = true;
        queue.push(neighbor);
      }
      neighbor += 1;
    }
  }

  let mut from = 0;
  while (from < count) {
    if (reachable[from]) {
      let neighbors = graph.adjacency[from];
      let mut neighborIndex = 0;
      while (neighborIndex < neighbors.len()) {
        let edge = neighbors[neighborIndex];
        if (edge.weight > 0 && !reachable[edge.to]) {
          let pair: [number] = [from, edge.to];
          cut.push(pair);
        }
        neighborIndex += 1;
      }
    }
    from += 1;
  }
  return cut;
}

fun shortestWeightedPath(graph: WeightedGraph, start: number, goal: number): [number] {
  let result: [number] = [];
  let count = graph.vertexCount();
  if (start < 0 || start >= count || goal < 0 || goal >= count) {
    return result;
  }

  let distances: [number] = [];
  let parents: [number] = [];
  let mut index = 0;
  while (index < count) {
    distances.push(-1);
    parents.push(-1);
    index += 1;
  }
  distances[start] = 0;
  let pending = newBinaryHeap::<WeightedDistanceEntry>(weightedDistanceLess);
    pending.add(WeightedDistanceEntry { vertex: start, distance: 0 });

  while (!pending.isEmpty()) {
    match pending.take() {
      nil => { break; }
      entry => {
        let mut current = entry.vertex;
        let currentDistance = entry.distance;
        if (currentDistance != distances[current]) {
          continue;
        }
        if (current == goal) {
          break;
        }
        let neighbors = graph.neighbors(current);
        let mut neighborIndex = 0;
        while (neighborIndex < neighbors.len()) {
          let edge = neighbors[neighborIndex];
          let candidate = currentDistance + edge.weight;
          if (distances[edge.to] < 0 || candidate < distances[edge.to]) {
            distances[edge.to] = candidate;
            parents[edge.to] = current;
            pending.add(WeightedDistanceEntry { vertex: edge.to, distance: candidate });
          }
          neighborIndex += 1;
        }
      }
    }
  }

  if (start != goal && parents[goal] < 0) {
    return result;
  }
  let mut current = goal;
  while (current != start) {
    result.push(current);
    current = parents[current];
  }
  result.push(start);

  let reversed: [number] = [];
  let mut resultIndex = result.len();
  while (resultIndex > 0) {
    resultIndex -= 1;
    reversed.push(result[resultIndex]);
  }
  return reversed;
}

fun minimumSpanningForest(graph: WeightedGraph): WeightedGraph {
  let count = graph.vertexCount();
  let forest = newWeightedGraph(count, false);
  if (graph.directed) {
    return forest;
  }

  let visited: [bool] = [];
  let distances: [number] = [];
  let parents: [number] = [];
  let parentWeights: [number] = [];
  let mut index = 0;
  while (index < count) {
    visited.push(false);
    distances.push(-1);
    parents.push(-1);
    parentWeights.push(-1);
    index += 1;
  }

  let mut root = 0;
  while (root < count) {
    if (visited[root]) {
      root += 1;
      continue;
    }
    distances[root] = 0;
    parents[root] = -1;
    parentWeights[root] = -1;
    let pending = newBinaryHeap::<WeightedDistanceEntry>(weightedDistanceLess);
    pending.add(WeightedDistanceEntry { vertex: root, distance: 0 });
    while (!pending.isEmpty()) {
      match pending.take() {
        nil => { break; }
        entry => {
          let current = entry.vertex;
          let currentDistance = entry.distance;
          if (visited[current] || currentDistance != distances[current]) {
            continue;
          }
          visited[current] = true;
          if (parents[current] >= 0) {
            forest.addEdge(parents[current], current, parentWeights[current]);
          }
          let neighbors = graph.neighbors(current);
          let mut neighborIndex = 0;
          while (neighborIndex < neighbors.len()) {
            let edge = neighbors[neighborIndex];
            if (!visited[edge.to]
                && (distances[edge.to] < 0 || edge.weight < distances[edge.to])) {
              distances[edge.to] = edge.weight;
              parents[edge.to] = current;
              parentWeights[edge.to] = edge.weight;
              pending.add(WeightedDistanceEntry { vertex: edge.to, distance: edge.weight });
            }
            neighborIndex += 1;
          }
        }
      }
    }
    root += 1;
  }
  return forest;
}


export DisjointSet, Graph, WeightedEdge, WeightedGraph, SignedWeightedEdge, SignedWeightedGraph, BellmanFordError, BellmanFordResult, CriticalPathError, CriticalPathResult, newDisjointSet, newGraph, newWeightedGraph, newSignedWeightedGraph, breadthFirstOrder, depthFirstOrder, connectedComponents, isBipartite, articulationPoints, bridges, eulerTrail, shortestDistances, shortestPath, inDegrees, topologicalOrder, hasCycle, stronglyConnectedComponents, stronglyConnectedComponentsTarjan, criticalPath, bellmanFord, shortestWeightedDistances, allPairsWeightedDistances, maxFlow, minCut, shortestWeightedPath, minimumSpanningForest;
