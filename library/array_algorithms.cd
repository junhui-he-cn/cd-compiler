// Array, interval, two-pointer, and frequency algorithms.
import "./sets.cd";
import "./strings.cd";
import "./sorting.cd";

fun prefixSums(values: [number]): [number] {
  let result: [number] = [];
  let sum = 0;
  let index = 0;
  while (index < values.len()) {
    sum += values[index];
    result.push(sum);
    index += 1;
  }
  return result;
}

fun differenceArray(values: [number]): [number] {
  let result: [number] = [];
  if (values.len() == 0) {
    return result;
  }
  result.push(values[0]);
  let index = 1;
  while (index < values.len()) {
    result.push(values[index] - values[index - 1]);
    index += 1;
  }
  return result;
}

fun prefixMinimums(values: [number]): [number] {
  let result: [number] = [];
  if (values.len() == 0) {
    return result;
  }
  let best = values[0];
  result.push(best);
  let index = 1;
  while (index < values.len()) {
    if (values[index] < best) {
      best = values[index];
    }
    result.push(best);
    index += 1;
  }
  return result;
}

fun prefixMaximums(values: [number]): [number] {
  let result: [number] = [];
  if (values.len() == 0) {
    return result;
  }
  let best = values[0];
  result.push(best);
  let index = 1;
  while (index < values.len()) {
    if (values[index] > best) {
      best = values[index];
    }
    result.push(best);
    index += 1;
  }
  return result;
}

fun nextGreaterValues(values: [number]): [number] {
  let result: [number] = [];
  let index = 0;
  while (index < values.len()) {
    result.push(-1);
    index += 1;
  }
  let stack: [number] = [];
  index = 0;
  while (index < values.len()) {
    while (stack.len() > 0) {
      let topIndex = stack[stack.len() - 1];
      if (values[topIndex] >= values[index]) {
        break;
      }
      result[topIndex] = values[index];
      stack.pop();
    }
    stack.push(index);
    index += 1;
  }
  return result;
}

fun largestHistogramArea(heights: [number]): optional<number> {
  let validationIndex = 0;
  while (validationIndex < heights.len()) {
    if (floor(heights[validationIndex]) != heights[validationIndex]
        || heights[validationIndex] < 0) {
      return nil;
    }
    validationIndex += 1;
  }

  let stack: [number] = [];
  let best = 0;
  let index = 0;
  while (index <= heights.len()) {
    let current = 0;
    if (index < heights.len()) {
      current = heights[index];
    }
    while (stack.len() > 0 && current < heights[stack[stack.len() - 1]]) {
      let top = stack.pop();
      let width = index;
      if (stack.len() > 0) {
        width = index - stack[stack.len() - 1] - 1;
      }
      let area = heights[top] * width;
      if (area > best) {
        best = area;
      }
    }
    stack.push(index);
    index += 1;
  }
  return best;
}

struct Interval {
  start: number,
  end: number
}

fun intervalLess(left: Interval, right: Interval): bool {
  if (left.start == right.start) {
    return left.end < right.end;
  }
  return left.start < right.start;
}

fun mergeIntervals(intervals: [Interval]): [Interval] {
  let ordered = sortArray(intervals, intervalLess);
  let merged: [Interval] = [];
  let index = 0;
  while (index < ordered.len()) {
    let current = ordered[index];
    if (merged.len() == 0 || current.start > merged[merged.len() - 1].end) {
      merged.push(Interval { start: current.start, end: current.end });
    } else {
      if (current.end > merged[merged.len() - 1].end) {
        merged[merged.len() - 1].end = current.end;
      }
    }
    index += 1;
  }
  return merged;
}

fun intersectIntervals(left: [Interval], right: [Interval]): [Interval] {
  let leftMerged = mergeIntervals(left);
  let rightMerged = mergeIntervals(right);
  let result: [Interval] = [];
  let leftIndex = 0;
  let rightIndex = 0;

  while (leftIndex < leftMerged.len() && rightIndex < rightMerged.len()) {
    let leftInterval = leftMerged[leftIndex];
    let rightInterval = rightMerged[rightIndex];
    let start = leftInterval.start;
    if (rightInterval.start > start) {
      start = rightInterval.start;
    }
    let end = leftInterval.end;
    if (rightInterval.end < end) {
      end = rightInterval.end;
    }
    if (start <= end) {
      result.push(Interval { start: start, end: end });
    }

    if (leftInterval.end < rightInterval.end) {
      leftIndex += 1;
    } else {
      rightIndex += 1;
    }
  }
  return result;
}

fun intervalEndLess(left: Interval, right: Interval): bool {
  if (left.end == right.end) {
    return left.start < right.start;
  }
  return left.end < right.end;
}

fun selectNonOverlappingIntervals(intervals: [Interval]): [Interval] {
  let index = 0;
  while (index < intervals.len()) {
    if (intervals[index].start > intervals[index].end) {
      return [];
    }
    index += 1;
  }

  let ordered = sortArray(intervals, intervalEndLess);
  let result: [Interval] = [];
  let hasLast = false;
  let lastEnd = 0;
  index = 0;
  while (index < ordered.len()) {
    let current = ordered[index];
    if (!hasLast || current.start > lastEnd) {
      result.push(Interval { start: current.start, end: current.end });
      lastEnd = current.end;
      hasLast = true;
    }
    index += 1;
  }
  return result;
}

fun numberLess(left: number, right: number): bool {
  return left < right;
}

fun minimumIntervalRooms(intervals: [Interval]): optional<number> {
  let starts: [number] = [];
  let ends: [number] = [];
  let index = 0;
  while (index < intervals.len()) {
    if (intervals[index].start > intervals[index].end) {
      return nil;
    }
    starts.push(intervals[index].start);
    ends.push(intervals[index].end);
    index += 1;
  }

  let orderedStarts = sortArray(starts, numberLess);
  let orderedEnds = sortArray(ends, numberLess);
  let startIndex = 0;
  let endIndex = 0;
  let active = 0;
  let best = 0;
  while (startIndex < orderedStarts.len()) {
    if (orderedStarts[startIndex] <= orderedEnds[endIndex]) {
      active += 1;
      if (active > best) {
        best = active;
      }
      startIndex += 1;
    } else {
      active -= 1;
      endIndex += 1;
    }
  }
  return best;
}

fun canReachEnd(values: [number]): bool {
  let index = 0;
  while (index < values.len()) {
    if (floor(values[index]) != values[index] || values[index] < 0) {
      return false;
    }
    index += 1;
  }
  if (values.len() <= 1) {
    return true;
  }

  let farthest = 0;
  index = 0;
  while (index < values.len() && index <= farthest) {
    let reach = index + values[index];
    if (reach > farthest) {
      farthest = reach;
    }
    if (farthest >= values.len() - 1) {
      return true;
    }
    index += 1;
  }
  return false;
}

fun minimumJumps(values: [number]): optional<number> {
  let index = 0;
  while (index < values.len()) {
    if (floor(values[index]) != values[index] || values[index] < 0) {
      return nil;
    }
    index += 1;
  }
  if (values.len() <= 1) {
    return 0;
  }

  let jumps = 0;
  let currentEnd = 0;
  let farthest = 0;
  index = 0;
  while (index < values.len() - 1) {
    let reach = index + values[index];
    if (reach > farthest) {
      farthest = reach;
    }
    if (index == currentEnd) {
      if (farthest == currentEnd) {
        return nil;
      }
      jumps += 1;
      currentEnd = farthest;
    }
    index += 1;
  }
  return jumps;
}

fun huffmanMergeCost(weights: [number]): optional<number> {
  let working: [number] = [];
  let index = 0;
  while (index < weights.len()) {
    if (weights[index] < 0) {
      return nil;
    }
    working.push(weights[index]);
    index += 1;
  }

  let total = 0;
  while (working.len() > 1) {
    let firstIndex = 0;
    let secondIndex = 1;
    if (working[secondIndex] < working[firstIndex]) {
      let swap = firstIndex;
      firstIndex = secondIndex;
      secondIndex = swap;
    }
    index = 2;
    while (index < working.len()) {
      if (working[index] < working[firstIndex]) {
        secondIndex = firstIndex;
        firstIndex = index;
      } else {
        if (working[index] < working[secondIndex]) {
          secondIndex = index;
        }
      }
      index += 1;
    }

    let merged = working[firstIndex] + working[secondIndex];
    total += merged;
    let remaining: [number] = [];
    index = 0;
    while (index < working.len()) {
      if (index != firstIndex && index != secondIndex) {
        remaining.push(working[index]);
      }
      index += 1;
    }
    remaining.push(merged);
    working = remaining;
  }
  return total;
}

fun mergeSortedNumbers(left: [number], right: [number]): [number] {
  let result: [number] = [];
  let leftIndex = 0;
  let rightIndex = 0;
  while (leftIndex < left.len() && rightIndex < right.len()) {
    if (left[leftIndex] <= right[rightIndex]) {
      result.push(left[leftIndex]);
      leftIndex += 1;
    } else {
      result.push(right[rightIndex]);
      rightIndex += 1;
    }
  }
  while (leftIndex < left.len()) {
    result.push(left[leftIndex]);
    leftIndex += 1;
  }
  while (rightIndex < right.len()) {
    result.push(right[rightIndex]);
    rightIndex += 1;
  }
  return result;
}

fun mergeSortedArrays<T>(sequences: [[T]], less: fun(T, T): bool): [T] {
  let result: [T] = [];
  let positions: [number] = [];
  let sequenceIndex = 0;
  while (sequenceIndex < sequences.len()) {
    positions.push(0);
    sequenceIndex += 1;
  }

  while (true) {
    let bestSequence = -1;
    sequenceIndex = 0;
    while (sequenceIndex < sequences.len()) {
      if (positions[sequenceIndex] < sequences[sequenceIndex].len()) {
        if (bestSequence < 0
            || less(sequences[sequenceIndex][positions[sequenceIndex]],
                    sequences[bestSequence][positions[bestSequence]])) {
          bestSequence = sequenceIndex;
        }
      }
      sequenceIndex += 1;
    }

    if (bestSequence < 0) {
      break;
    }
    result.push(sequences[bestSequence][positions[bestSequence]]);
    positions[bestSequence] += 1;
  }
  return result;
}

fun twoSumSorted(values: [number], target: number): [number] {
  let result: [number] = [];
  let left = 0;
  let right = values.len() - 1;
  while (left < right) {
    let sum = values[left] + values[right];
    if (sum == target) {
      result.push(left);
      result.push(right);
      return result;
    }
    if (sum < target) {
      left += 1;
    } else {
      right -= 1;
    }
  }
  return result;
}

fun threeSumNumberLess(left: number, right: number): bool {
  return left < right;
}

fun threeSumZero(values: [number]): [[number]] {
  let result: [[number]] = [];
  let sorted = sortArray(values, threeSumNumberLess);
  let index = 0;
  while (index + 2 < sorted.len()) {
    if (index > 0 && sorted[index] == sorted[index - 1]) {
      index += 1;
    } else {
      let left = index + 1;
      let right = sorted.len() - 1;
      while (left < right) {
        let total = sorted[index] + sorted[left] + sorted[right];
        if (total == 0) {
          let triple: [number] = [sorted[index], sorted[left], sorted[right]];
          result.push(triple);
          let leftValue = sorted[left];
          let rightValue = sorted[right];
          while (left < right && sorted[left] == leftValue) {
            left += 1;
          }
          while (left < right && sorted[right] == rightValue) {
            right -= 1;
          }
        } else {
          if (total < 0) {
            left += 1;
          } else {
            right -= 1;
          }
        }
      }
      index += 1;
    }
  }
  return result;
}

fun threeSumClosest(values: [number], target: number): optional<number> {
  if (values.len() < 3) {
    return nil;
  }

  let sorted = sortArray(values, threeSumNumberLess);
  let found = false;
  let best = 0;
  let bestDistance = 0;
  let index = 0;
  while (index + 2 < sorted.len()) {
    let left = index + 1;
    let right = sorted.len() - 1;
    while (left < right) {
      let total = sorted[index] + sorted[left] + sorted[right];
      let distance = total - target;
      if (distance < 0) {
        distance = -distance;
      }
      if (!found || distance < bestDistance
          || (distance == bestDistance && total < best)) {
        found = true;
        best = total;
        bestDistance = distance;
      }
      if (total == target) {
        return total;
      }
      if (total < target) {
        left += 1;
      } else {
        right -= 1;
      }
    }
    index += 1;
  }
  return best;
}

fun uniqueValues<T: Eq>(values: [T]): [T] {
  let result: [T] = [];
  let index = 0;
  while (index < values.len()) {
    if (linearSearch(result, values[index]) < 0) {
      result.push(values[index]);
    }
    index += 1;
  }
  return result;
}

fun intersectionValues<T: Eq>(left: [T], right: [T]): [T] {
  let result: [T] = [];
  let index = 0;
  while (index < left.len()) {
    let value = left[index];
    if (linearSearch(right, value) >= 0 && linearSearch(result, value) < 0) {
      result.push(value);
    }
    index += 1;
  }
  return result;
}

fun unionValues<T: Eq>(left: [T], right: [T]): [T] {
  let result = uniqueValues(left);
  let index = 0;
  while (index < right.len()) {
    if (linearSearch(result, right[index]) < 0) {
      result.push(right[index]);
    }
    index += 1;
  }
  return result;
}

fun differenceValues<T: Eq>(left: [T], right: [T]): [T] {
  let result: [T] = [];
  let index = 0;
  while (index < left.len()) {
    let value = left[index];
    if (linearSearch(right, value) < 0 && linearSearch(result, value) < 0) {
      result.push(value);
    }
    index += 1;
  }
  return result;
}

fun frequencyEntries<T: Eq>(values: [T]): [MultiSetEntry<T>] {
  let counts = newMultiSet<T>();
  let index = 0;
  while (index < values.len()) {
    counts.add(values[index]);
    index += 1;
  }
  return counts.entries();
}

fun mostFrequent<T: Eq>(values: [T]): optional<T> {
  let entries = frequencyEntries(values);
  if (entries.len() == 0) {
    return nil;
  }

  let best = entries[0].value;
  let bestCount = entries[0].count;
  let index = 1;
  while (index < entries.len()) {
    if (entries[index].count > bestCount) {
      best = entries[index].value;
      bestCount = entries[index].count;
    }
    index += 1;
  }
  return best;
}

fun windowSums(values: [number], width: number): [number] {
  let result: [number] = [];
  if (width <= 0 || width > values.len()) {
    return result;
  }

  let sum = 0;
  let index = 0;
  while (index < width) {
    sum += values[index];
    index += 1;
  }
  result.push(sum);

  let start = width;
  while (start < values.len()) {
    sum += values[start];
    sum -= values[start - width];
    result.push(sum);
    start += 1;
  }
  return result;
}

fun maxWindowSum(values: [number], width: number): optional<number> {
  let sums = windowSums(values, width);
  if (sums.len() == 0) {
    return nil;
  }

  let best = sums[0];
  let index = 1;
  while (index < sums.len()) {
    if (sums[index] > best) {
      best = sums[index];
    }
    index += 1;
  }
  return best;
}

fun maxWindowValues(values: [number], width: number): [number] {
  let result: [number] = [];
  if (floor(width) != width || width <= 0 || width > values.len()) {
    return result;
  }

  let candidates: [number] = [];
  let head = 0;
  let index = 0;
  while (index < values.len()) {
    while (head < candidates.len() && candidates[head] <= index - width) {
      head += 1;
    }
    while (candidates.len() > head
           && values[candidates[candidates.len() - 1]] <= values[index]) {
      candidates.pop();
    }
    candidates.push(index);
    if (index >= width - 1) {
      result.push(values[candidates[head]]);
    }
    index += 1;
  }
  return result;
}

fun minWindowValues(values: [number], width: number): [number] {
  let result: [number] = [];
  if (floor(width) != width || width <= 0 || width > values.len()) {
    return result;
  }

  let candidates: [number] = [];
  let head = 0;
  let index = 0;
  while (index < values.len()) {
    while (head < candidates.len() && candidates[head] <= index - width) {
      head += 1;
    }
    while (candidates.len() > head
           && values[candidates[candidates.len() - 1]] >= values[index]) {
      candidates.pop();
    }
    candidates.push(index);
    if (index >= width - 1) {
      result.push(values[candidates[head]]);
    }
    index += 1;
  }
  return result;
}

fun maxSubarraySum(values: [number]): optional<number> {
  if (values.len() == 0) {
    return nil;
  }

  let current = values[0];
  let best = values[0];
  let index = 1;
  while (index < values.len()) {
    let extended = current + values[index];
    if (values[index] > extended) {
      current = values[index];
    } else {
      current = extended;
    }
    if (current > best) {
      best = current;
    }
    index += 1;
  }
  return best;
}


export prefixSums, differenceArray, prefixMinimums, prefixMaximums, nextGreaterValues, largestHistogramArea, Interval, mergeIntervals, intersectIntervals, selectNonOverlappingIntervals, minimumIntervalRooms, canReachEnd, minimumJumps, huffmanMergeCost, mergeSortedNumbers, mergeSortedArrays, twoSumSorted, threeSumZero, threeSumClosest, uniqueValues, intersectionValues, unionValues, differenceValues, frequencyEntries, mostFrequent, windowSums, maxWindowSum, maxWindowValues, minWindowValues, maxSubarraySum;
