import "../../data_structures.cd" as ds;

print ds.longestUniqueSubstringLength("abcabcbb");
print ds.longestUniqueSubstringLength("bbbbb");
print ds.longestUniqueSubstringLength("pwwkew");
print ds.longestUniqueSubstringLength("dvdf");
print ds.longestUniqueSubstringLength("abba");
print ds.longestUniqueSubstringLength("");
print ds.longestUniqueSubstringLength("你我你🙂");

print ds.longestPalindromicSubstring("babad");
print ds.longestPalindromicSubstring("cbbd");
print ds.longestPalindromicSubstring("forgeeksskeegfor");
print ds.longestPalindromicSubstring("你我你");
print ds.longestPalindromicSubstring("") == "";

let palindromeStress = "";
let palindromeIndex = 0;
while (palindromeIndex < 4096) {
  palindromeStress = palindromeStress + "a";
  palindromeIndex += 1;
}
let palindromeResult = ds.longestPalindromicSubstring(palindromeStress);
print palindromeResult.len();
print palindromeResult == palindromeStress;
print palindromeResult.charAt(0);
print palindromeResult.charAt(palindromeResult.len() - 1);
