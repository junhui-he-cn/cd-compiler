import "../../data_structures.cd" as ds;

fun renderEntries(values: [ds.MultiSetEntry<string>]): string {
  let result = "";
  let index = 0;
  while (index < values.len()) {
    if (index > 0) {
      result = result + ",";
    }
    let entry = values[index];
    result = result + entry.value + ":" + str(entry.count);
    index += 1;
  }
  return result;
}

let words = ["cat", "dog", "cat", "bird", "dog", "cat"];
print renderEntries(ds.frequencyEntries(words));
print ds.mostFrequent(words);

let tie = ["a", "b", "a", "b"];
print renderEntries(ds.frequencyEntries(tie));
print ds.mostFrequent(tie);

print ds.frequencyEntries([2, 2, 3, 2]);
print ds.mostFrequent([2, 2, 3, 2]);

let empty: [number] = [];
print ds.frequencyEntries<number>(empty);
print ds.mostFrequent<number>(empty);
