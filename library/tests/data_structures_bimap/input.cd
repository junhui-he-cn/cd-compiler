import "../../data_structures.cd" as ds;

fun render(entries: [ds.BiMapEntry<string, number>]): string {
  let result = "";
  let index = 0;
  while (index < entries.len()) {
    if (index > 0) {
      result = result + ",";
    }
    result = result + entries[index].key + "=" + str(entries[index].value);
    index += 1;
  }
  return result;
}

let mapping = ds.newBiMap<string, number>();
print mapping.isEmpty();
print mapping.get("missing");
print mapping.getKey(99);
print mapping.hasKey("missing");
print mapping.hasValue(99);
print mapping.put("alpha", 1);
print mapping.put("beta", 2);
print mapping.put("alpha", 3);
print mapping.put("gamma", 2);
print render(mapping.snapshot());
print mapping.get("beta");
print mapping.getKey(1);
print mapping.hasKey("alpha");
print mapping.hasValue(2);
print mapping.discardKey("alpha");
print mapping.getKey(1);
print mapping.discardKey("alpha");
let snapshot = mapping.snapshot();
snapshot[0].value = 20;
print render(mapping.snapshot());
print mapping.discardValue(2);
print mapping.discardValue(2);
print render(mapping.snapshot());
print mapping.discardValue(1);
print mapping.isEmpty();
