import "../../data_structures.cd" as ds;

let intervals: [ds.Interval] = [
  ds.Interval { start: 5, end: 7 },
  ds.Interval { start: 1, end: 3 },
  ds.Interval { start: 2, end: 4 },
  ds.Interval { start: 9, end: 10 },
  ds.Interval { start: 6, end: 8 }
];
print(ds.selectNonOverlappingIntervals(intervals));
print(intervals);
print(ds.selectNonOverlappingIntervals([
  ds.Interval { start: 1, end: 2 },
  ds.Interval { start: 2, end: 3 }
]));
print(ds.selectNonOverlappingIntervals([
  ds.Interval { start: -3, end: -1 },
  ds.Interval { start: 0, end: 1 }
]));
let empty: [ds.Interval] = [];
print(ds.selectNonOverlappingIntervals(empty));
print(ds.selectNonOverlappingIntervals([
  ds.Interval { start: 4, end: 1 }
]));
