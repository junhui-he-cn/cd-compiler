import "../../data_structures.cd" as ds;

let sets = ds.newDisjointSet(6);
print sets.size();
print sets.componentCount();
print sets.connected(0, 1);
print sets.union(0, 1);
print sets.union(1, 2);
print sets.union(0, 2);
print sets.connected(0, 2);
print sets.componentCount();

print sets.union(3, 4);
print sets.union(2, 4);
print sets.connected(0, 4);
print sets.componentCount();
print sets.representative(4);
print sets.representative(5);

let empty = ds.newDisjointSet(0);
print empty.size();
print empty.componentCount();
