import "../../data_structures.cd" as ds;

fun describe(value: optional<number>): string {
  return match value {
    nil => "none",
    value => str(value),
  };
}

let median = ds.newMedianHeap();
print describe(median.median());
median.add(5);
print describe(median.median());
median.add(1);
print describe(median.median());
median.add(9);
print describe(median.median());
median.add(3);
print describe(median.median());
median.add(3);
print describe(median.median());
median.add(-7);
print describe(median.median());
print median.size();
print median.isEmpty();
