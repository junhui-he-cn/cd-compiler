import "../../data_structures.cd" as ds;

fun render(value: ds.Option<number>): string {
  match value {
    ds.Option.Some(value) => { return "some:" + str(value); }
    ds.Option.None => { return "none"; }
  }
}

let present = ds.some<number>(7);
let missing = ds.none<number>();
let explicit = ds.Option.None<number>();
let inferred = ds.some("hello");

print(render(present));
print(render(missing));
match explicit {
  ds.Option.Some(value) => { print("some:" + str(value)); }
  ds.Option.None => { print("none"); }
}
match inferred {
  ds.Option.Some(value) => { print(value); }
  ds.Option.None => { print("none"); }
}
