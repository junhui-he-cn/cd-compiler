    Import "../../data_structures.cd" as ds
    Fun render(value: ds.Option<number>): string
      Return (match value (arm ds.Option.Some(value) (+ "some:" (call str value))) (arm ds.Option.None "none"))
    Let present = (member-call ds some<number> 7)
    Let missing = (member-call ds none<number>)
    Let explicit = (member-call (field ds Option) None<number>)
