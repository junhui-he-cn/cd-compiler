import "../../data_structures.cd" as ds;

print(ds.longestIncreasingSubsequenceLength([]));
print(ds.longestIncreasingSubsequenceLength([10, 9, 2, 5, 3, 7, 101, 18]));
print(ds.longestIncreasingSubsequenceLength([1, 1, 1]));
print(ds.longestIncreasingSubsequenceLength([-3, -2, -1]));
print(ds.longestIncreasingSubsequenceLength([5, 4, 3, 2, 1]));
print(ds.longestIncreasingSubsequence([]));
print(ds.longestIncreasingSubsequence([10, 9, 2, 5, 3, 7, 101, 18]));
print(ds.longestIncreasingSubsequence([1, 1, 1]));
print(ds.longestIncreasingSubsequence([3, 4, 1, 2, 5]));
let lisInput = [4, 2, 3, 1, 5];
print(ds.longestIncreasingSubsequence(lisInput));
print(lisInput);

let stressInput: [number] = [];
let stressIndex = 0;
while (stressIndex < 2048) {
  stressInput.push(2048 - stressIndex);
  stressIndex += 1;
}
let stressResult = ds.longestIncreasingSubsequence(stressInput);
print(stressResult.len());
print(stressResult[0]);
print(stressResult[stressResult.len() - 1]);
print(stressInput[0]);
print(stressInput[stressInput.len() - 1]);

print(ds.longestCommonSubsequenceLength("abcde", "ace"));
print(ds.longestCommonSubsequenceLength("abc", "abc"));
print(ds.longestCommonSubsequenceLength("abc", "def"));
print(ds.longestCommonSubsequenceLength("猫狗猫", "狗猫"));
print(ds.longestCommonSubsequenceLength("", "abc"));
