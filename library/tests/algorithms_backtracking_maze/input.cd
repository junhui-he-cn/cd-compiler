import "../../data_structures.cd" as ds;

print ds.mazePaths([
  [true, true],
  [true, true]
]);
print ds.mazePaths([
  [true, true, true],
  [false, true, true],
  [false, false, true]
]);
print ds.mazePaths([
  [true, false],
  [true, true]
]);
print ds.mazePaths([
  [false, true],
  [true, true]
]);
print ds.mazePaths([
  [true, true],
  [true, false]
]);
let empty: [[bool]] = [];
print ds.mazePaths(empty);
let ragged: [[bool]] = [[true], [true, false]];
print ds.mazePaths(ragged);
