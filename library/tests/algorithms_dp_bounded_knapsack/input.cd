import "../../data_structures.cd" as ds;

print ds.boundedKnapsack([2, 3], [3, 4], [2, 1], 7);
print ds.boundedKnapsack([2, 3], [3, 4], [2, 1], 6);
print ds.boundedKnapsack([2, 3], [3, 4], [1, 1], 7);
print ds.boundedKnapsack([2, 3], [3, 4], [2, 1], 0);
print ds.boundedKnapsack([2], [3], [2], -1);
print ds.boundedKnapsack([2], [], [2], 1);
print ds.boundedKnapsack([2], [3], [1.5], 2);
print ds.boundedKnapsack([2], [3], [-1], 2);
print ds.boundedKnapsack([0], [3], [1], 2);
print ds.boundedKnapsack([2], [-3], [2], 5);
