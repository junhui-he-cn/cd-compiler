import "../../data_structures.cd" as ds;

fun ascending(left: number, right: number): bool {
  return left < right;
}

fun descending(left: number, right: number): bool {
  return left > right;
}

let numbers = [4, 1, 3, 1, 2];
let sorted = ds.sortArray(numbers, ascending);
print(sorted);
print(numbers);

sorted.push(99);
print(numbers);
print(sorted);

ds.sortArrayInPlace(numbers, descending);
print(numbers);

let empty: [number] = [];
print(ds.sortArray(empty, ascending));
ds.sortArrayInPlace(empty, descending);
print(empty);
