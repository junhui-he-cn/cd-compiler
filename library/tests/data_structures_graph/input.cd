import "../../data_structures.cd" as ds;

let graph = ds.newGraph(4, false);
print(graph.vertexCount());
print(graph.edgeCount());
print(graph.addEdge(0, 1));
print(graph.addEdge(1, 0));
print(graph.addEdge(1, 2));
print(graph.addEdge(2, 3));
print(graph.edgeCount());
print(graph.neighbors(1));
print(graph.hasEdge(0, 1));
print(graph.hasEdge(0, 3));
print(graph.addEdge(1, 1));
print(graph.edgeCount());
print(graph.neighbors(1));

let directed = ds.newGraph(3, true);
print(directed.addEdge(0, 1));
print(directed.addEdge(1, 2));
print(directed.hasEdge(1, 0));
print(directed.neighbors(0));
print(directed.neighbors(1));
print(directed.edgeCount());

let empty = ds.newGraph(0, false);
print(empty.addEdge(0, 1));
print(empty.neighbors(0));
