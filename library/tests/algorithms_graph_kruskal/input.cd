import "../../data_structures.cd" as ds;

fun totalWeight(graph: ds.WeightedGraph): number {
  let total = 0;
  let from = 0;
  while (from < graph.vertexCount()) {
    let neighbors = graph.neighbors(from);
    let index = 0;
    while (index < neighbors.len()) {
      let edge = neighbors[index];
      if (from < edge.to) {
        total += edge.weight;
      }
      index += 1;
    }
    from += 1;
  }
  return total;
}

let graph = ds.newWeightedGraph(4, false);
graph.addEdge(0, 1, 10);
graph.addEdge(0, 2, 6);
graph.addEdge(0, 3, 5);
graph.addEdge(1, 3, 15);
graph.addEdge(2, 3, 4);
let forest = ds.minimumSpanningForestKruskal(graph);
print(forest.edgeCount());
print(totalWeight(forest));
print(forest.neighbors(0));
print(forest.neighbors(1));

let disconnected = ds.newWeightedGraph(5, false);
disconnected.addEdge(0, 1, 3);
disconnected.addEdge(1, 2, 1);
disconnected.addEdge(3, 4, 2);
let disconnectedForest = ds.minimumSpanningForestKruskal(disconnected);
print(disconnectedForest.edgeCount());
print(totalWeight(disconnectedForest));

let directed = ds.newWeightedGraph(3, true);
directed.addEdge(0, 1, 1);
print(ds.minimumSpanningForestKruskal(directed).edgeCount());
