              Body
                Block
                  Let parent = (index parents current)
                  Expr (-= (index (index capacities parent) current) bottleneck)
                  Expr (+= (index (index capacities current) parent) bottleneck)
                  Expr (= current parent)
            Expr (+= total bottleneck)
      Return (construct FlowResult residual: capacities total: total)
    Fun maxFlow(graph: WeightedGraph, source: number, sink: number): number
      Let result = (call computeFlow graph source sink)
      Return (field result total)
    Fun minCut(graph: WeightedGraph, source: number, sink: number): [[number]]
      Let cut: [[number]] = (array)
      If (group (|| (|| (|| (|| (|| (! (field graph directed)) (< source 0)) (>= source (member-call graph vertexCount))) (< sink 0)) (>= sink (member-call graph vertexCount))) (== source sink)))
        Then
          Block
            Return cut
      Let result = (call computeFlow graph source sink)
      Let residual = (field result residual)
      Let count = (member-call graph vertexCount)
      Let reachable: [bool] = (array)
      Let index = 0
      While (group (< index count))
        Body
          Block
            Expr (member-call reachable push false)
            Expr (+= index 1)
      Let queue: [number] = (array source)
      Expr (= (index reachable source) true)
      Let head = 0
      While (group (< head (member-call queue len)))
        Body
          Block
            Let current = (index queue head)
            Expr (+= head 1)
            Let neighbor = 0
            While (group (< neighbor count))
              Body
                Block
                  If (group (&& (! (index reachable neighbor)) (> (index (index residual current) neighbor) 0)))
                    Then
                      Block
                        Expr (= (index reachable neighbor) true)
                        Expr (member-call queue push neighbor)
                  Expr (+= neighbor 1)
      Let from = 0
      While (group (< from count))
        Body
          Block
            If (group (index reachable from))
              Then
                Block
                  Let neighbors = (index (field graph adjacency) from)
                  Let neighborIndex = 0
                  While (group (< neighborIndex (member-call neighbors len)))
                    Body
                      Block
                        Let edge = (index neighbors neighborIndex)
                        If (group (&& (> (field edge weight) 0) (! (index reachable (field edge to)))))
                          Then
                            Block
                              Let pair: [number] = (array from (field edge to))
                              Expr (member-call cut push pair)
                        Expr (+= neighborIndex 1)
            Expr (+= from 1)
      Return cut
    Fun shortestWeightedPath(graph: WeightedGraph, start: number, goal: number): [number]
      Let result: [number] = (array)
      Let count = (member-call graph vertexCount)
      If (group (|| (|| (|| (< start 0) (>= start count)) (< goal 0)) (>= goal count)))
        Then
          Block
            Return result
      Let distances: [number] = (array)
      Let parents: [number] = (array)
      Let visited: [bool] = (array)
      Let index = 0
      While (group (< index count))
        Body
          Block
            Expr (member-call distances push (- 1))
            Expr (member-call parents push (- 1))
            Expr (member-call visited push false)
            Expr (+= index 1)
      Expr (= (index distances start) 0)
      Let step = 0
      While (group (< step count))
        Body
          Block
            Let current = (- 1)
            Expr (= index 0)
            While (group (< index count))
              Body
                Block
                  If (group (&& (&& (! (index visited index)) (>= (index distances index) 0)) (group (|| (< current 0) (< (index distances index) (index distances current))))))
                    Then
                      Block
                        Expr (= current index)
                  Expr (+= index 1)
            If (group (< current 0))
              Then
                Block
                  Break
            Expr (= (index visited current) true)
            If (group (== current goal))
              Then
                Block
                  Break
            Let neighbors = (member-call graph neighbors current)
            Let neighborIndex = 0
            While (group (< neighborIndex (member-call neighbors len)))
              Body
                Block
                  Let edge = (index neighbors neighborIndex)
                  Let candidate = (+ (index distances current) (field edge weight))
                  If (group (|| (< (index distances (field edge to)) 0) (< candidate (index distances (field edge to)))))
                    Then
                      Block
                        Expr (= (index distances (field edge to)) candidate)
                        Expr (= (index parents (field edge to)) current)
                  Expr (+= neighborIndex 1)
            Expr (+= step 1)
      If (group (&& (!= start goal) (< (index parents goal) 0)))
        Then
          Block
            Return result
      Let current = goal
      While (group (!= current start))
        Body
          Block
            Expr (member-call result push current)
            Expr (= current (index parents current))
      Expr (member-call result push start)
      Let reversed: [number] = (array)
      Let resultIndex = (member-call result len)
      While (group (> resultIndex 0))
        Body
          Block
            Expr (-= resultIndex 1)
            Expr (member-call reversed push (index result resultIndex))
      Return reversed
    Fun minimumSpanningForest(graph: WeightedGraph): WeightedGraph
      Let count = (member-call graph vertexCount)
      Let forest = (call newWeightedGraph count false)
      If (group (field graph directed))
        Then
          Block
            Return forest
      Let visited: [bool] = (array)
      Let distances: [number] = (array)
      Let parents: [number] = (array)
      Let parentWeights: [number] = (array)
      Let index = 0
      While (group (< index count))
        Body
          Block
            Expr (member-call visited push false)
            Expr (member-call distances push (- 1))
            Expr (member-call parents push (- 1))
            Expr (member-call parentWeights push (- 1))
            Expr (+= index 1)
      Let root = 0
      While (group (< root count))
        Body
          Block
            If (group (index visited root))
              Then
                Block
                  Expr (+= root 1)
                  Continue
            Expr (= (index distances root) 0)
            Expr (= (index parents root) (- 1))
            Expr (= (index parentWeights root) (- 1))
            Let step = 0
            While (group (< step count))
              Body
                Block
                  Let current = (- 1)
                  Expr (= index 0)
                  While (group (< index count))
                    Body
                      Block
                        If (group (&& (&& (! (index visited index)) (>= (index distances index) 0)) (group (|| (< current 0) (< (index distances index) (index distances current))))))
                          Then
                            Block
                              Expr (= current index)
                        Expr (+= index 1)
                  If (group (< current 0))
                    Then
                      Block
                        Break
                  Expr (= (index visited current) true)
                  If (group (>= (index parents current) 0))
                    Then
                      Block
                        Expr (member-call forest addEdge (index parents current) current (index parentWeights current))
                  Let neighbors = (member-call graph neighbors current)
                  Let neighborIndex = 0
                  While (group (< neighborIndex (member-call neighbors len)))
                    Body
                      Block
                        Let edge = (index neighbors neighborIndex)
                        If (group (&& (! (index visited (field edge to))) (group (|| (< (index distances (field edge to)) 0) (< (field edge weight) (index distances (field edge to)))))))
                          Then
                            Block
                              Expr (= (index distances (field edge to)) (field edge weight))
                              Expr (= (index parents (field edge to)) current)
                              Expr (= (index parentWeights (field edge to)) (field edge weight))
                        Expr (+= neighborIndex 1)
                  Expr (+= step 1)
            Expr (+= root 1)
      Return forest
    Fun reverseArray<T>(values: [T]): [T]
      Let result: [T] = (array)
      Let index = (member-call values len)
      While (group (> index 0))
        Body
          Block
            Expr (-= index 1)
            Expr (member-call result push (index values index))
      Return result
    Fun rotateArray<T>(values: [T], shift: number): [T]
      Let result: [T] = (array)
      Let length = (member-call values len)
      If (group (== length 0))
        Then
          Block
            Return result
      Let offset = (call floor shift)
      Let turns = (call floor (/ offset length))
      Expr (-= offset (* turns length))
      If (group (< offset 0))
        Then
          Block
            Expr (+= offset length)
      Let index = 0
      While (group (< index length))
        Body
          Block
            Let source = (- index offset)
            If (group (< source 0))
              Then
                Block
                  Expr (+= source length)
            Expr (member-call result push (index values source))
            Expr (+= index 1)
      Return result
    Fun linearSearch<T>(values: [T], target: T): number
      Let index = 0
      While (group (< index (member-call values len)))
        Body
          Block
            If (group (== (index values index) target))
              Then
                Block
                  Return index
            Expr (+= index 1)
      Return (- 1)
    Fun asciiCharacterRank(character: string): number
      Let alphabet = " !#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
      Let index = 0
      While (group (< index (member-call alphabet len)))
        Body
          Block
            If (group (== (member-call alphabet charAt index) character))
              Then
                Block
                  Return index
            Expr (+= index 1)
      Return (- 1)
    Fun compareStrings(left: string, right: string): number?
      Let leftLength = (member-call left len)
      Let rightLength = (member-call right len)
      Let limit = leftLength
      If (group (< rightLength limit))
        Then
          Block
            Expr (= limit rightLength)
      Let index = 0
      While (group (< index limit))
        Body
          Block
            Let leftCharacter = (member-call left charAt index)
            Let rightCharacter = (member-call right charAt index)
            Let leftRank = (call asciiCharacterRank leftCharacter)
            Let rightRank = (call asciiCharacterRank rightCharacter)
            If (group (|| (< leftRank 0) (< rightRank 0)))
              Then
                Block
                  Return nil
            If (group (< leftRank rightRank))
              Then
                Block
                  Return (- 1)
            If (group (> leftRank rightRank))
              Then
                Block
                  Return 1
            Expr (+= index 1)
      If (group (< leftLength rightLength))
        Then
          Block
            Return (- 1)
      If (group (> leftLength rightLength))
        Then
          Block
            Return 1
      Return 0
    Fun stringLess(left: string, right: string): bool
      Let comparison = (call compareStrings left right)
      If (group (== comparison nil))
        Then
          Block
            Return false
      Return (< comparison 0)
    Fun lowerBound<T>(values: [T], target: T, less: fun(T, T): bool): number
      Let low = 0
      Let high = (member-call values len)
      While (group (< low high))
        Body
          Block
            Let middle = (call floor (/ (group (+ low high)) 2))
            If (group (call less (index values middle) target))
              Then
                Block
                  Expr (= low (+ middle 1))
              Else
                Block
                  Expr (= high middle)
      Return low
    Fun upperBound<T>(values: [T], target: T, less: fun(T, T): bool): number
      Let low = 0
      Let high = (member-call values len)
      While (group (< low high))
        Body
          Block
            Let middle = (call floor (/ (group (+ low high)) 2))
            If (group (call less target (index values middle)))
              Then
                Block
                  Expr (= high middle)
              Else
                Block
                  Expr (= low (+ middle 1))
      Return low
    Fun binarySearch<T>(values: [T], target: T, less: fun(T, T): bool): number
      Let index = (call lowerBound values target less)
      If (group (&& (< index (member-call values len)) (== (index values index) target)))
        Then
          Block
            Return index
      Return (- 1)
    Fun countValue<T>(values: [T], target: T): number
      Let count = 0
      Let index = 0
      While (group (< index (member-call values len)))
        Body
          Block
            If (group (== (index values index) target))
              Then
                Block
                  Expr (+= count 1)
            Expr (+= index 1)
      Return count
    Fun isSorted<T>(values: [T], less: fun(T, T): bool): bool
      Let index = 1
      While (group (< index (member-call values len)))
        Body
          Block
            If (group (call less (index values index) (index values (- index 1))))
              Then
                Block
                  Return false
            Expr (+= index 1)
      Return true
    Fun sortArrayInPlace<T>(values: [T], less: fun(T, T): bool)
      Let index = 1
      While (group (< index (member-call values len)))
        Body
          Block
            Let value = (index values index)
            Let position = index
            While (group (&& (> position 0) (call less value (index values (- position 1)))))
              Body
                Block
                  Expr (= (index values position) (index values (- position 1)))
                  Expr (-= position 1)
            Expr (= (index values position) value)
            Expr (+= index 1)
    Fun sortArray<T>(values: [T], less: fun(T, T): bool): [T]
      Let result = (call copy values)
      Expr (call sortArrayInPlace result less)
      Return result
    Fun selectionSortInPlace<T>(values: [T], less: fun(T, T): bool)
      Let start = 0
      While (group (< start (member-call values len)))
        Body
          Block
            Let smallest = start
            Let index = (+ start 1)
            While (group (< index (member-call values len)))
              Body
                Block
                  If (group (call less (index values index) (index values smallest)))
                    Then
                      Block
                        Expr (= smallest index)
                  Expr (+= index 1)
            If (group (!= smallest start))
              Then
                Block
                  Let value = (index values start)
                  Expr (= (index values start) (index values smallest))
                  Expr (= (index values smallest) value)
            Expr (+= start 1)
    Fun selectionSort<T>(values: [T], less: fun(T, T): bool): [T]
      Let result = (call copy values)
      Expr (call selectionSortInPlace result less)
      Return result
    Fun bubbleSortInPlace<T>(values: [T], less: fun(T, T): bool)
      Let end = (- (member-call values len) 1)
      While (group (> end 0))
        Body
          Block
            Let index = 0
            Let swapped = false
            While (group (< index end))
              Body
                Block
                  If (group (call less (index values (+ index 1)) (index values index)))
                    Then
                      Block
                        Let value = (index values index)
                        Expr (= (index values index) (index values (+ index 1)))
                        Expr (= (index values (+ index 1)) value)
                        Expr (= swapped true)
                  Expr (+= index 1)
            If (group (! swapped))
              Then
                Block
                  Break
            Expr (-= end 1)
    Fun bubbleSort<T>(values: [T], less: fun(T, T): bool): [T]
      Let result = (call copy values)
      Expr (call bubbleSortInPlace result less)
      Return result
    Fun mergeSort<T>(values: [T], less: fun(T, T): bool): [T]
      Let result = (call copy values)
      Let width = 1
      While (group (< width (member-call result len)))
        Body
          Block
            Let start = 0
            While (group (< start (member-call result len)))
              Body
                Block
                  Let middle = (+ start width)
                  If (group (> middle (member-call result len)))
                    Then
                      Block
                        Expr (= middle (member-call result len))
                  Let end = (+ middle width)
                  If (group (> end (member-call result len)))
                    Then
                      Block
                        Expr (= end (member-call result len))
                  Let leftIndex = start
                  Let rightIndex = middle
                  Let merged: [T] = (array)
                  While (group (&& (< leftIndex middle) (< rightIndex end)))
                    Body
                      Block
                        If (group (call less (index result rightIndex) (index result leftIndex)))
                          Then
                            Block
                              Expr (member-call merged push (index result rightIndex))
                              Expr (+= rightIndex 1)
                          Else
                            Block
                              Expr (member-call merged push (index result leftIndex))
                              Expr (+= leftIndex 1)
                  While (group (< leftIndex middle))
                    Body
                      Block
                        Expr (member-call merged push (index result leftIndex))
                        Expr (+= leftIndex 1)
                  While (group (< rightIndex end))
                    Body
                      Block
                        Expr (member-call merged push (index result rightIndex))
                        Expr (+= rightIndex 1)
                  Let mergedIndex = 0
                  While (group (< mergedIndex (member-call merged len)))
                    Body
                      Block
                        Expr (= (index result (+ start mergedIndex)) (index merged mergedIndex))
                        Expr (+= mergedIndex 1)
                  Expr (= start end)
            Expr (*= width 2)
      Return result
    Fun quickSortRange<T>(values: [T], start: number, end: number, less: fun(T, T): bool)
      If (group (>= start end))
        Then
          Block
            Return nil
      Let pivotIndex = (call floor (/ (group (+ start end)) 2))
      Let pivotValue = (index values pivotIndex)
      Expr (= (index values pivotIndex) (index values end))
      Expr (= (index values end) pivotValue)
      Let pivot = (index values end)
      Let store = start
      Let index = start
      While (group (< index end))
        Body
          Block
            If (group (call less (index values index) pivot))
              Then
                Block
                  Let value = (index values store)
                  Expr (= (index values store) (index values index))
                  Expr (= (index values index) value)
                  Expr (+= store 1)
            Expr (+= index 1)
      Let value = (index values store)
      Expr (= (index values store) (index values end))
      Expr (= (index values end) value)
      Expr (call quickSortRange values start (- store 1) less)
      Expr (call quickSortRange values (+ store 1) end less)
    Fun quickSortInPlace<T>(values: [T], less: fun(T, T): bool)
      If (group (> (member-call values len) 1))
        Then
          Block
            Expr (call quickSortRange values 0 (- (member-call values len) 1) less)
    Fun quickSort<T>(values: [T], less: fun(T, T): bool): [T]
      Let result = (call copy values)
      Expr (call quickSortInPlace result less)
      Return result
    Fun heapSortSiftDown<T>(values: [T], root: number, heapSize: number, less: fun(T, T): bool)
      Let index = root
      While (group true)
        Body
          Block
            Let candidate = index
            Let left = (+ (* index 2) 1)
            If (group (&& (< left heapSize) (call less (index values candidate) (index values left))))
              Then
                Block
                  Expr (= candidate left)
            Let right = (+ left 1)
            If (group (&& (< right heapSize) (call less (index values candidate) (index values right))))
              Then
                Block
                  Expr (= candidate right)
            If (group (== candidate index))
              Then
                Block
                  Break
            Let value = (index values index)
            Expr (= (index values index) (index values candidate))
            Expr (= (index values candidate) value)
            Expr (= index candidate)
    Fun heapSortInPlace<T>(values: [T], less: fun(T, T): bool)
      Let start = (- (call floor (/ (member-call values len) 2)) 1)
      While (group (>= start 0))
        Body
          Block
            Expr (call heapSortSiftDown values start (member-call values len) less)
            Expr (-= start 1)
      Let heapSize = (member-call values len)
      While (group (> heapSize 1))
        Body
          Block
            Let value = (index values 0)
            Expr (= (index values 0) (index values (- heapSize 1)))
            Expr (= (index values (- heapSize 1)) value)
            Expr (-= heapSize 1)
            Expr (call heapSortSiftDown values 0 heapSize less)
    Fun heapSort<T>(values: [T], less: fun(T, T): bool): [T]
      Let result = (call copy values)
      Expr (call heapSortInPlace result less)
      Return result
    Fun chunkArray<T>(values: [T], size: number): [[T]]
      Let result: [[T]] = (array)
      If (group (<= size 0))
        Then
          Block
            Return result
      Let start = 0
      While (group (< start (member-call values len)))
        Body
          Block
            Let end = (+ start size)
            If (group (> end (member-call values len)))
              Then
                Block
                  Expr (= end (member-call values len))
            Let chunk: [T] = (array)
            Let index = start
            While (group (< index end))
              Body
                Block
                  Expr (member-call chunk push (index values index))
                  Expr (+= index 1)
            Expr (member-call result push chunk)
            Expr (= start end)
      Return result
    Fun slidingWindows<T>(values: [T], width: number): [[T]]
      Let result: [[T]] = (array)
      If (group (|| (<= width 0) (> width (member-call values len))))
        Then
          Block
            Return result
      Let start = 0
      While (group (<= (+ start width) (member-call values len)))
        Body
          Block
            Let window: [T] = (array)
            Let index = start
            While (group (< index (+ start width)))
              Body
                Block
                  Expr (member-call window push (index values index))
                  Expr (+= index 1)
            Expr (member-call result push window)
            Expr (+= start 1)
      Return result
    Fun prefixSums(values: [number]): [number]
      Let result: [number] = (array)
      Let sum = 0
      Let index = 0
      While (group (< index (member-call values len)))
        Body
          Block
            Expr (+= sum (index values index))
            Expr (member-call result push sum)
            Expr (+= index 1)
      Return result
    Struct Interval {start: number, end: number}
    Fun intervalLess(left: Interval, right: Interval): bool
      If (group (== (field left start) (field right start)))
        Then
          Block
            Return (< (field left end) (field right end))
      Return (< (field left start) (field right start))
    Fun mergeIntervals(intervals: [Interval]): [Interval]
      Let ordered = (call sortArray intervals intervalLess)
      Let merged: [Interval] = (array)
      Let index = 0
      While (group (< index (member-call ordered len)))
        Body
          Block
            Let current = (index ordered index)
            If (group (|| (== (member-call merged len) 0) (> (field current start) (field (index merged (- (member-call merged len) 1)) end))))
              Then
                Block
                  Expr (member-call merged push (construct Interval start: (field current start) end: (field current end)))
              Else
                Block
                  If (group (> (field current end) (field (index merged (- (member-call merged len) 1)) end)))
                    Then
                      Block
                        Expr (= (field (index merged (- (member-call merged len) 1)) end) (field current end))
            Expr (+= index 1)
      Return merged
    Fun intersectIntervals(left: [Interval], right: [Interval]): [Interval]
      Let leftMerged = (call mergeIntervals left)
      Let rightMerged = (call mergeIntervals right)
      Let result: [Interval] = (array)
      Let leftIndex = 0
      Let rightIndex = 0
      While (group (&& (< leftIndex (member-call leftMerged len)) (< rightIndex (member-call rightMerged len))))
        Body
          Block
            Let leftInterval = (index leftMerged leftIndex)
            Let rightInterval = (index rightMerged rightIndex)
            Let start = (field leftInterval start)
            If (group (> (field rightInterval start) start))
              Then
                Block
                  Expr (= start (field rightInterval start))
            Let end = (field leftInterval end)
            If (group (< (field rightInterval end) end))
              Then
                Block
                  Expr (= end (field rightInterval end))
            If (group (<= start end))
              Then
                Block
                  Expr (member-call result push (construct Interval start: start end: end))
            If (group (< (field leftInterval end) (field rightInterval end)))
              Then
                Block
                  Expr (+= leftIndex 1)
              Else
                Block
                  Expr (+= rightIndex 1)
      Return result
    Fun mergeSortedNumbers(left: [number], right: [number]): [number]
      Let result: [number] = (array)
      Let leftIndex = 0
      Let rightIndex = 0
      While (group (&& (< leftIndex (member-call left len)) (< rightIndex (member-call right len))))
        Body
          Block
            If (group (<= (index left leftIndex) (index right rightIndex)))
              Then
                Block
                  Expr (member-call result push (index left leftIndex))
                  Expr (+= leftIndex 1)
              Else
                Block
                  Expr (member-call result push (index right rightIndex))
                  Expr (+= rightIndex 1)
      While (group (< leftIndex (member-call left len)))
        Body
          Block
            Expr (member-call result push (index left leftIndex))
            Expr (+= leftIndex 1)
      While (group (< rightIndex (member-call right len)))
        Body
          Block
            Expr (member-call result push (index right rightIndex))
            Expr (+= rightIndex 1)
      Return result
    Fun twoSumSorted(values: [number], target: number): [number]
      Let result: [number] = (array)
      Let left = 0
      Let right = (- (member-call values len) 1)
      While (group (< left right))
        Body
          Block
            Let sum = (+ (index values left) (index values right))
            If (group (== sum target))
              Then
                Block
                  Expr (member-call result push left)
                  Expr (member-call result push right)
                  Return result
            If (group (< sum target))
              Then
                Block
                  Expr (+= left 1)
              Else
                Block
                  Expr (-= right 1)
      Return result
    Fun uniqueValues<T>(values: [T]): [T]
      Let result: [T] = (array)
      Let index = 0
      While (group (< index (member-call values len)))
        Body
          Block
            If (group (< (call linearSearch result (index values index)) 0))
              Then
                Block
                  Expr (member-call result push (index values index))
            Expr (+= index 1)
      Return result
    Fun intersectionValues<T>(left: [T], right: [T]): [T]
      Let result: [T] = (array)
      Let index = 0
      While (group (< index (member-call left len)))
        Body
          Block
            Let value = (index left index)
            If (group (&& (>= (call linearSearch right value) 0) (< (call linearSearch result value) 0)))
              Then
                Block
                  Expr (member-call result push value)
            Expr (+= index 1)
      Return result
    Fun unionValues<T>(left: [T], right: [T]): [T]
      Let result = (call uniqueValues left)
      Let index = 0
      While (group (< index (member-call right len)))
        Body
          Block
            If (group (< (call linearSearch result (index right index)) 0))
              Then
                Block
                  Expr (member-call result push (index right index))
            Expr (+= index 1)
      Return result
    Fun differenceValues<T>(left: [T], right: [T]): [T]
      Let result: [T] = (array)
      Let index = 0
      While (group (< index (member-call left len)))
        Body
          Block
            Let value = (index left index)
            If (group (&& (< (call linearSearch right value) 0) (< (call linearSearch result value) 0)))
              Then
                Block
                  Expr (member-call result push value)
            Expr (+= index 1)
      Return result
    Fun frequencyEntries<T>(values: [T]): [MultiSetEntry<T>]
      Let counts = (call newMultiSet<T>)
      Let index = 0
      While (group (< index (member-call values len)))
        Body
          Block
            Expr (member-call counts add (index values index))
            Expr (+= index 1)
      Return (member-call counts entries)
    Fun mostFrequent<T>(values: [T]): T?
      Let entries = (call frequencyEntries values)
      If (group (== (member-call entries len) 0))
        Then
          Block
            Return nil
      Let best = (field (index entries 0) value)
      Let bestCount = (field (index entries 0) count)
      Let index = 1
      While (group (< index (member-call entries len)))
        Body
          Block
            If (group (> (field (index entries index) count) bestCount))
              Then
                Block
                  Expr (= best (field (index entries index) value))
                  Expr (= bestCount (field (index entries index) count))
            Expr (+= index 1)
      Return best
    Fun windowSums(values: [number], width: number): [number]
      Let result: [number] = (array)
      If (group (|| (<= width 0) (> width (member-call values len))))
        Then
          Block
            Return result
      Let sum = 0
      Let index = 0
      While (group (< index width))
        Body
          Block
            Expr (+= sum (index values index))
            Expr (+= index 1)
      Expr (member-call result push sum)
      Let start = width
      While (group (< start (member-call values len)))
        Body
          Block
            Expr (+= sum (index values start))
            Expr (-= sum (index values (- start width)))
            Expr (member-call result push sum)
            Expr (+= start 1)
      Return result
    Fun maxWindowSum(values: [number], width: number): number?
      Let sums = (call windowSums values width)
      If (group (== (member-call sums len) 0))
        Then
          Block
            Return nil
      Let best = (index sums 0)
      Let index = 1
      While (group (< index (member-call sums len)))
        Body
          Block
            If (group (> (index sums index) best))
              Then
                Block
                  Expr (= best (index sums index))
            Expr (+= index 1)
      Return best
    Fun maxSubarraySum(values: [number]): number?
      If (group (== (member-call values len) 0))
        Then
          Block
            Return nil
      Let current = (index values 0)
      Let best = (index values 0)
      Let index = 1
      While (group (< index (member-call values len)))
        Body
          Block
            Let extended = (+ current (index values index))
            If (group (> (index values index) extended))
              Then
                Block
                  Expr (= current (index values index))
              Else
                Block
                  Expr (= current extended)
            If (group (> current best))
              Then
                Block
                  Expr (= best current)
            Expr (+= index 1)
      Return best
    Fun gcd(left: number, right: number): number
      Let a = left
      If (group (< a 0))
        Then
          Block
            Expr (= a (- a))
      Let b = right
      If (group (< b 0))
        Then
          Block
            Expr (= b (- b))
      While (group (!= b 0))
        Body
          Block
            Let quotient = (call floor (/ a b))
            Let remainder = (- a (* quotient b))
            Expr (= a b)
            Expr (= b remainder)
      Return a
    Fun lcm(left: number, right: number): number
      If (group (|| (== left 0) (== right 0)))
        Then
          Block
            Return 0
      Let leftMagnitude = left
      If (group (< leftMagnitude 0))
        Then
          Block
            Expr (= leftMagnitude (- leftMagnitude))
      Let rightMagnitude = right
      If (group (< rightMagnitude 0))
        Then
          Block
            Expr (= rightMagnitude (- rightMagnitude))
      Return (* (group (/ leftMagnitude (call gcd leftMagnitude rightMagnitude))) rightMagnitude)
    Struct PriorityQueue<T> {heap: BinaryHeap<T>}
    Impl PriorityQueue<T>
      Method enqueue(value: T)
        Expr (member-call (field this heap) add value)
      Method dequeue(): T?
        Return (member-call (field this heap) take)
      Method front(): T?
        Return (member-call (field this heap) peek)
      Method size(): number
        Return (member-call (field this heap) size)
      Method isEmpty(): bool
        Return (member-call (field this heap) isEmpty)
      Method snapshot(): [T]
        Return (member-call (field this heap) snapshot)
    Fun newPriorityQueue<T>(less: fun(T, T): bool): PriorityQueue<T>
      Return (construct PriorityQueue<T> heap: (call newBinaryHeap<T> less))
