import "../../data_structures.cd" as ds;

fun ascending(left: number, right: number): bool {
  return left < right;
}

let values = [1, 2, 3, 4, 5];
print(ds.rotateArray(values, 2));
print(ds.rotateArray(values, -1));
print(ds.rotateArray(values, 7));
print(ds.rotateArray(values, 0));
print(values);

let words = ["ant", "cat", "dog"];
print(ds.rotateArray(words, -4));
print(words);

print(ds.isSorted([1, 1, 2, 3], ascending));
print(ds.isSorted([1, 3, 2], ascending));
print(ds.isSorted<number>([], ascending));
print(ds.isSorted([42], ascending));

let empty: [number] = [];
print(ds.rotateArray(empty, 3));
