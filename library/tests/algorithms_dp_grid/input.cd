import "../../data_structures.cd" as ds;

print(ds.uniqueGridPaths(1, 1));
print(ds.uniqueGridPaths(3, 3));
print(ds.uniqueGridPaths(0, 3));
print(ds.uniqueGridPaths(2.5, 3));

print(ds.minGridPathSum([
  [1, 3, 1],
  [1, 5, 1],
  [4, 2, 1]
]));
print(ds.minGridPathSum([[1, 2, 3]]));
print(ds.minGridPathSum([[-1, 2], [3, -4]]));
let empty: [[number]] = [];
print(ds.minGridPathSum(empty));
print(ds.minGridPathSum([[1, 2], [3]]));

print(ds.editDistance("kitten", "sitting"));
print(ds.editDistance("", "abc"));
print(ds.editDistance("same", "same"));
print(ds.editDistance("猫", "狗"));
