import "../../data_structures.cd" as ds;

let map = ds.newMultiMap::<string, number>();
print(map.getAll("missing"));
map.add("a", 1);
map.add("a", 2);
map.add("b", 3);
print(map.getAll("a"));

let alias = map;
alias.add("a", 4);
print(map.getAll("a"));

let values = map.getAll("a");
values.push(99);
print(map.getAll("a"));
print(values);

print(map.discard("a", 2));
print(map.getAll("a"));
print(map.discard("a", 9));
print(map.discard("a", 1));
print(map.discard("a", 4));
print(map.getAll("a"));

map.add("b", 5);
print(map.getAll("b"));
print(map.discard("missing", 0));
