import "../../data_structures.cd" as ds;

let graph = ds.newWeightedGraph(5, false);
print graph.addEdge(0, 1, 4);
print graph.addEdge(0, 2, 1);
print graph.addEdge(2, 1, 2);
print graph.addEdge(1, 3, 1);
print graph.addEdge(2, 3, 5);
print graph.addEdge(3, 4, 3);
print graph.addEdge(0, 1, 9);
print graph.addEdge(1, 4, -1);
print graph.edgeCount();
print ds.shortestWeightedDistances(graph, 0);
print ds.shortestWeightedPath(graph, 0, 4);
print ds.shortestWeightedPath(graph, 4, 0);

let directed = ds.newWeightedGraph(4, true);
directed.addEdge(0, 1, 2);
directed.addEdge(1, 2, 2);
directed.addEdge(0, 2, 9);
print ds.shortestWeightedDistances(directed, 0);
print ds.shortestWeightedPath(directed, 0, 2);
print ds.shortestWeightedPath(directed, 3, 0);
print ds.shortestWeightedDistances(directed, 9);
