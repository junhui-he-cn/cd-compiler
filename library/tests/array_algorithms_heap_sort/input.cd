import "../../data_structures.cd" as ds;

fun ascending(left: number, right: number): bool {
  return left < right;
}

fun descending(left: number, right: number): bool {
  return left > right;
}

let numbers = [4, 1, 3, 1, 2];
let sorted = ds.heapSort(numbers, ascending);
print(sorted);
print(numbers);

ds.heapSortInPlace(numbers, descending);
print(numbers);

let words = ["fox", "ant", "dog", "cat"];
print(ds.heapSort(words, ds.stringLess));
print(words);

let empty: [number] = [];
print(ds.heapSort<number>(empty, ascending));
ds.heapSortInPlace(empty, descending);
print(empty);
print(ds.heapSort([42], ascending));
