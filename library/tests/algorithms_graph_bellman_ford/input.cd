import "../../data_structures.cd" as ds;

fun describe(result: ds.Result<ds.BellmanFordResult, ds.BellmanFordError>): string {
  match result {
    ds.Result.Ok(value) => {
      return str(value.distances) + "|" + str(value.parents);
    }
    ds.Result.Err(ds.BellmanFordError.InvalidStart) => {
      return "invalid-start";
    }
    ds.Result.Err(ds.BellmanFordError.NegativeCycle) => {
      return "negative-cycle";
    }
  }
}

let graph = ds.newSignedWeightedGraph(5, true);
graph.addEdge(0, 1, 6);
graph.addEdge(0, 2, 7);
graph.addEdge(1, 2, 8);
graph.addEdge(1, 3, 5);
graph.addEdge(1, 4, -4);
graph.addEdge(2, 3, -3);
graph.addEdge(2, 4, 9);
graph.addEdge(3, 1, -2);
graph.addEdge(4, 0, 2);
graph.addEdge(4, 3, 7);
print(graph.edgeCount());
print(describe(ds.bellmanFord(graph, 0)));
print(describe(ds.bellmanFord(graph, -1)));

let cycle = ds.newSignedWeightedGraph(3, true);
cycle.addEdge(0, 1, 1);
cycle.addEdge(1, 2, -2);
cycle.addEdge(2, 1, -2);
print(describe(ds.bellmanFord(cycle, 0)));

let undirected = ds.newSignedWeightedGraph(2, false);
print(undirected.addEdge(0, 1, -3));
print(describe(ds.bellmanFord(undirected, 0)));
