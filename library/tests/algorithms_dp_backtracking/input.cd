import "../../data_structures.cd" as ds;

print ds.knapsack01([2, 3, 4], [3, 4, 5], 5);
print ds.knapsack01([2, 3], [3, 4], 0);
print ds.knapsack01([2, 3], [3, 4], 1);
print ds.knapsack01([2], [3], -1);
print ds.knapsack01([2], [], 1);
print ds.knapsack01([0, 2], [5, 3], 2);
print ds.knapsack01([1.5], [3], 2);

print ds.subsets([1, 2]);
let emptyNumbers: [number] = [];
print ds.subsets(emptyNumbers);
print ds.combinations([1, 2, 3], 2);
print ds.combinations([1, 2, 3], 0);
print ds.combinations([1, 2, 3], 4);
print ds.permutations([1, 2, 3]);
print ds.permutations(emptyNumbers);
