import "../../data_structures.cd" as ds;

let left = [3, 1, 3, 2, 1];
let right = [2, 4, 2, 5];
print(ds.uniqueValues(left));
print(ds.intersectionValues(left, right));
print(ds.unionValues(left, right));
print(ds.differenceValues(left, right));
print(left);
print(right);

let words = ["a", "b", "a"];
print(ds.uniqueValues(words));
print(ds.unionValues(words, ["b", "c"]));
print(ds.intersectionValues(words, ["b", "c"]));
print(ds.differenceValues(words, ["a"]));
