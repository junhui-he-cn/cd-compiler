import "../../data_structures.cd" as ds;

let graph = ds.newGraph(8, true);
graph.addEdge(0, 1);
graph.addEdge(1, 2);
graph.addEdge(2, 0);
graph.addEdge(2, 3);
graph.addEdge(3, 4);
graph.addEdge(4, 3);
graph.addEdge(4, 5);
graph.addEdge(5, 6);
graph.addEdge(6, 5);
graph.addEdge(6, 7);
let components = ds.stronglyConnectedComponents(graph);
print(components);
print(components.len());

let undirected = ds.newGraph(2, false);
undirected.addEdge(0, 1);
print(ds.stronglyConnectedComponents(undirected));

let empty = ds.newGraph(0, true);
print(ds.stronglyConnectedComponents(empty));
