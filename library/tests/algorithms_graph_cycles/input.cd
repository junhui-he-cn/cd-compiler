import "../../data_structures.cd" as ds;

let dag = ds.newGraph(4, true);
dag.addEdge(0, 1);
dag.addEdge(1, 2);
dag.addEdge(0, 3);
print ds.hasCycle(dag);

let directedCycle = ds.newGraph(3, true);
directedCycle.addEdge(0, 1);
directedCycle.addEdge(1, 2);
directedCycle.addEdge(2, 0);
print ds.hasCycle(directedCycle);

let tree = ds.newGraph(4, false);
tree.addEdge(0, 1);
tree.addEdge(1, 2);
tree.addEdge(1, 3);
print ds.hasCycle(tree);

let undirectedCycle = ds.newGraph(3, false);
undirectedCycle.addEdge(0, 1);
undirectedCycle.addEdge(1, 2);
undirectedCycle.addEdge(2, 0);
print ds.hasCycle(undirectedCycle);

let selfLoop = ds.newGraph(1, false);
selfLoop.addEdge(0, 0);
print ds.hasCycle(selfLoop);

let empty = ds.newGraph(0, true);
print ds.hasCycle(empty);
