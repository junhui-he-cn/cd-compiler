import "../../data_structures.cd" as ds;

fun describe(result: ds.Result<ds.CriticalPathResult, ds.CriticalPathError>): string {
  match result {
    ds.Result.Ok(value) => {
      return str(value.distances) + "|" + str(value.parents) + "|" + str(value.order);
    }
    ds.Result.Err(ds.CriticalPathError.InvalidStart) => {
      return "invalid-start";
    }
    ds.Result.Err(ds.CriticalPathError.UndirectedGraph) => {
      return "undirected";
    }
    ds.Result.Err(ds.CriticalPathError.Cycle) => {
      return "cycle";
    }
  }
}

let dag = ds.newWeightedGraph(6, true);
dag.addEdge(0, 1, 3);
dag.addEdge(0, 2, 2);
dag.addEdge(1, 3, 4);
dag.addEdge(2, 3, 1);
dag.addEdge(2, 4, 5);
dag.addEdge(3, 5, 2);
dag.addEdge(4, 5, 1);
print describe(ds.criticalPath(dag, 0));
print describe(ds.criticalPath(dag, 2));
print describe(ds.criticalPath(dag, -1));

let cycle = ds.newWeightedGraph(3, true);
cycle.addEdge(0, 1, 1);
cycle.addEdge(1, 2, 1);
cycle.addEdge(2, 0, 1);
print describe(ds.criticalPath(cycle, 0));

let undirected = ds.newWeightedGraph(2, false);
undirected.addEdge(0, 1, 1);
print describe(ds.criticalPath(undirected, 0));
