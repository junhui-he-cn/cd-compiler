import "../../data_structures.cd" as ds;

let values = ds.prepend(1, ds.prepend(2, ds.prepend(3, ds.prepend(2, ds.prepend(1, ds.emptyList<number>())))));
print ds.listMiddle(values);
print ds.listIsPalindrome(values);
print ds.toArray(ds.listRemoveFromEnd(values, 2));

let even = ds.prepend(1, ds.prepend(2, ds.prepend(3, ds.prepend(4, ds.emptyList<number>()))));
print ds.listMiddle(even);
print ds.listIsPalindrome(even);
print ds.toArray(ds.listRemoveFromEnd(even, 1));

let empty = ds.emptyList<number>();
print ds.listMiddle(empty);
print ds.listIsPalindrome(empty);
print ds.toArray(ds.listRemoveFromEnd(values, 0));
print ds.toArray(ds.listRemoveFromEnd(values, 9));
