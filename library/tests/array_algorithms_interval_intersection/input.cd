import "../../data_structures.cd" as ds;

fun renderIntervals(values: [ds.Interval]): string {
  if (values.len() == 0) {
    return "empty";
  }
  let result = "";
  let index = 0;
  while (index < values.len()) {
    if (index > 0) {
      result = result + ",";
    }
    let value = values[index];
    result = result + "[" + str(value.start) + "," + str(value.end) + "]";
    index += 1;
  }
  return result;
}

let left: [ds.Interval] = [
  ds.Interval { start: 5, end: 7 },
  ds.Interval { start: 1, end: 3 },
  ds.Interval { start: 2, end: 6 },
  ds.Interval { start: 8, end: 10 },
  ds.Interval { start: 10, end: 12 }
];
let right: [ds.Interval] = [
  ds.Interval { start: 11, end: 14 },
  ds.Interval { start: 6, end: 9 },
  ds.Interval { start: 0, end: 2 },
  ds.Interval { start: 3, end: 5 }
];

print renderIntervals(ds.intersectIntervals(left, right));
print renderIntervals(left);
print renderIntervals(right);

let touching: [ds.Interval] = [ds.Interval { start: 1, end: 2 }];
let touchingRight: [ds.Interval] = [ds.Interval { start: 2, end: 4 }];
print renderIntervals(ds.intersectIntervals(touching, touchingRight));

let disjoint: [ds.Interval] = [ds.Interval { start: 10, end: 12 }];
print renderIntervals(ds.intersectIntervals(touching, disjoint));

let empty: [ds.Interval] = [];
print renderIntervals(ds.intersectIntervals(empty, right));
print renderIntervals(ds.intersectIntervals(left, empty));
