import "../../data_structures.cd" as ds;

let graph = ds.newGraph(5, false);
graph.addEdge(0, 1);
graph.addEdge(0, 2);
graph.addEdge(1, 3);
graph.addEdge(2, 3);
graph.addEdge(3, 4);

print ds.shortestDistances(graph, 0);
print ds.shortestPath(graph, 0, 4);
print ds.shortestPath(graph, 2, 2);
print ds.shortestPath(graph, 4, 0);

let directed = ds.newGraph(5, true);
directed.addEdge(0, 1);
directed.addEdge(1, 2);
directed.addEdge(2, 3);
directed.addEdge(0, 3);
print ds.shortestDistances(directed, 0);
print ds.shortestPath(directed, 0, 3);
print ds.shortestPath(directed, 3, 0);
print ds.shortestDistances(directed, 8);
