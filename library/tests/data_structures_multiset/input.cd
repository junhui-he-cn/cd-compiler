import "../../data_structures.cd" as ds;

fun renderEntries(values: [ds.MultiSetEntry<number>]): string {
  let result = "";
  let index = 0;
  while (index < values.len()) {
    if (index > 0) {
      result = result + ",";
    }
    let entry = values[index];
    result = result + str(entry.value) + ":" + str(entry.count);
    index += 1;
  }
  return result;
}

let numbers = ds.newMultiSet<number>();
print(numbers.countOf(4));
print(numbers.has(4));
numbers.add(4);
numbers.add(4);
numbers.add(2);
print(numbers.countOf(4));
print(renderEntries(numbers.entries()));

let alias = numbers;
alias.add(2);
print(renderEntries(numbers.entries()));
print(numbers.takeOne(4));
print(renderEntries(numbers.entries()));
print(numbers.takeOne(4));
print(renderEntries(numbers.entries()));
print(numbers.takeOne(4));
print(numbers.has(2));

