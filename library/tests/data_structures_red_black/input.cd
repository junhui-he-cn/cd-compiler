import "../../data_structures.cd" as ds;

fun ascending(left: number, right: number): bool {
  return left < right;
}

fun stringAscending(left: string, right: string): bool {
  return left < right;
}

fun describe(value: optional<number>): string {
  match value {
    nil => { return "none"; }
    value => { return str(value); }
  }
}

let empty = ds.newRedBlackTree<number>(ascending);
print empty.isEmpty();
print empty.height();
print describe(empty.minimum());
print describe(empty.maximum());

let tree = ds.newRedBlackTree<number>(ascending);
tree.insert(10);
tree.insert(20);
tree.insert(30);
tree.insert(15);
tree.insert(25);
tree.insert(5);
tree.insert(1);
tree.insert(8);
tree.insert(12);
tree.insert(18);
tree.insert(22);
tree.insert(28);
tree.insert(35);
print tree.snapshot();
print tree.size();
print tree.height();
print tree.insert(20);
print tree.has(18);
print tree.has(99);
print describe(tree.minimum());
print describe(tree.maximum());
print describe(tree.predecessor(20));
print describe(tree.successor(20));
print tree.discard(1);
print tree.snapshot();
print tree.discard(5);
print tree.snapshot();
print tree.discard(20);
print tree.snapshot();
print tree.discard(99);

let alias = tree;
print alias.insert(40);
print tree.snapshot();
let snapshot = tree.snapshot();
snapshot[0] = 99;
print tree.snapshot();

