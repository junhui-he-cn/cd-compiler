import "../../data_structures.cd" as ds;

fun renderFrequency(entries: [ds.MultiSetEntry<string>]): string {
  let result = "";
  let index = 0;
  while (index < entries.len()) {
    if (index > 0) {
      result = result + ",";
    }
    result = result + entries[index].value + ":" + str(entries[index].count);
    index += 1;
  }
  return result;
}

