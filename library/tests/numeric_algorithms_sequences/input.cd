import "../../data_structures.cd" as ds;

print(ds.fastPower(2, 10));
print(ds.fastPower(5, 0));
print(ds.fastPower(-2, 3));
print(ds.fastPower(2, -1));
print(ds.fastPower(2, 2.5));
print(ds.factorial(0));
print(ds.factorial(5));
print(ds.factorial(-1));
print(ds.fibonacci(0));
print(ds.fibonacci(1));
print(ds.fibonacci(10));
print(ds.fibonacci(2.5));
print(ds.fibonacci(10000000) != nil);
