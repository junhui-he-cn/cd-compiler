import "../../data_structures.cd" as ds;

let network = ds.newWeightedGraph(6, true);
network.addEdge(0, 1, 16);
network.addEdge(0, 2, 13);
network.addEdge(1, 2, 10);
network.addEdge(2, 1, 4);
network.addEdge(1, 3, 12);
network.addEdge(3, 2, 9);
network.addEdge(2, 4, 14);
network.addEdge(4, 3, 7);
network.addEdge(3, 5, 20);
network.addEdge(4, 5, 4);
print(ds.maxFlow(network, 0, 5));
print(ds.maxFlow(network, 5, 0));
print(ds.maxFlow(network, 0, 0));

let disconnected = ds.newWeightedGraph(3, true);
disconnected.addEdge(0, 1, 5);
print(ds.maxFlow(disconnected, 0, 2));

let undirected = ds.newWeightedGraph(2, false);
undirected.addEdge(0, 1, 5);
print(ds.maxFlow(undirected, 0, 1));

let invalid = ds.newWeightedGraph(2, true);
print(ds.maxFlow(invalid, -1, 1));
