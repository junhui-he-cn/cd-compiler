import "../library/data_structures.cd" as ds;

let stack = ds.newStack<number>();
stack.add(10);
stack.add(20);
print stack.top();
print stack.take();
print stack.snapshot();
print stack.take();
print stack.take();
print stack.isEmpty();

let queue = ds.newQueue<string>();
queue.enqueue("first");
queue.enqueue("second");
print queue.front();
print queue.dequeue();
print queue.snapshot();
print queue.dequeue();
print queue.dequeue();
queue.enqueue("third");
print queue.snapshot();

let deque = ds.newDeque<number>();
deque.addFront(2);
deque.addFront(1);
deque.addBack(3);
print deque.peekFront();
print deque.peekBack();
print deque.snapshot();

fun ascending(left: number, right: number): bool {
  return left < right;
}

let heap = ds.newBinaryHeap<number>(ascending);
heap.add(5);
heap.add(1);
heap.add(3);
print heap.peek();
print heap.take();
print heap.snapshot();

let priorities = ds.newPriorityQueue<number>(ascending);
priorities.enqueue(8);
priorities.enqueue(2);
priorities.enqueue(5);
print priorities.front();
print priorities.dequeue();
print priorities.snapshot();

let maybe = ds.some<number>(42);
print match maybe {
  ds.Option.Some(value) => value,
  ds.Option.None => 0,
};

let absent = ds.none<string>();
print match absent {
  ds.Option.Some(value) => value,
  ds.Option.None => "missing",
};

let result: ds.Result<number, string> = ds.ok<number, string>(42);
print match result {
  ds.Result.Ok(value) => value,
  ds.Result.Err(error) => 0,
};

let list = ds.prepend(2, ds.prepend(1, ds.emptyList<number>()));
print ds.toArray(list);
print ds.toArray(ds.reverse(list));

let seen = ds.newSet<number>();
seen.add(2);
seen.add(2);
seen.add(1);
print seen.snapshot();

let bag = ds.newMultiSet<string>();
bag.add("tag");
bag.add("tag");
print bag.countOf("tag");

let index = ds.newMultiMap<string, number>();
index.add("even", 2);
index.add("even", 4);
print index.getAll("even");

let values = [3, 1, 3, 2];
print ds.reverseArray(values);
print ds.linearSearch(values, 2);
print ds.countValue(values, 3);

fun ascendingValues(left: number, right: number): bool {
  return left < right;
}

print ds.sortArray(values, ascendingValues);
print ds.chunkArray(values, 2);
print ds.slidingWindows(values, 2);
print ds.prefixSums(values);
