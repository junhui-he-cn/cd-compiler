import "../library/data_structures.cd" as ds;

let stack = ds.newStack<number>();
stack.push(10);
stack.push(20);
print stack.top();
print stack.pop();
print stack.snapshot();
print stack.pop();
print stack.pop();
print stack.isEmpty();

let queue = ds.newQueue<string>();
queue.enqueue("first");
queue.enqueue("second");
print queue.front();
print queue.dequeue();
print queue.snapshot();
print queue.dequeue();
print queue.dequeue();
queue.enqueue("third");
print queue.snapshot();
